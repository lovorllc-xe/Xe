.LxeAllocReady:
 cmp qword ptr [rip+.LxeRegionDepth], 0
 jne .LxeAllocRegion
 mov rdi, r12
 call .LxeMemClass
 test rax, rax
 jz .LxeAllocLarge
 mov r13, rax
 mov r14, rcx
 add qword ptr [rip+.LxeGcAllocated], rax
 mov rdx, qword ptr [rip+.LxeGcAllocated]
 cmp rdx, qword ptr [rip+.LxeGcThreshold]
