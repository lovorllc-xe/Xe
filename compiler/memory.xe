module memory
begin
    // Xe heap: a lazily reserved arena of 64 KiB pages.
    //   * Small objects (up to 32 KiB) live in size-class pages and are
    //     recycled through per-class free lists.
    //   * Large objects get their own page runs, returned to the OS on free.
    //   * gc.begin/gc.end regions are chunked bump arenas released in bulk.
    //   * A conservative mark-and-sweep collector reclaims unreachable
    //     blocks automatically. Explicit free() still releases immediately.
    // Every block keeps the 24-byte header the rest of the runtime expects:
    //   [block+0] usable capacity, [block+8] free-list link, [block+16] tag.
    // Page info words: >0 small page block size, -1 large start,
    // -2 region chunk page, <= -3 large continuation (-3 - first page).
    fn data(): string
    begin
        return ".section .bss
.align 64
.LxeMemBase:
.quad 0
.LxeMemTop:
.quad 0
.LxeMemEnd:
.quad 0
.LxeMemInfo:
.quad 0
.LxeMemBits:
.quad 0
.LxeMemLock:
.quad 0
.LxeThreadsActive:
.quad 0
.LxeMemRuns:
.quad 0
.LxeGcAllocated:
.quad 0
.LxeGcThreshold:
.quad 0
.LxeGcDisabled:
.quad 0
.LxeGcCollections:
.quad 0
.LxeGcLive:
.quad 0
.LxeGcFreed:
.quad 0
.LxeStackBase:
.quad 0
.LxeMarkStack:
.quad 0
.LxeMarkTop:
.quad 0
.LxeMarkLimit:
.quad 0
.LxeMarkOverflow:
.quad 0
.LxeRegionDepth:
.quad 0
.LxeClassRecip:
.zero 1024
.LxeFreeHeads:
.skip 1024
.LxeClassCursor:
.skip 1024
.LxeClassLimit:
.skip 1024
.LxeRegions:
.skip 8192
.section .text
"
    end

    fn setup(): string
    begin
        return ".LxeMemMapRaw:
 mov eax, 9
 xor edi, edi
 mov edx, 3
 mov r10d, 16418
 mov r8, -1
 xor r9d, r9d
 syscall
 cmp rax, -4096
 jb .LxeMemMapRawDone
 xor eax, eax
.LxeMemMapRawDone:
 ret
.LxeMemInit:
 push rbx
 mov rax, qword ptr [rip+.LxeMemBase]
 test rax, rax
 jnz .LxeMemInitOk
 mov rbx, 68719476736
.LxeMemInitTry:
 lea rsi, [rbx+65536]
 call .LxeMemMapRaw
 test rax, rax
 jnz .LxeMemInitMapped
 shr rbx, 2
 cmp rbx, 1073741824
 jae .LxeMemInitTry
 xor eax, eax
 pop rbx
 ret
.LxeMemInitMapped:
 add rax, 65535
 and rax, -65536
 mov qword ptr [rip+.LxeMemTop], rax
 add rax, rbx
 mov qword ptr [rip+.LxeMemEnd], rax
 mov rsi, rbx
 shr rsi, 13
 call .LxeMemMapRaw
 test rax, rax
 jz .LxeMemInitFail
 mov qword ptr [rip+.LxeMemInfo], rax
 mov rsi, rbx
 shr rsi, 6
 call .LxeMemMapRaw
 test rax, rax
 jz .LxeMemInitFail
 mov qword ptr [rip+.LxeMemBits], rax
 mov rsi, 268435456
 call .LxeMemMapRaw
 test rax, rax
 jz .LxeMemInitFail
 mov qword ptr [rip+.LxeMarkStack], rax
 mov qword ptr [rip+.LxeMarkTop], rax
 add rax, 268435456
 mov qword ptr [rip+.LxeMarkLimit], rax
 mov qword ptr [rip+.LxeGcThreshold], 67108864
 mov rax, qword ptr [rip+.LxeMemTop]
 mov qword ptr [rip+.LxeMemBase], rax
 lea rdi, [rip+.LxeClassRecip]
 mov r8d, 1
.LxeRecipLoop:
 cmp r8, 64
 ja .LxeRecipMedium
 mov rcx, r8
 shl rcx, 4
 jmp .LxeRecipHave
.LxeRecipMedium:
 lea rcx, [r8-62]
 shl rcx, 9
.LxeRecipHave:
 mov rax, 281474976710656
 add rax, rcx
 dec rax
 xor edx, edx
 div rcx
 mov qword ptr [rdi+r8*8], rax
 inc r8
 cmp r8, 126
 jbe .LxeRecipLoop
.LxeMemInitOk:
 mov eax, 1
 pop rbx
 ret
.LxeMemInitFail:
 xor eax, eax
 pop rbx
 ret
.LxeMemLockAcquire:
 cmp qword ptr [rip+.LxeThreadsActive], 0
 je .LxeMemLockDone
.LxeMemLockSpin:
 mov eax, 1
 xchg qword ptr [rip+.LxeMemLock], rax
 test rax, rax
 jz .LxeMemLockDone
.LxeMemLockWait:
 pause
 cmp qword ptr [rip+.LxeMemLock], 0
 jne .LxeMemLockWait
 jmp .LxeMemLockSpin
.LxeMemLockDone:
 ret
.LxeMemLockRelease:
 mov qword ptr [rip+.LxeMemLock], 0
 ret
.LxeMemClass:
 lea rax, [rdi+39]
 and rax, -16
 cmp rax, 1024
 ja .LxeMemClassMedium
 mov rcx, rax
 shr rcx, 4
 ret
.LxeMemClassMedium:
 cmp rax, 32768
 ja .LxeMemClassLarge
 add rax, 511
 and rax, -512
 mov rcx, rax
 shr rcx, 9
 add rcx, 62
 ret
.LxeMemClassLarge:
 xor eax, eax
 ret
.LxeMemClassOf:
 mov rcx, rdi
 cmp rdi, 1024
 ja .LxeMemClassOfMedium
 shr rcx, 4
 ret
.LxeMemClassOfMedium:
 shr rcx, 9
 add rcx, 62
 ret
.LxeMemPages:
 lea r8, [rip+.LxeMemRuns]
.LxeMemPagesScan:
 mov rsi, qword ptr [r8]
 test rsi, rsi
 jz .LxeMemPagesBump
 mov rdx, qword ptr [rsi+8]
 cmp rdx, rdi
 jae .LxeMemPagesTake
 mov r8, rsi
 jmp .LxeMemPagesScan
.LxeMemPagesTake:
 je .LxeMemPagesWhole
 sub rdx, rdi
 mov qword ptr [rsi+8], rdx
 shl rdx, 16
 lea rax, [rsi+rdx]
 ret
.LxeMemPagesWhole:
 mov rcx, qword ptr [rsi]
 mov qword ptr [r8], rcx
 mov qword ptr [rsi], 0
 mov qword ptr [rsi+8], 0
 mov rax, rsi
 ret
.LxeMemPagesBump:
 mov rax, qword ptr [rip+.LxeMemTop]
 mov rdx, rdi
 shl rdx, 16
 lea rcx, [rax+rdx]
 cmp rcx, qword ptr [rip+.LxeMemEnd]
 ja .LxeMemPagesFail
 mov qword ptr [rip+.LxeMemTop], rcx
 ret
.LxeMemPagesFail:
 xor eax, eax
 ret
.LxeMemRelease:
 push rdi
 push rsi
 mov rax, rdi
 sub rax, qword ptr [rip+.LxeMemBase]
 shr rax, 16
 mov rdx, qword ptr [rip+.LxeMemInfo]
 mov rcx, rsi
.LxeMemReleaseInfo:
 mov qword ptr [rdx+rax*8], 0
 inc rax
 dec rcx
 jnz .LxeMemReleaseInfo
 mov rsi, qword ptr [rsp]
 shl rsi, 16
 mov rdi, qword ptr [rsp+8]
 mov edx, 4
 mov eax, 28
 syscall
 pop rsi
 pop rdi
 mov rax, qword ptr [rip+.LxeMemRuns]
 mov qword ptr [rdi], rax
 mov qword ptr [rdi+8], rsi
 mov qword ptr [rip+.LxeMemRuns], rdi
 ret
"
    end

