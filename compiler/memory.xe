.LxeFreeRecipHave:
 lea rdx, [rip+.LxeClassRecip]
 imul rax, qword ptr [rdx+rcx*8]
 shr rax, 48
 mov rcx, r8
 shl rcx, 10
 add rcx, qword ptr [rip+.LxeMemBits]
 btr qword ptr [rcx], rax
 jnc .LxeFreeDone
 imul rax, r9
 mov rdx, r8
 shl rdx, 16
 add rdx, qword ptr [rip+.LxeMemBase]
 add rax, rdx
 mov rdi, r9
 call .LxeMemClassOf
 lea rdx, [rip+.LxeFreeHeads]
 mov rsi, qword ptr [rdx+rcx*8]
