 lea rax, [rax+rcx+23]
 neg rcx
 and rax, rcx
 mov rdx, qword ptr [rbp-8]
 mov qword ptr [rax-24], rdx
 mov qword ptr [rax-16], 0
 mov qword ptr [rax-8], 0
 leave
 ret
.LxeAlignedFail:
 xor eax, eax
 leave
 ret
"
    end

