 shl r8, 16
 add r8, qword ptr [rip+.LxeMemBase]
 xor r11d, r11d
.LxeGcSweepBlock:
 cmp r11, r10
 jae .LxeGcSweepNext
 bt qword ptr [rbx], r11
 jnc .LxeGcSweepBlockNext
 bt qword ptr [rbx+512], r11
 jc .LxeGcSweepLiveBlock
 btr qword ptr [rbx], r11
 mov rax, r11
 imul rax, r9
 add rax, r8
 lea rcx, [rip+.LxeFreeHeads]
 mov rdx, qword ptr [rcx+r14*8]
 mov qword ptr [rax+8], rdx
 mov qword ptr [rcx+r14*8], rax
 add qword ptr [rip+.LxeGcFreed], r9
 jmp .LxeGcSweepBlockNext
.LxeGcSweepLiveBlock:
 add r15, r9
.LxeGcSweepBlockNext:
 inc r11
 jmp .LxeGcSweepBlock
.LxeGcSweepLarge:
 mov rbx, r12
 shl rbx, 10
 add rbx, qword ptr [rip+.LxeMemBits]
 bt qword ptr [rbx], 0
 jnc .LxeGcSweepNext
 mov rdi, r12
 shl rdi, 16
 add rdi, qword ptr [rip+.LxeMemBase]
 mov rsi, qword ptr [rdi]
 add rsi, 24
 bt qword ptr [rbx+512], 0
 jc .LxeGcSweepLargeLive
 btr qword ptr [rbx], 0
 add qword ptr [rip+.LxeGcFreed], rsi
 shr rsi, 16
 call .LxeMemRelease
 jmp .LxeGcSweepNext
.LxeGcSweepLargeLive:
 add r15, rsi
.LxeGcSweepNext:
 inc r12
 jmp .LxeGcSweepPage
.LxeGcSweepDone:
 mov qword ptr [rip+.LxeGcLive], r15
 lea rax, [r15+r15]
 cmp rax, 67108864
 jae .LxeGcThresholdReady
 mov rax, 67108864
.LxeGcThresholdReady:
 mov qword ptr [rip+.LxeGcThreshold], rax
 mov qword ptr [rip+.LxeGcAllocated], 0
 inc qword ptr [rip+.LxeGcCollections]
.LxeGcFinish:
 pop r11
 pop r10
 pop r9
 pop r8
 pop rdi
 pop rsi
 pop rdx
 pop rcx
 pop rax
 pop r15
 pop r14
 pop r13
 pop r12
 pop rbx
 pop rbp
 ret
"
    end

    fn interface(push: string, pop: string): string
    begin
        return push + ":
 push rbp
 mov rbp, rsp
 push rbx
 push r12
 call .LxeMemLockAcquire
 cmp qword ptr [rip+.LxeMemBase], 0
 jne .LxeRegionPushReady
 call .LxeMemInit
 test rax, rax
 jz .LxeRegionPushFail
.LxeRegionPushReady:
 mov rax, qword ptr [rip+.LxeRegionDepth]
 cmp rax, 256
 jae .LxeRegionPushFail
 shl rax, 5
 lea rcx, [rip+.LxeRegions]
 add rax, rcx
 mov qword ptr [rax], 0
 mov qword ptr [rax+8], 0
 mov qword ptr [rax+16], 0
 inc qword ptr [rip+.LxeRegionDepth]
 call .LxeMemLockRelease
 mov eax, 1
 pop r12
 pop rbx
 pop rbp
 ret
.LxeRegionPushFail:
 call .LxeMemLockRelease
 xor eax, eax
 pop r12
 pop rbx
 pop rbp
 ret
" + pop + ":
 push rbp
 mov rbp, rsp
 push rax
 push rcx
 push rdx
 push rsi
 push rdi
 push r8
 push r9
 push r10
 push r11
 push rbx
 call .LxeMemLockAcquire
 cmp qword ptr [rip+.LxeRegionDepth], 0
 je .LxeRegionPopDone
 dec qword ptr [rip+.LxeRegionDepth]
 mov rbx, qword ptr [rip+.LxeRegionDepth]
 shl rbx, 5
 lea rcx, [rip+.LxeRegions]
 add rcx, rbx
 mov rbx, qword ptr [rcx]
 mov qword ptr [rcx], 0
.LxeRegionPopChunk:
 test rbx, rbx
 jz .LxeRegionPopDone
 mov rdi, rbx
 mov rsi, qword ptr [rbx+8]
 mov rbx, qword ptr [rbx]
 call .LxeMemRelease
 jmp .LxeRegionPopChunk
.LxeRegionPopDone:
 call .LxeMemLockRelease
 pop rbx
 pop r11
 pop r10
 pop r9
 pop r8
 pop rdi
 pop rsi
 pop rdx
 pop rcx
 pop rax
 pop rbp
 ret
xeruntime.gc.collect:
 push rbp
 mov rbp, rsp
 call .LxeMemLockAcquire
 mov qword ptr [rip+.LxeGcFreed], 0
 cmp qword ptr [rip+.LxeThreadsActive], 0
 jne .LxeGcCollectSkip
 cmp qword ptr [rip+.LxeStackBase], 0
 je .LxeGcCollectSkip
 call .LxeGcCollect
.LxeGcCollectSkip:
 call .LxeMemLockRelease
 mov rax, qword ptr [rip+.LxeGcFreed]
 pop rbp
 ret
xeruntime.gc.enable:
 xor eax, eax
 cmp qword ptr [rip+.LxeGcDisabled], 0
 sete al
 xor ecx, ecx
 test rdi, rdi
 sete cl
 mov qword ptr [rip+.LxeGcDisabled], rcx
 ret
xeruntime.gc.stats:
 xor eax, eax
 cmp rdi, 0
 jne .LxeGcStats1
 mov rax, qword ptr [rip+.LxeGcCollections]
 ret
.LxeGcStats1:
 cmp rdi, 1
 jne .LxeGcStats2
 mov rax, qword ptr [rip+.LxeGcLive]
 ret
.LxeGcStats2:
 cmp rdi, 2
 jne .LxeGcStats3
 mov rax, qword ptr [rip+.LxeGcAllocated]
 ret
.LxeGcStats3:
 cmp rdi, 3
 jne .LxeGcStats4
 mov rax, qword ptr [rip+.LxeGcThreshold]
 ret
.LxeGcStats4:
 cmp rdi, 4
 jne .LxeGcStatsDone
 mov rax, qword ptr [rip+.LxeMemTop]
 sub rax, qword ptr [rip+.LxeMemBase]
.LxeGcStatsDone:
 ret
"
    end

    fn assembly(push: string, pop: string): string
    begin
        return data() + setup() + allocate() + release() + collector() + interface(push, pop)
    end
end
