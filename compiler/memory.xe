 shl rcx, 10
 add rcx, qword ptr [rip+.LxeMemBits]
 bts qword ptr [rcx], rax
 lea rax, [r13-24]
 mov qword ptr [rbx], rax
 mov qword ptr [rbx+8], 0
 mov qword ptr [rbx+16], 0
 jmp .LxeAllocDone
.LxeAllocLarge:
 lea rdi, [r12+65559]
 shr rdi, 16
 mov r13, rdi
 mov rax, r13
 shl rax, 16
 add qword ptr [rip+.LxeGcAllocated], rax
 mov rdx, qword ptr [rip+.LxeGcAllocated]
 cmp rdx, qword ptr [rip+.LxeGcThreshold]
