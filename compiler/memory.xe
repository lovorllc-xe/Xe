 jmp .LxeFreeDone
.LxeFreeLarge:
 mov rcx, r8
 shl rcx, 10
 add rcx, qword ptr [rip+.LxeMemBits]
 btr qword ptr [rcx], 0
 jnc .LxeFreeDone
 mov rdi, r8
 shl rdi, 16
 add rdi, qword ptr [rip+.LxeMemBase]
 mov rsi, qword ptr [rdi]
 add rsi, 24
 shr rsi, 16
