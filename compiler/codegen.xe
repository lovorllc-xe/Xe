            return sizeCode + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + alignmentCode + " mov rsi, rax\n mov rdi, qword ptr [rsp]\n add rsp, 16\n call xe.alloc.aligned\n"
        }
        if str.length(resultType) = 0 && name != "alloc" && name != "new" && name != "free" && name != "delete" { return "" }
        var arrayResult: int := 0
        if indirectResult(source, resultType) = 1 { arrayResult := 1 }
        var tempOffset: int := -1
        if arrayResult = 1 { tempOffset := arrayTemporaryOffset(source, pool, functionId, id) }
        var output: string := str.builder("")
