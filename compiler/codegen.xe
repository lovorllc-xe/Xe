                }
                output := str.append(output, array + " sub rsp, 16\n mov qword ptr [rsp], rax\n")
            }
            else {
                if floatExpressionType(source, pool, functionId, cursor) = 1 {
                    var floating: string := floatExpression(source, pool, functionId, cursor)
                    if str.length(floating) = 0 {
                        return ""
                    }
                    output := str.append(output, floating + " sub rsp, 16\n movsd qword ptr [rsp], xmm0\n")
                }
                else {
                    var integer: string := integerExpression(source, pool, functionId, cursor)
                    if str.length(integer) = 0 {
