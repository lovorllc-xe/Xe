    fn deferredBlock(source: string, pool: *[12582912]int, functionId: int, blockId: int, before: int): string
    begin
        if blockId < 0 || ast.read(pool, blockId, 0) != ast.blockKind() { return "" }
        if before < ast.read(pool, blockId, 1) || before > ast.read(pool, blockId, 2) { return "" }
        return deferredCode(source, pool, functionId, ast.read(pool, blockId, 6), before)
    end

    fn deferredCode(source: string, pool: *[12582912]int, functionId: int, first: int, before: int): string
    begin
        if first < 0 { return "" }
        var output: string := deferredCode(source, pool, functionId, ast.read(pool, first, 5), before)
        var kind: int := ast.read(pool, first, 0)
        if kind = ast.branchKind() {
            output := output + deferredBlock(source, pool, functionId, ast.read(pool, first, 6), before)
            var otherwise: int := ast.read(pool, first, 4)
            if otherwise >= 0 { output := output + deferredBlock(source, pool, functionId, otherwise, before) }
        }
        else {
            if kind = ast.loopKind() { output := output + deferredBlock(source, pool, functionId, ast.read(pool, first, 6), before) }
            else {
                if kind = ast.gcKind() {
                    output := output + deferredBlock(source, pool, functionId, ast.read(pool, first, 6), before)
                    var regionBlock: int := ast.read(pool, first, 6)
                    if regionBlock >= 0 && before >= ast.read(pool, regionBlock, 1) && before <= ast.read(pool, regionBlock, 2) {
                        output := output + " call " + runtime.gcPopName() + "\n"
                    }
                }
            }
            if kind = ast.switchKind() {
                var arm: int := ast.read(pool, first, 6)
                var visitedArms: int := 0
                while arm >= 0 && visitedArms < 32768 {
                    output := output + deferredBlock(source, pool, functionId, ast.read(pool, arm, 6), before)
                    arm := ast.read(pool, arm, 5)
                    visitedArms := visitedArms + 1
                }
            }
        }
        if ast.read(pool, first, 0) = ast.deferKind() && ast.read(pool, first, 1) < before {
            var action: int := ast.read(pool, first, 6)
            if action >= 0 && ast.read(pool, action, 0) = ast.callKind() {
                var called: int := ast.read(pool, action, 3)
                if called >= 0 && ast.read(pool, called, 0) = ast.nameKind() {
                    var name: string := str.slice(source, ast.read(pool, called, 1), ast.read(pool, called, 2))
                    if name = "write" || name = "writeln" {
                        return output + writeCallCode(source, pool, functionId, name, ast.read(pool, action, 6), ast.read(pool, first, 1))
                    }
                }
            }
            return output + integerExpression(source, pool, functionId, action)
        }
        return output
