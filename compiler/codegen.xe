        if wanted = "runtime.gc.collect" || wanted = "runtime.gc.enable" || wanted = "runtime.gc.stats" { return "int" }
        if wanted = "str.length" || wanted = "str.char" || wanted = "str.find" || wanted = "str.equal" || wanted = "arg.count" || wanted = "process.run" || wanted = "process.spawn" || wanted = "process.wait" || wanted = "thread.start" || wanted = "thread.join" || wanted = "syscall.invoke3" || wanted = "syscall.invoke6" || wanted = "runtime.mem.compare" || wanted = "runtime.hw.read8" || wanted = "runtime.hw.read32" { return "int" }
        if wanted = "file.write" || wanted = "free" || wanted = "delete" || wanted = "runtime.pointer.write" || wanted = "runtime.pointer.free" || wanted = "runtime.mem.copy" || wanted = "runtime.mem.set" || wanted = "runtime.hw.write8" || wanted = "runtime.hw.write32" { return "void" }
        var lookup: string := wanted
