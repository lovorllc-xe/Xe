    fn functionNode(source: string, pool: *[12582912]int, functionId: int, wanted: string): int
    begin
        var key: string := "N" + functionModule(source, pool, functionId) + "|" + wanted
        if memo.has(key) = 1 { return memo.number(memo.get(key)) }
        return memo.putNumber(key, functionNodeSlow(source, pool, functionId, wanted))
