        }
        if kind = ast.binaryKind() {
            var operation: int := ast.read(pool, id, 10)
            var left: string := expressionType(source, pool, functionId, ast.read(pool, id, 3))
            var right: string := expressionType(source, pool, functionId, ast.read(pool, id, 4))
            if left = "" { left := functionCallResultForValue(source, pool, functionId, ast.read(pool, id, 3)) }
            if right = "" { right := functionCallResultForValue(source, pool, functionId, ast.read(pool, id, 4)) }
            if operation = 260 || operation = 261 {
                if left = "int" && right = "int" { return "int" }
                return ""
            }
            if operation = 38 || operation = 94 || operation = 124 || operation = token.shiftLeftKind() || operation = token.shiftRightKind() {
                if left = "int" && right = "int" { return "int" }
                return ""
            }
            if (operation = 43 || operation = 45) && str.length(left) > 0 && str.char(left, 0) = 42 && right = "int" { return left }
            if operation = 43 && left = "int" && str.length(right) > 0 && str.char(right, 0) = 42 { return right }
            if operation = 256 || operation = 257 {
                if left = "int" && right = "int" { return "int" }
                if (left = "int" || left = "flt") && (right = "int" || right = "flt") { return "int" }
                if (left = "string" || left = "str") && (right = "string" || right = "str") { return "int" }
                if str.length(left) > 0 && str.char(left, 0) = 42 && argumentTypeMatches(left, right) = 1 { return "int" }
                return ""
            }
            if operation = 258 || operation = 259 || operation = 60 || operation = 62 {
                if (left = "int" || left = "flt") && (right = "int" || right = "flt") { return "int" }
                return ""
            }
            if operation = 43 && (left = "string" || left = "str") && (right = "string" || right = "str") { return "string" }
            if (left = "int" || left = "flt") && (right = "int" || right = "flt") {
                if operation = 37 && (left = "flt" || right = "flt") { return "" }
                if left = "flt" || right = "flt" { return "flt" }
                return "int"
            }
        }
        return ""
