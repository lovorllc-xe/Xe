module codegen
begin
    fn data(value: string, index: int, newline: int): string
    begin
        var bytes: string := str.builder(".Lmsg" + token.number(index) + ":\n.byte ")
        var position: int := 0
        while position < str.length(value) {
            if position > 0 { bytes := str.append(bytes, ",") }
            bytes := str.append(bytes, token.number(str.char(value, position)))
            position := position + 1
        }
        if newline = 1 {
            if str.length(value) > 0 { bytes := str.append(bytes, ",") }
            bytes := str.append(bytes, "10")
        }
        bytes := str.append(bytes, "\n.Llen" + token.number(index) + " = .-.Lmsg" + token.number(index) + "\n")
        return bytes
    end

    fn stringData(value: string, index: int): string
    begin
        var bytes: string := str.builder(".Lstr" + token.number(index) + ":\n.byte ")
        var position: int := 0
        while position < str.length(value) {
            if position > 0 { bytes := str.append(bytes, ",") }
            bytes := str.append(bytes, token.number(str.char(value, position)))
            position := position + 1
        }
        if str.length(value) > 0 { bytes := str.append(bytes, ",") }
        return bytes + "0\n"
    end

    fn decode(value: string): string
    begin
        var output: string := str.builder("")
        var position: int := 1
        while position < str.length(value) - 1 {
            var current: int := str.char(value, position)
            if current = 92 && position + 1 < str.length(value) - 1 {
                position := position + 1
                current := str.char(value, position)
                if current = 110 { current := 10 }
                else {
                    if current = 114 { current := 13 }
                    else { if current = 116 { current := 9 } }
                }
            }
            output := str.append(output, token.character(current))
            position := position + 1
        }
        return output
    end

    fn integerLiteral(source: string, item: [4]int): string
    begin
        if item[0] = token.numberKind() { return str.slice(source, item[1], item[2]) }
        if item[0] = 45 {
            var magnitude: [4]int := lexer.scan(source, item[2], item[3])
            if magnitude[0] = token.numberKind() { return "-" + str.slice(source, magnitude[1], magnitude[2]) }
        }
        return ""
    end

    fn variableValue(source: string, wanted: string, before: int): string
    begin
        var position: int := 0
        var line: int := 1
        var size: int := str.length(source)
        var result: string := ""
        var declared: int := 0
        while position <= size && position <= before {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() { position := size + 1 }
            else {
                var word: string := str.slice(source, item[1], item[2])
                if item[0] = token.nameKind() && word = "var" {
                    var name: [4]int := parser.significant(source, item[2], item[3])
                    var colon: [4]int := parser.significant(source, name[2], name[3])
                    var kind: [4]int := parser.significant(source, colon[2], colon[3])
                    var equal: [4]int := parser.significant(source, kind[2], kind[3])
                    var value: [4]int := parser.significant(source, equal[2], equal[3])
                    var nameText: string := str.slice(source, name[1], name[2])
                    var kindText: string := str.slice(source, kind[1], kind[2])
                    var initial: string := integerLiteral(source, value)
                    if nameText = wanted && colon[0] = 58 && kindText = "int" && equal[0] = token.assignKind() && str.length(initial) > 0 {
                        result := initial
                        declared := 1
                    }
                }
                else {
                    if item[0] = token.nameKind() && word = wanted && declared = 1 {
                        var equal: [4]int := parser.significant(source, item[2], item[3])
                        var value: [4]int := parser.significant(source, equal[2], equal[3])
                        var update: string := integerLiteral(source, value)
                        if equal[0] = token.assignKind() && str.length(update) > 0 { result := update }
                    }
                }
                position := item[2]
                line := item[3]
            }
        }
        return result
    end

    fn literalInfo(source: string, item: [4]int): [4]int
    begin
        var result: [4]int
        if item[0] = token.stringKind() || item[0] = token.numberKind() {
            result[0] := 1
            result[1] := item[1]
            result[2] := item[2]
            result[3] := item[0]
            return result
        }
        if item[0] = token.nameKind() {
            var word: string := str.slice(source, item[1], item[2])
            if word = "true" || word = "false" {
                result[0] := 1
                result[1] := item[1]
                result[2] := item[2]
                result[3] := item[0]
            }
            else {
                if str.length(variableValue(source, word, item[1])) > 0 {
                    result[0] := 1
                    result[1] := item[1]
                    result[2] := item[2]
                    result[3] := 5
                }
            }
            return result
        }
        if item[0] = 45 {
            var magnitude: [4]int := lexer.scan(source, item[2], item[3])
            if magnitude[0] = token.numberKind() {
                result[0] := 1
                result[1] := item[1]
                result[2] := magnitude[2]
                result[3] := 45
            }
        }
        return result
    end

    fn literalValue(source: string, info: [4]int): string
    begin
        var value: string := str.slice(source, info[1], info[2])
        if info[3] = token.stringKind() { return decode(value) }
        if info[3] = 5 { return variableValue(source, value, info[1]) }
        return value
    end

    fn messages(source: string): string
    begin
        var output: string := str.builder("")
        var position: int := 0
        var line: int := 1
        var size: int := str.length(source)
        while position <= size {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() { position := size + 1 }
            else {
                var word: string := str.slice(source, item[1], item[2])
                if item[0] = token.nameKind() && (word = "write" || word = "writeln") {
                    var opening: [4]int := lexer.scan(source, item[2], item[3])
                    var literal: [4]int := lexer.scan(source, opening[2], opening[3])
                    var info: [4]int := literalInfo(source, literal)
                    if opening[0] = 40 && info[0] = 1 {
                        var newline: int := 0
                        if word = "writeln" { newline := 1 }
                        output := str.append(output, data(literalValue(source, info), literal[1], newline))
                    }
                }
                position := item[2]
                line := item[3]
            }
        }
        return output
    end

    fn messageIndex(source: string, pool: *[12582912]int, mainId: int, before: int): int
    begin
        var position: int := before
        var finish: int := ast.read(pool, mainId, 8)
        var line: int := 1
        while position < finish {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() || item[1] >= finish { position := finish }
            else {
                var word: string := str.slice(source, item[1], item[2])
                if item[0] = token.nameKind() && (word = "write" || word = "writeln") {
                    var opening: [4]int := lexer.scan(source, item[2], item[3])
                    var literal: [4]int := lexer.scan(source, opening[2], opening[3])
                    if opening[0] = 40 && literalInfo(source, literal)[0] = 1 { return literal[1] }
                }
                position := item[2]
                line := item[3]
            }
        }
        return -1
    end

    fn floatExpressionType(source: string, pool: *[12582912]int, functionId: int, id: int): int
    begin
        if id < 0 { return 0 }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.literalKind() {
            if ast.read(pool, id, 10) = token.numberKind() && str.find(str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2)), ".") >= 0 { return 1 }
        }
        if kind = ast.nameKind() {
            var name: string := str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2))
            if boundLocalType(source, pool, functionId, id) = "flt" { return 1 }
        }
        if kind = ast.callKind() {
            var called: int := ast.read(pool, id, 3)
            if called >= 0 {
                var name: string := str.slice(source, ast.read(pool, called, 1), ast.read(pool, called, 2))
                var cachedTarget: int := ast.read(pool, called, 11)
                var resultType: string := ""
                if cachedTarget > 0 { resultType := functionResultTypeAt(source, pool, cachedTarget - 1) }
                else { resultType := functionResultType(source, pool, functionId, name) }
                if resultType = "flt" { return 1 }
            }
        }
        if kind = ast.indexKind() && expressionType(source, pool, functionId, id) = "flt" { return 1 }
        if kind = ast.memberKind() && expressionType(source, pool, functionId, id) = "flt" { return 1 }
        if kind = ast.unaryKind() {
            if ast.read(pool, id, 10) = 42 && expressionType(source, pool, functionId, id) = "flt" { return 1 }
            return floatExpressionType(source, pool, functionId, ast.read(pool, id, 3))
        }
        if kind = ast.binaryKind() {
            var operation: int := ast.read(pool, id, 10)
            if operation = 43 || operation = 45 || operation = 42 || operation = 47 {
                if floatExpressionType(source, pool, functionId, ast.read(pool, id, 3)) = 1 || floatExpressionType(source, pool, functionId, ast.read(pool, id, 4)) = 1 { return 1 }
            }
        }
        return 0
    end

    fn stringExpressionType(source: string, pool: *[12582912]int, functionId: int, id: int): int
    begin
        if id < 0 { return 0 }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.literalKind() && ast.read(pool, id, 10) = token.stringKind() { return 1 }
        if kind = ast.nameKind() {
            var name: string := str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2))
            var type: string := boundLocalType(source, pool, functionId, id)
            if type = "string" || type = "str" { return 1 }
        }
        if kind = ast.memberKind() {
            var memberType: string := expressionType(source, pool, functionId, id)
            if memberType = "string" || memberType = "str" { return 1 }
        }
        if kind = ast.indexKind() || kind = ast.unaryKind() {
            var valueType: string := expressionType(source, pool, functionId, id)
            if valueType = "string" || valueType = "str" { return 1 }
        }
        if kind = ast.callKind() {
            var called: int := ast.read(pool, id, 3)
            if called >= 0 {
                var name: string := str.slice(source, ast.read(pool, called, 1), ast.read(pool, called, 2))
                var cachedTarget: int := ast.read(pool, called, 11)
                var resultType: string := ""
                if cachedTarget > 0 { resultType := functionResultTypeAt(source, pool, cachedTarget - 1) }
                else { resultType := functionResultType(source, pool, functionId, name) }
                if name = "str.slice" || name = "str.number" || name = "str.fromchar" || name = "str.builder" || name = "str.append" || name = "arg.get" || name = "env.get" || name = "file.read" || resultType = "string" || resultType = "str" { return 1 }
            }
        }
        if kind = ast.binaryKind() && ast.read(pool, id, 10) = 43 {
            if stringExpressionType(source, pool, functionId, ast.read(pool, id, 3)) = 1 && stringExpressionType(source, pool, functionId, ast.read(pool, id, 4)) = 1 { return 1 }
        }
        return 0
    end

    fn writeCode(source: string, pool: *[12582912]int, mainId: int, word: string, argumentStart: int, callStart: int): string
    begin
        var argument: [4]int := lexer.scan(source, argumentStart, 1)
        var newline: int := 0
        if word = "writeln" { newline := 1 }
        if argument[0] = token.nameKind() {
            var name: string := str.slice(source, argument[1], argument[2])
            var type: string := localType(source, pool, mainId, name, argument[1])
            var offset: int := integerLocalOffsetAt(source, pool, mainId, name, argument[1])
            if offset >= 0 && type = "flt" {
                return " movsd xmm0, qword ptr [rbp-" + token.number(offset) + "]\n mov edi, 15\n mov esi, " + token.number(newline) + "\n call " + runtime.floatPrintName() + "\n"
            }
            if offset >= 0 && type = "int" {
                var register: int := optimizer.registerIndex(source, ast.read(pool, mainId, 7), ast.read(pool, mainId, 8), name, argument[1])
                if register >= 0 { return " mov rdi, " + registerName(register) + "\n mov esi, " + token.number(newline) + "\n call " + runtime.intPrintName() + "\n" }
                return " mov rdi, qword ptr [rbp-" + token.number(offset) + "]\n mov esi, " + token.number(newline) + "\n call " + runtime.intPrintName() + "\n"
            }
            if offset >= 0 && (type = "string" || type = "str") {
                return " mov rdi, qword ptr [rbp-" + token.number(offset) + "]\n mov esi, " + token.number(newline) + "\n call xe.print.string\n"
            }
        }
        var info: [4]int := literalInfo(source, argument)
        if info[0] = 1 {
            var index: int := messageIndex(source, pool, mainId, callStart)
            return " mov eax, 1\n mov edi, 1\n lea rsi, [rip+.Lmsg" + token.number(index) + "]\n mov edx, .Llen" + token.number(index) + "\n syscall\n"
        }
        return ""
    end

    fn writeArgumentCode(source: string, pool: *[12582912]int, functionId: int, word: string, argument: int, callStart: int): string
    begin
        if argument < 0 { return "" }
        var kind: int := ast.read(pool, argument, 0)
        if kind = ast.literalKind() {
            var literalKind: int := ast.read(pool, argument, 10)
            if literalKind = token.stringKind() {
                var newline: int := 0
                if word = "writeln" { newline := 1 }
                return " lea rdi, [rip+.Lstr" + token.number(ast.read(pool, argument, 1)) + "]\n mov esi, " + token.number(newline) + "\n call xe.print.string\n"
            }

        }
        var newline: int := 0
        if word = "writeln" { newline := 1 }
        if floatExpressionType(source, pool, functionId, argument) = 1 {
            var code: string := floatExpression(source, pool, functionId, argument)
            if str.length(code) = 0 { return "" }
            return code + " mov edi, 15\n mov esi, " + token.number(newline) + "\n call " + runtime.floatPrintName() + "\n"
        }
        if stringExpressionType(source, pool, functionId, argument) = 1 {
            var text: string := stringExpression(source, pool, functionId, argument)
            if str.length(text) = 0 { return "" }
            return text + " mov rdi, rax\n mov esi, " + token.number(newline) + "\n call xe.print.string\n"
        }
        var integerCode: string := integerExpression(source, pool, functionId, argument)
        if str.length(integerCode) = 0 { return "" }
        return integerCode + " mov rdi, rax\n mov esi, " + token.number(newline) + "\n call " + runtime.intPrintName() + "\n"
    end

    fn writeCallCode(source: string, pool: *[12582912]int, functionId: int, word: string, firstArgument: int, callStart: int): string
    begin
        var output: string := str.builder("")
        var argument: int := firstArgument
        var visited: int := 0
        while argument >= 0 && visited < 32768 {
            var argumentWord: string := "write"
            if ast.read(pool, argument, 5) < 0 { argumentWord := word }
            var code: string := writeArgumentCode(source, pool, functionId, argumentWord, argument, callStart)
            if str.length(code) = 0 { return "" }
            output := str.append(output, code)
            argument := ast.read(pool, argument, 5)
            visited := visited + 1
        }
        if argument >= 0 { return "" }
        if visited = 0 {
            if word = "writeln" { return " sub rsp, 8\n mov byte ptr [rsp], 10\n mov eax, 1\n mov edi, 1\n mov rsi, rsp\n mov edx, 1\n syscall\n add rsp, 8\n" }
            return ""
        }
        return output
    end

    fn readArgumentCode(source: string, pool: *[12582912]int, functionId: int, word: string, argument: int): string
    begin
        if argument < 0 || ast.read(pool, argument, 0) != ast.nameKind() { return "" }
        var name: string := str.slice(source, ast.read(pool, argument, 1), ast.read(pool, argument, 2))
        var type: string := boundLocalType(source, pool, functionId, argument)
        var offset: int := boundLocalOffset(source, pool, functionId, argument)
        if offset < 0 { return "" }
        if word = "read" && type = "int" {
            var register: int := registerIndexForName(source, pool, functionId, argument)
            var output: string := " lea rdi, [rbp-" + token.number(offset) + "]\n call xe.read.int\n"
            if register >= 0 { output := output + " mov " + registerName(register) + ", qword ptr [rbp-" + token.number(offset) + "]\n" }
            return output
        }
        if word = "read" && type = "flt" { return " lea rdi, [rbp-" + token.number(offset) + "]\n call xe.read.float\n" }
        if word = "readln" && (type = "string" || type = "str") { return " call xe.read.line\n mov qword ptr [rbp-" + token.number(offset) + "], rax\n" }
        return ""
    end

    fn gcWriteCalls(source: string, pool: *[12582912]int, mainId: int, statement: int): string
    begin
        var output: string := str.builder("")
        var position: int := ast.read(pool, statement, 7)
        var finish: int := ast.read(pool, statement, 8)
        var line: int := 1
        while position < finish {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() || item[1] >= finish { position := finish }
            else {
                var word: string := str.slice(source, item[1], item[2])
                if item[0] = token.nameKind() && (word = "write" || word = "writeln") {
                    var opening: [4]int := lexer.scan(source, item[2], item[3])
                    if opening[0] = 40 {
                        var value: [4]int := lexer.scan(source, opening[2], opening[3])
                        output := str.append(output, writeCode(source, pool, mainId, word, value[1], item[1]))
                    }
                }
                position := item[2]
                line := item[3]
            }
        }
        return output
    end

    fn allocationSize(source: string): string
    begin
        var found: int := str.find(source, "alloc(")
        if found < 0 { return "0" }
        var start: int := found + str.length("alloc(")
        var tail: string := str.slice(source, start, str.length(source))
        var item: [4]int := lexer.scan(tail, 0, 1)
        if item[0] != token.numberKind() { return "0" }
        return str.slice(tail, item[1], item[2])
    end

    fn floatConstants(source: string): string
    begin
        var output: string := str.builder("")
        var position: int := 0
        var line: int := 1
        var size: int := str.length(source)
        while position <= size {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() { position := size + 1 }
            else {
                if item[0] = token.numberKind() {
                    var value: string := str.slice(source, item[1], item[2])
                    if str.find(value, ".") >= 0 {
                        output := str.append(output, ".Lflt" + token.number(item[1]) + ":\n.double " + value + "\n")
                    }
                }
                position := item[2]
                line := item[3]
            }
        }
        return output
    end

    fn stringConstants(source: string): string
    begin
        var output: string := str.builder("")
        var position: int := 0
        var line: int := 1
        while position <= str.length(source) {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() { position := str.length(source) + 1 }
            else {
                if item[0] = token.stringKind() { output := str.append(output, stringData(decode(str.slice(source, item[1], item[2])), item[1])) }
                position := item[2]
                line := item[3]
            }
        }
        return output
    end

    fn multiplier(source: string): string
    begin
        var found: int := str.find(source, "return ")
        if found < 0 { return "3.14159" }
        var start: int := found + str.length("return ")
        var left: [4]int := lexer.scan(source, start, 1)
        var operation: [4]int := lexer.scan(source, left[2], left[3])
        var right: [4]int := lexer.scan(source, operation[2], operation[3])
        if operation[0] != 42 || right[0] != token.numberKind() { return "3.14159" }
        return str.slice(source, right[1], right[2])
    end

    fn parseInteger(value: string): [2]int
    begin
        var result: [2]int
        if str.length(value) = 0 { return result }
        var position: int := 0
        var sign: int := 1
        if str.char(value, 0) = 45 {
            sign := -1
            position := 1
        }
        if position >= str.length(value) { return result }
        var number: int := 0
        while position < str.length(value) {
            var digit: int := str.char(value, position) - 48
            if digit < 0 || digit > 9 { return result }
            number := number * 10 + digit
            position := position + 1
        }
        result[0] := 1
        result[1] := number * sign
        return result
    end

    fn integerValue(source: string, pool: *[12582912]int, id: int): [2]int
    begin
        var result: [2]int
        if id < 0 { return result }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.literalKind() {
            if ast.read(pool, id, 10) != token.numberKind() { return result }
            return parseInteger(str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2)))
        }
        if kind = ast.nameKind() {
            var name: string := str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2))
            return parseInteger(variableValue(source, name, ast.read(pool, id, 1)))
        }
        if kind = ast.unaryKind() {
            var operand: [2]int := integerValue(source, pool, ast.read(pool, id, 3))
            if operand[0] = 0 { return result }
            if ast.read(pool, id, 10) = 45 { operand[1] := -operand[1] }
            else { if ast.read(pool, id, 10) = 33 { if operand[1] = 0 { operand[1] := 1 } else { operand[1] := 0 } }
                else { return result }
            }
            return operand
        }
        if kind = ast.binaryKind() {
            var left: [2]int := integerValue(source, pool, ast.read(pool, id, 3))
            var right: [2]int := integerValue(source, pool, ast.read(pool, id, 4))
            if left[0] = 0 || right[0] = 0 { return result }
            var operation: int := ast.read(pool, id, 10)
            if operation = 43 { result[1] := left[1] + right[1] }
            else {
                if operation = 45 { result[1] := left[1] - right[1] }
                else {
                    if operation = 42 { result[1] := left[1] * right[1] }
                    else {
                        if operation = 47 {
                            if right[1] = 0 { return result }
                            result[1] := left[1] / right[1]
                        }
                        else {
                            if operation = 37 {
                                if right[1] = 0 { return result }
                                result[1] := left[1] % right[1]
                            }
                            else {
                                if operation = 256 { if left[1] = right[1] { result[1] := 1 } }
                                else {
                                    if operation = 257 { if left[1] != right[1] { result[1] := 1 } }
                                    else {
                                        if operation = 60 { if left[1] < right[1] { result[1] := 1 } }
                                        else {
                                            if operation = 62 { if left[1] > right[1] { result[1] := 1 } }
                                            else {
                                                if operation = 258 { if left[1] <= right[1] { result[1] := 1 } }
                                                else {
                                                    if operation = 259 { if left[1] >= right[1] { result[1] := 1 } }
                                                    else {
                                                        if operation = 260 { if left[1] != 0 && right[1] != 0 { result[1] := 1 } }
                                                        else { if operation = 261 { if left[1] != 0 || right[1] != 0 { result[1] := 1 } } else { return result } }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            result[0] := 1
            return result
        }
        return result
    end

    // Fold literals and immutable const bindings, but never mutable locals.
    fn compileTimeIntegerValue(source: string, pool: *[12582912]int, id: int, depth: int): [2]int
    begin
        var result: [2]int
        if id < 0 || depth > 32 { return result }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.literalKind() {
            if ast.read(pool, id, 10) != token.numberKind() { return result }
            return parseInteger(str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2)))
        }
        if kind = ast.nameKind() {
            var binding: int := ast.read(pool, id, 11)
            if binding < 0 || ast.read(pool, binding, 0) != ast.variableKind() || (ast.read(pool, binding, 10) & 32768) = 0 { return result }
            return compileTimeIntegerValue(source, pool, ast.read(pool, binding, 6), depth + 1)
        }
        if kind = ast.unaryKind() {
            result := compileTimeIntegerValue(source, pool, ast.read(pool, id, 3), depth + 1)
            if result[0] = 0 { return result }
            if ast.read(pool, id, 10) = 45 {
                result[1] := -result[1]
                return result
            }
            if ast.read(pool, id, 10) = 33 {
                if result[1] = 0 { result[1] := 1 } else { result[1] := 0 }
                return result
            }
            result[0] := 0
            return result
        }
        if kind = ast.binaryKind() {
            var left: [2]int := compileTimeIntegerValue(source, pool, ast.read(pool, id, 3), depth + 1)
            var right: [2]int := compileTimeIntegerValue(source, pool, ast.read(pool, id, 4), depth + 1)
            if left[0] = 0 || right[0] = 0 { return result }
            var operation: int := ast.read(pool, id, 10)
            if operation = 43 { result[1] := left[1] + right[1] }
            else {
                if operation = 45 { result[1] := left[1] - right[1] }
                else {
                    if operation = 42 { result[1] := left[1] * right[1] }
                    else {
                        if operation = 47 {
                            if right[1] = 0 { return result }
                            result[1] := left[1] / right[1]
                        }
                        else {
                            if operation = 37 {
                                if right[1] = 0 { return result }
                                result[1] := left[1] % right[1]
                            }
                            else { return result }
                        }
                    }
                }
            }
            result[0] := 1
            return result
        }
        return result
    end

    fn literalIntegerValue(source: string, pool: *[12582912]int, id: int): [2]int
    begin
        return compileTimeIntegerValue(source, pool, id, 0)
    end

    fn isPowerOfTwo(value: int): int
    begin
        if value <= 0 { return 0 }
        var remaining: int := value
        while remaining % 2 = 0 { remaining := remaining / 2 }
        if remaining = 1 { return 1 }
        return 0
    end

    fn integerLocalCount(source: string, pool: *[12582912]int, mainId: int): int
    begin
        var maximumOffset: int := 0
        var id: int := mainId
        var finish: int := ast.read(pool, mainId, 11)
        while id < finish {
            if ast.read(pool, id, 0) = ast.variableKind() && ast.read(pool, id, 9) = mainId && ast.read(pool, id, 11) > maximumOffset {
                maximumOffset := ast.read(pool, id, 11)
            }
            id := id + 1
        }
        return maximumOffset / 8
    end

    fn parameterCount(source: string, pool: *[12582912]int, functionId: int): int
    begin
        if str.slice(source, ast.read(pool, functionId, 3), ast.read(pool, functionId, 4)) = "main" { return 0 }
        var opening: [4]int := parser.significant(source, ast.read(pool, functionId, 4), 1)
        var item: [4]int := parser.significant(source, opening[2], opening[3])
        var count: int := 0
        while item[0] != 41 && item[0] != token.endKind() {
            count := count + 1
            var colon: [4]int := parser.significant(source, item[2], item[3])
            var type: [4]int := parser.significant(source, colon[2], colon[3])
            while type[0] != 44 && type[0] != 41 && type[0] != token.endKind() { type := parser.significant(source, type[2], type[3]) }
            item := type
            if item[0] = 44 { item := parser.significant(source, item[2], item[3]) }
        }
        return count
    end

    fn localScopeOpen(source: string, pool: *[12582912]int, functionId: int, before: int): int
    begin
        var opens: [512]int
        var depth: int := 0
        var position: int := ast.read(pool, functionId, 7)
        var finish: int := before
        var line: int := 1
        while position < finish {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = 123 {
                if depth < 512 {
                    opens[depth] := item[1]
                    depth := depth + 1
                }
            }
            else { if item[0] = 125 && depth > 0 { depth := depth - 1 } }
            position := item[2]
            line := item[3]
        }
        if depth > 0 { return opens[depth - 1] }
        return -1
    end

    fn localScopeActive(source: string, pool: *[12582912]int, functionId: int, scopeOpen: int, before: int): int
    begin
        if scopeOpen < 0 { return 1 }
        var opens: [512]int
        var depth: int := 0
        var position: int := ast.read(pool, functionId, 7)
        var line: int := 1
        while position < before {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = 123 {
                if depth < 512 {
                    opens[depth] := item[1]
                    depth := depth + 1
                }
            }
            else { if item[0] = 125 && depth > 0 { depth := depth - 1 } }
            position := item[2]
            line := item[3]
        }
        var index: int := 0
        while index < depth {
            if opens[index] = scopeOpen { return 1 }
            index := index + 1
        }
        return 0
    end

    fn localDeclaration(source: string, pool: *[12582912]int, functionId: int, wanted: string, before: int): int
    begin
        var declaration: int := -1
        var position: int := ast.read(pool, functionId, 7)
        var finish: int := before
        var line: int := 1
        while position < finish {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.nameKind() && str.slice(source, item[1], item[2]) = "var" {
                var name: [4]int := parser.significant(source, item[2], item[3])
                if name[0] = token.nameKind() && str.slice(source, name[1], name[2]) = wanted {
                    var scopeOpen: int := localScopeOpen(source, pool, functionId, item[1])
                    if localScopeActive(source, pool, functionId, scopeOpen, before) = 1 { declaration := name[1] }
                }
            }
            if item[0] = token.endKind() || item[2] <= position { position := finish }
            else {
                position := item[2]
                line := item[3]
            }
        }
        return declaration
    end

    fn integerLocalOffsetAt(source: string, pool: *[12582912]int, functionId: int, wanted: string, before: int): int
    begin
        var declaration: int := localDeclaration(source, pool, functionId, wanted, before)
        if declaration < 0 {
            if isParameter(source, pool, functionId, wanted) = 1 { return integerLocalOffset(source, pool, functionId, wanted) }
            return -1
        }
        var functionName: string := str.slice(source, ast.read(pool, functionId, 3), ast.read(pool, functionId, 4))
        var resultType: string := functionResultTypeAt(source, pool, functionId)
        var hidden: int := 0
        if indirectResult(source, resultType) = 1 { hidden := 1 }
        var ordinal: int := 0
        var position: int := ast.read(pool, functionId, 7)
        var finish: int := ast.read(pool, functionId, 8)
        var line: int := 1
        while position < finish {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.nameKind() && str.slice(source, item[1], item[2]) = "var" {
                var localDecl: [4]int := parser.significant(source, item[2], item[3])
                var colon: [4]int := parser.significant(source, localDecl[2], localDecl[3])
                var typeStart: [4]int := parser.significant(source, colon[2], colon[3])
                var typeFinish: [4]int := typeStart
                while typeFinish[0] != token.assignKind() && typeFinish[0] != 10 && typeFinish[0] != token.endKind() && typeFinish[1] < finish { typeFinish := lexer.scan(source, typeFinish[2], typeFinish[3]) }
                if localDecl[0] = token.nameKind() && colon[0] = 58 && typeStart[1] < typeFinish[1] {
                    ordinal := ordinal + typeWords(source, typeTextForFunction(source, pool, functionId, typeStart[1], typeFinish[1], typeStart[3]))
                    if localDecl[1] = declaration { return ((parameterCount(source, pool, functionId) + hidden) * 8) + ordinal * 8 }
                }
            }
            if item[0] = token.endKind() || item[2] <= position { position := finish }
            else {
                position := item[2]
                line := item[3]
            }
        }
        return -1
    end

    fn integerLocalOffset(source: string, pool: *[12582912]int, mainId: int, wanted: string): int
    begin
        var functionName: string := str.slice(source, ast.read(pool, mainId, 3), ast.read(pool, mainId, 4))
        var resultType: string := functionResultTypeAt(source, pool, mainId)
        var hidden: int := 0
        if indirectResult(source, resultType) = 1 { hidden := 1 }
        var parameterTotal: int := parameterCount(source, pool, mainId)
        if functionName != "main" {
            var opening: [4]int := parser.significant(source, ast.read(pool, mainId, 4), 1)
            var item: [4]int := parser.significant(source, opening[2], opening[3])
            var ordinal: int := 0
            while item[0] != 41 && item[0] != token.endKind() {
                var parameterName: string := str.slice(source, item[1], item[2])
                var colon: [4]int := parser.significant(source, item[2], item[3])
                var typeStart: [4]int := parser.significant(source, colon[2], colon[3])
                var typeFinish: [4]int := typeStart
                while typeFinish[0] != 44 && typeFinish[0] != 41 && typeFinish[0] != token.endKind() {
                    typeFinish := parser.significant(source, typeFinish[2], typeFinish[3])
                }
                if parameterName = wanted { return (ordinal + hidden + 1) * 8 }
                ordinal := ordinal + 1
                item := typeFinish
                if item[0] = 44 { item := parser.significant(source, item[2], item[3]) }
            }
        }
        var ordinal: int := 0
        var base: int := (parameterTotal + hidden) * 8
        var position: int := ast.read(pool, mainId, 7)
        var finish: int := ast.read(pool, mainId, 8)
        var line: int := 1
        while position < finish {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() || item[1] >= finish { position := finish }
            else {
                if item[0] = token.nameKind() && str.slice(source, item[1], item[2]) = "var" {
                    var localDecl: [4]int := parser.significant(source, item[2], item[3])
                    var colon: [4]int := parser.significant(source, localDecl[2], localDecl[3])
                    var typeToken: [4]int := parser.significant(source, colon[2], colon[3])
                    var typeFinish: [4]int := typeToken
                    while typeFinish[0] != token.assignKind() && typeFinish[0] != 10 && typeFinish[0] != token.endKind() && typeFinish[1] < finish {
                        typeFinish := lexer.scan(source, typeFinish[2], typeFinish[3])
                    }
                    if localDecl[0] = token.nameKind() && colon[0] = 58 && typeToken[1] < typeFinish[1] {
                        var type: string := typeTextForFunction(source, pool, mainId, typeToken[1], typeFinish[1], typeToken[3])
                        ordinal := ordinal + typeWords(source, type)
                        if str.slice(source, localDecl[1], localDecl[2]) = wanted { return base + ordinal * 8 }
                    }
                }
                position := item[2]
                line := item[3]
            }
        }
        return -1
    end

    // A qualified record name (module.Name) only matches the declaration inside that module.
    fn recordNameMatches(source: string, name: [4]int, declaration: int, record: string): int
    begin
        var declared: string := str.slice(source, name[1], name[2])
        if declared = record { return moduleAt(source, declaration) = "" || str.find(record, ".") < 0 }
        if declared != simpleName(record) { return 0 }
        var dot: int := str.length(record) - str.length(declared) - 1
        if dot <= 0 { return 1 }
        return moduleAt(source, declaration) = str.slice(record, 0, dot)
    end

    fn recordFieldType(source: string, record: string, wanted: string): string
    begin
        var key: string := "F" + record + "|" + wanted
        if memo.has(key) = 1 { return memo.get(key) }
        return memo.put(key, recordFieldTypeSlow(source, record, wanted))
    end

    fn recordFieldTypeSlow(source: string, record: string, wanted: string): string
    begin
        var position: int := 0
        var line: int := 1
        while position <= str.length(source) {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() { return "" }
            if item[0] = token.nameKind() && str.slice(source, item[1], item[2]) = "type" {
                var name: [4]int := lexer.scan(source, item[2], item[3])
                var colon: [4]int := lexer.scan(source, name[2], name[3])
                var marker: [4]int := lexer.scan(source, colon[2], colon[3])
                if name[0] = token.nameKind() && recordNameMatches(source, name, item[1], record) = 1 && colon[0] = 58 && str.slice(source, marker[1], marker[2]) = "record" {
                    var opening: [4]int := lexer.scan(source, marker[2], marker[3])
                    while opening[0] != token.endKind() && str.slice(source, opening[1], opening[2]) != "begin" { opening := lexer.scan(source, opening[2], opening[3]) }
                    var field: [4]int := lexer.scan(source, opening[2], opening[3])
                    while field[0] != token.endKind() && str.slice(source, field[1], field[2]) != "end" {
                        if field[0] = 10 { field := lexer.scan(source, field[2], field[3]) }
                        else {
                            var separator: [4]int := lexer.scan(source, field[2], field[3])
                            var typeStart: [4]int := lexer.scan(source, separator[2], separator[3])
                            var typeFinish: [4]int := typeStart
                            while typeFinish[0] != 10 && typeFinish[0] != token.endKind() { typeFinish := lexer.scan(source, typeFinish[2], typeFinish[3]) }
                            if str.slice(source, field[1], field[2]) = wanted && separator[0] = 58 { return typeText(source, typeStart[1], typeFinish[1], typeStart[3]) }
                            field := typeFinish
                        }
                    }
                }
            }
            position := item[2]
            line := item[3]
        }
        return ""
    end

    fn recordFieldOffset(source: string, record: string, wanted: string): int
    begin
        var key: string := "O" + record + "|" + wanted
        if memo.has(key) = 1 { return memo.number(memo.get(key)) }
        return memo.putNumber(key, recordFieldOffsetSlow(source, record, wanted))
    end

    fn recordFieldOffsetSlow(source: string, record: string, wanted: string): int
    begin
        var position: int := 0
        var line: int := 1
        while position <= str.length(source) {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() { return -1 }
            if item[0] = token.nameKind() && str.slice(source, item[1], item[2]) = "type" {
                var name: [4]int := lexer.scan(source, item[2], item[3])
                var colon: [4]int := lexer.scan(source, name[2], name[3])
                var marker: [4]int := lexer.scan(source, colon[2], colon[3])
                if name[0] = token.nameKind() && recordNameMatches(source, name, item[1], record) = 1 && colon[0] = 58 && str.slice(source, marker[1], marker[2]) = "record" {
                    var opening: [4]int := lexer.scan(source, marker[2], marker[3])
                    while opening[0] != token.endKind() && str.slice(source, opening[1], opening[2]) != "begin" { opening := lexer.scan(source, opening[2], opening[3]) }
                    var field: [4]int := lexer.scan(source, opening[2], opening[3])
                    var words: int := 0
                    while field[0] != token.endKind() && str.slice(source, field[1], field[2]) != "end" {
                        if field[0] = 10 { field := lexer.scan(source, field[2], field[3]) }
                        else {
                            var separator: [4]int := lexer.scan(source, field[2], field[3])
                            var typeStart: [4]int := lexer.scan(source, separator[2], separator[3])
                            var typeFinish: [4]int := typeStart
                            while typeFinish[0] != 10 && typeFinish[0] != token.endKind() { typeFinish := lexer.scan(source, typeFinish[2], typeFinish[3]) }
                            if str.slice(source, field[1], field[2]) = wanted && separator[0] = 58 { return words * 8 }
                            words := words + typeWords(source, typeText(source, typeStart[1], typeFinish[1], typeStart[3]))
                            field := typeFinish
                        }
                    }
                }
            }
            position := item[2]
            line := item[3]
        }
        return -1
    end

    fn recordWordCount(source: string, record: string): int
    begin
        return recordWordCountAt(source, record, 0)
    end

    fn recordWordCountAt(source: string, record: string, depth: int): int
    begin
        if str.length(record) = 0 || str.char(record, 0) = 42 || str.char(record, 0) = 91 || record = "int" || record = "flt" || record = "void" || record = "str" || record = "string" { return -1 }
        if depth > 16 { return -1 }
        var key: string := "W" + record
        if memo.has(key) = 1 { return memo.number(memo.get(key)) }
        return memo.putNumber(key, recordWordCountSlow(source, record, depth))
    end

    fn recordWordCountSlow(source: string, record: string, depth: int): int
    begin
        var position: int := 0
        var line: int := 1
        while position <= str.length(source) {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() { return -1 }
            if item[0] = token.nameKind() && str.slice(source, item[1], item[2]) = "type" {
                var name: [4]int := lexer.scan(source, item[2], item[3])
                var colon: [4]int := lexer.scan(source, name[2], name[3])
                var marker: [4]int := lexer.scan(source, colon[2], colon[3])
                if name[0] = token.nameKind() && recordNameMatches(source, name, item[1], record) = 1 && colon[0] = 58 && str.slice(source, marker[1], marker[2]) != "record" {
                    var aliasFinish: [4]int := marker
                    while aliasFinish[0] != 10 && aliasFinish[0] != token.endKind() { aliasFinish := lexer.scan(source, aliasFinish[2], aliasFinish[3]) }
                    var aliasType: string := typeText(source, marker[1], aliasFinish[1], marker[3])
                    if aliasType != record && depth < 16 { return typeWordsAt(source, aliasType, depth + 1) }
                    return 1
                }
                if name[0] = token.nameKind() && recordNameMatches(source, name, item[1], record) = 1 && colon[0] = 58 && str.slice(source, marker[1], marker[2]) = "record" {
                    var opening: [4]int := lexer.scan(source, marker[2], marker[3])
                    while opening[0] != token.endKind() && str.slice(source, opening[1], opening[2]) != "begin" { opening := lexer.scan(source, opening[2], opening[3]) }
                    var field: [4]int := lexer.scan(source, opening[2], opening[3])
                    var words: int := 0
                    while field[0] != token.endKind() && str.slice(source, field[1], field[2]) != "end" {
                        if field[0] = 10 { field := lexer.scan(source, field[2], field[3]) }
                        else {
                            var separator: [4]int := lexer.scan(source, field[2], field[3])
                            var typeStart: [4]int := lexer.scan(source, separator[2], separator[3])
                            var typeFinish: [4]int := typeStart
                            while typeFinish[0] != 10 && typeFinish[0] != token.endKind() { typeFinish := lexer.scan(source, typeFinish[2], typeFinish[3]) }
                            if separator[0] = 58 { words := words + typeWordsAt(source, typeText(source, typeStart[1], typeFinish[1], typeStart[3]), depth + 1) }
                            field := typeFinish
                        }
                    }
                    return words
                }
            }
            position := item[2]
            line := item[3]
        }
        return -1
    end

    fn typeWords(source: string, type: string): int
    begin
        return typeWordsAt(source, type, 0)
    end

    fn indirectResult(source: string, type: string): int
    begin
        if str.length(type) > 0 && str.char(type, 0) = 91 { return 1 }
        if recordWordCount(source, type) > 0 { return 1 }
        return 0
    end

    fn recordAddress(source: string, pool: *[12582912]int, functionId: int, id: int): string
    begin
        if id < 0 { return "" }
        var type: string := expressionType(source, pool, functionId, id)
        if recordWordCount(source, type) <= 0 { return "" }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.nameKind() {
            var fieldAddress: string := qualifiedFieldAddress(source, pool, functionId, id)
            if str.length(fieldAddress) > 0 { return fieldAddress }
            var name: string := str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2))
            var offset: int := boundLocalOffset(source, pool, functionId, id)
            if offset < 0 { return "" }
            if isParameter(source, pool, functionId, name) = 1 { return " mov rax, qword ptr [rbp-" + token.number(offset) + "]\n" }
            return " lea rax, [rbp-" + token.number(offset) + "]\n"
        }
        if kind = ast.memberKind() { return memberAddress(source, pool, functionId, id) }
        if kind = ast.indexKind() { return arrayElementAddress(source, pool, functionId, id) }
        if kind = ast.unaryKind() && ast.read(pool, id, 10) = 42 { return integerExpression(source, pool, functionId, ast.read(pool, id, 3)) }
        if kind = ast.callKind() { return callCode(source, pool, functionId, id) }
        return ""
    end

    fn recordCopyTo(source: string, pool: *[12582912]int, functionId: int, id: int, destinationOffset: int, words: int): string
    begin
        var address: string := recordAddress(source, pool, functionId, id)
        if str.length(address) = 0 || destinationOffset < 0 || words <= 0 { return "" }
        return address + " sub rsp, 16\n mov qword ptr [rsp], rax\n lea rdi, [rbp-" + token.number(destinationOffset) + "]\n mov rsi, qword ptr [rsp]\n mov rcx, " + token.number(words) + "\n rep movsq\n add rsp, 16\n"
    end

    fn recordParameterWords(source: string, pool: *[12582912]int, functionId: int): int
    begin
        var total: int := 0
        if str.slice(source, ast.read(pool, functionId, 3), ast.read(pool, functionId, 4)) = "main" { return 0 }
        var opening: [4]int := parser.significant(source, ast.read(pool, functionId, 4), 1)
        var parameter: [4]int := parser.significant(source, opening[2], opening[3])
        while parameter[0] != 41 && parameter[0] != token.endKind() {
            var colon: [4]int := parser.significant(source, parameter[2], parameter[3])
            var typeStart: [4]int := parser.significant(source, colon[2], colon[3])
            var typeFinish: [4]int := typeStart
            while typeFinish[0] != 44 && typeFinish[0] != 41 && typeFinish[0] != token.endKind() { typeFinish := parser.significant(source, typeFinish[2], typeFinish[3]) }
            var parameterType: string := typeTextForFunction(source, pool, functionId, typeStart[1], typeFinish[1], typeStart[3])
            var words: int := recordWordCount(source, parameterType)
            if words <= 0 && str.length(parameterType) > 0 && str.char(parameterType, 0) = 91 { words := typeWords(source, parameterType) }
            if words > 0 { total := total + words }
            parameter := typeFinish
            if parameter[0] = 44 { parameter := parser.significant(source, parameter[2], parameter[3]) }
        }
        return total
    end

    fn typeWordsAt(source: string, type: string, depth: int): int
    begin
        if depth > 16 { return 1 }
        if str.length(type) = 0 { return 1 }
        if str.char(type, 0) = 42 { return 1 }
        if type = "int" || type = "flt" || type = "void" || type = "str" || type = "string" { return 1 }
        if str.char(type, 0) = 91 {
            var position: int := 1
            var count: int := 0
            while position < str.length(type) && str.char(type, position) >= 48 && str.char(type, position) <= 57 {
                count := count * 10 + str.char(type, position) - 48
                position := position + 1
            }
            if count < 1 || position >= str.length(type) || str.char(type, position) != 93 { return 1 }
            var elementType: string := str.slice(type, position + 1, str.length(type))
            return count * typeWordsAt(source, elementType, depth + 1) + 1
        }
        var position: int := 0
        var recordWords: int := recordWordCountAt(source, type, depth + 1)
        if recordWords > 0 { return recordWords }
        return 1
    end

    fn arrayCapacity(type: string): int
    begin
        if str.length(type) < 3 || str.char(type, 0) != 91 { return 0 }
        var position: int := 1
        var count: int := 0
        while position < str.length(type) && str.char(type, position) >= 48 && str.char(type, position) <= 57 {
            count := count * 10 + str.char(type, position) - 48
            position := position + 1
        }
        if position >= str.length(type) || str.char(type, position) != 93 { return 0 }
        return count
    end

    fn initializeArrayLengthsAt(source: string, type: string, baseOffset: int, depth: int): string
    begin
        if depth > 16 || str.length(type) = 0 { return "" }
        if str.char(type, 0) = 91 {
            var capacity: int := arrayCapacity(type)
            if capacity < 1 { return "" }
            var closing: int := str.find(type, "]")
            var elementType: string := str.slice(type, closing + 1, str.length(type))
            var elementWords: int := typeWords(source, elementType)
            if elementWords < 1 { return "" }
            var output: string := str.builder("")
            var firstElementInit: string := initializeArrayLengthsAt(source, elementType, baseOffset, depth + 1)
            var index: int := 0
            if str.length(firstElementInit) > 0 {
                output := str.append(output, firstElementInit)
                index := 1
            }
            while index < capacity {
                output := str.append(output, initializeArrayLengthsAt(source, elementType, baseOffset - index * elementWords * 8, depth + 1))
                index := index + 1
            }
            var lengthOffset: int := baseOffset - capacity * elementWords * 8
            if lengthOffset < 0 { return "" }
            return output + " mov qword ptr [rbp-" + token.number(lengthOffset) + "], " + token.number(capacity + 1) + "\n"
        }
        var words: int := recordWordCountAt(source, type, depth)
        if words <= 0 { return "" }
        var position: int := 0
        var line: int := 1
        while position <= str.length(source) {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() { return "" }
            if item[0] = token.nameKind() && str.slice(source, item[1], item[2]) = "type" {
                var name: [4]int := lexer.scan(source, item[2], item[3])
                var colon: [4]int := lexer.scan(source, name[2], name[3])
                var marker: [4]int := lexer.scan(source, colon[2], colon[3])
                if name[0] = token.nameKind() && (str.slice(source, name[1], name[2]) = type || str.slice(source, name[1], name[2]) = simpleName(type)) && colon[0] = 58 {
                    if str.slice(source, marker[1], marker[2]) != "record" {
                        var aliasFinish: [4]int := marker
                        while aliasFinish[0] != 10 && aliasFinish[0] != token.endKind() { aliasFinish := lexer.scan(source, aliasFinish[2], aliasFinish[3]) }
                        var aliasType: string := typeText(source, marker[1], aliasFinish[1], marker[3])
                        if aliasType != type { return initializeArrayLengthsAt(source, aliasType, baseOffset, depth + 1) }
                    }
                    else {
                        var opening: [4]int := lexer.scan(source, marker[2], marker[3])
                        while opening[0] != token.endKind() && str.slice(source, opening[1], opening[2]) != "begin" { opening := lexer.scan(source, opening[2], opening[3]) }
                        var field: [4]int := lexer.scan(source, opening[2], opening[3])
                        var fieldOffsetWords: int := 0
                        var output: string := str.builder("")
                        while field[0] != token.endKind() && str.slice(source, field[1], field[2]) != "end" {
                            if field[0] = 10 { field := lexer.scan(source, field[2], field[3]) }
                            else {
                                var separator: [4]int := lexer.scan(source, field[2], field[3])
                                var typeStart: [4]int := lexer.scan(source, separator[2], separator[3])
                                var typeFinish: [4]int := typeStart
                                while typeFinish[0] != 10 && typeFinish[0] != token.endKind() { typeFinish := lexer.scan(source, typeFinish[2], typeFinish[3]) }
                                if separator[0] = 58 {
                                    var fieldType: string := typeText(source, typeStart[1], typeFinish[1], typeStart[3])
                                    output := str.append(output, initializeArrayLengthsAt(source, fieldType, baseOffset - fieldOffsetWords * 8, depth + 1))
                                    fieldOffsetWords := fieldOffsetWords + typeWords(source, fieldType)
                                }
                                field := typeFinish
                            }
                        }
                        return output
                    }
                }
            }
            position := item[2]
            line := item[3]
        }
        return ""
    end

    fn arrayType(source: string, pool: *[12582912]int, functionId: int, id: int): string
    begin
        if id < 0 { return "" }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.nameKind() {
            var name: string := str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2))
            return boundLocalType(source, pool, functionId, id)
        }
        if kind = ast.memberKind() { return expressionType(source, pool, functionId, id) }
        if kind = ast.callKind() {
            var called: int := ast.read(pool, id, 3)
            if called >= 0 {
                var name: string := str.slice(source, ast.read(pool, called, 1), ast.read(pool, called, 2))
                var cachedTarget: int := ast.read(pool, called, 11)
                if cachedTarget > 0 { return functionResultTypeAt(source, pool, cachedTarget - 1) }
                return functionResultType(source, pool, functionId, name)
            }
        }
        if kind = ast.unaryKind() && ast.read(pool, id, 10) = 42 {
            var operand: int := ast.read(pool, id, 3)
            if operand >= 0 && ast.read(pool, operand, 0) = ast.nameKind() {
                var name: string := str.slice(source, ast.read(pool, operand, 1), ast.read(pool, operand, 2))
                var pointerType: string := boundLocalType(source, pool, functionId, operand)
                if str.length(pointerType) > 0 && str.char(pointerType, 0) = 42 { return str.slice(pointerType, 1, str.length(pointerType)) }
            }
        }
        if kind = ast.indexKind() {
            var baseType: string := arrayType(source, pool, functionId, ast.read(pool, id, 3))
            if str.char(baseType, 0) = 91 {
                var closing: int := str.find(baseType, "]")
                if closing >= 0 { return str.slice(baseType, closing + 1, str.length(baseType)) }
            }
        }
        if kind = ast.sliceKind() { return arrayType(source, pool, functionId, ast.read(pool, id, 3)) }
        if kind = ast.memberKind() { return expressionType(source, pool, functionId, id) }
        return ""
    end

    fn arraySliceAddress(source: string, pool: *[12582912]int, functionId: int, id: int): string
    begin
        var type: string := arrayType(source, pool, functionId, ast.read(pool, id, 3))
        if str.length(type) = 0 || str.char(type, 0) != 91 { return "" }
        var length: int := arrayCapacity(type)
        if length <= 0 { return "" }
        var words: int := typeWords(source, type)
        var elementWords: int := arrayElementWords(source, type)
        var offset: int := arrayTemporaryOffset(source, pool, functionId, id)
        if words <= 0 || elementWords <= 0 || offset <= 0 { return "" }
        var base: string := arrayAddress(source, pool, functionId, ast.read(pool, id, 3))
        if str.length(base) = 0 { return "" }
        var label: string := token.number(id)
        var startCode: string := " xor eax, eax\n"
        var finishCode: string := " mov rax, qword ptr [rsp+40]\n"
        if ast.read(pool, id, 4) >= 0 { startCode := integerExpression(source, pool, functionId, ast.read(pool, id, 4)) }
        if ast.read(pool, id, 6) >= 0 { finishCode := integerExpression(source, pool, functionId, ast.read(pool, id, 6)) }
        if str.length(startCode) = 0 || str.length(finishCode) = 0 { return "" }
        var lengthOffset: int := length * elementWords * 8
        var output: string := str.builder(base + " sub rsp, 48\n mov qword ptr [rsp+8], rax\n mov rdx, qword ptr [rsp+8]\n mov rcx, qword ptr [rdx+" + token.number(lengthOffset) + "]\n test rcx, rcx\n jnz .LxeSliceLengthKnown" + label + "\n mov rcx, " + token.number(length) + "\n jmp .LxeSliceLengthReady" + label + "\n.LxeSliceLengthKnown" + label + ":\n dec rcx\n.LxeSliceLengthReady" + label + ":\n mov qword ptr [rsp+40], rcx\n" + startCode + " mov qword ptr [rsp+16], rax\n" + finishCode + " mov qword ptr [rsp+24], rax\n")
        output := str.append(output, " mov rax, qword ptr [rsp+16]\n test rax, rax\n js .LxeArraySliceFail\n mov rdx, qword ptr [rsp+24]\n cmp rdx, rax\n jl .LxeArraySliceFail\n cmp rdx, qword ptr [rsp+40]\n ja .LxeArraySliceFail\n sub rdx, rax\n mov qword ptr [rsp+32], rdx\n")
        output := str.append(output, " lea rax, [rbp-" + token.number(offset) + "]\n mov qword ptr [rsp], rax\n mov rdi, rax\n xor eax, eax\n mov rcx, " + token.number(words) + "\n rep stosq\n mov rsi, qword ptr [rsp+8]\n mov rax, qword ptr [rsp+16]\n imul rax, " + token.number(elementWords * 8) + "\n add rsi, rax\n mov rdi, qword ptr [rsp]\n mov rcx, qword ptr [rsp+32]\n imul rcx, " + token.number(elementWords) + "\n rep movsq\n mov rdx, qword ptr [rsp]\n mov rcx, qword ptr [rsp+32]\n inc rcx\n mov qword ptr [rdx+" + token.number(lengthOffset) + "], rcx\n mov rax, qword ptr [rsp]\n add rsp, 48\n")
        return output
    end

    fn arrayElementWords(source: string, type: string): int
    begin
        if str.length(type) = 0 { return 1 }
        if str.char(type, 0) != 91 { return 1 }
        var closing: int := str.find(type, "]")
        if closing < 0 { return 1 }
        return typeWords(source, str.slice(type, closing + 1, str.length(type)))
    end

    fn isParameter(source: string, pool: *[12582912]int, functionId: int, wanted: string): int
    begin
        if str.slice(source, ast.read(pool, functionId, 3), ast.read(pool, functionId, 4)) = "main" { return 0 }
        var opening: [4]int := parser.significant(source, ast.read(pool, functionId, 4), 1)
        var item: [4]int := parser.significant(source, opening[2], opening[3])
        while item[0] != 41 && item[0] != token.endKind() {
            if str.slice(source, item[1], item[2]) = wanted { return 1 }
            var colon: [4]int := parser.significant(source, item[2], item[3])
            var type: [4]int := parser.significant(source, colon[2], colon[3])
            while type[0] != 44 && type[0] != 41 && type[0] != token.endKind() { type := parser.significant(source, type[2], type[3]) }
            item := type
            if item[0] = 44 { item := parser.significant(source, item[2], item[3]) }
        }
        return 0
    end

    fn memberAddress(source: string, pool: *[12582912]int, functionId: int, id: int): string
    begin
        if id < 0 || ast.read(pool, id, 0) != ast.memberKind() { return "" }
        var base: int := ast.read(pool, id, 3)
        var baseType: string := expressionType(source, pool, functionId, base)
        var field: string := str.slice(source, ast.read(pool, id, 7), ast.read(pool, id, 8))
        if str.length(baseType) > 1 && str.char(baseType, 0) = 42 {
            var pointerOffset: int := recordFieldOffset(source, str.slice(baseType, 1, str.length(baseType)), field)
            if pointerOffset < 0 { return "" }
            var pointerValue: string := integerExpression(source, pool, functionId, base)
            if str.length(pointerValue) = 0 { return "" }
            if pointerOffset > 0 { return pointerValue + " add rax, " + token.number(pointerOffset) + "\n" }
            return pointerValue
        }
        var offset: int := recordFieldOffset(source, baseType, field)
        if offset < 0 { return "" }
        var address: string := ""
        var baseKind: int := ast.read(pool, base, 0)
        if baseKind = ast.unaryKind() && ast.read(pool, base, 10) = 42 {
            address := integerExpression(source, pool, functionId, ast.read(pool, base, 3))
        }
        else {
            if baseKind = ast.memberKind() { address := memberAddress(source, pool, functionId, base) }
            else {
                if baseKind = ast.indexKind() { address := arrayElementAddress(source, pool, functionId, base) }
                else {
                    if baseKind = ast.nameKind() {
                        var localOffset: int := boundLocalOffset(source, pool, functionId, base)
                        if localOffset >= 0 {
                            var name: string := str.slice(source, ast.read(pool, base, 1), ast.read(pool, base, 2))
                            if isParameter(source, pool, functionId, name) = 1 { address := " mov rax, qword ptr [rbp-" + token.number(localOffset) + "]\n" }
                            else { address := " lea rax, [rbp-" + token.number(localOffset) + "]\n" }
                        }
                    }
                }
            }
        }
        if str.length(address) = 0 { return "" }
        if offset > 0 { address := address + " add rax, " + token.number(offset) + "\n" }
        return address
    end

    fn qualifiedFieldAddress(source: string, pool: *[12582912]int, functionId: int, id: int): string
    begin
        if id < 0 || ast.read(pool, id, 0) != ast.nameKind() { return "" }
        var fullName: string := str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2))
        var dot: int := str.find(fullName, ".")
        if dot < 0 { return "" }
        var root: string := str.slice(fullName, 0, dot)
        var path: string := str.slice(fullName, dot + 1, str.length(fullName))
        var binding: int := ast.read(pool, id, 11)
        var recordType: string := ""
        var offset: int := 0
        var address: string := ""
        if binding >= 0 {
            recordType := typeTextForFunction(source, pool, functionId, ast.read(pool, binding, 7), ast.read(pool, binding, 8), 1)
            offset := ast.read(pool, binding, 11)
            address := " lea rax, [rbp-" + token.number(offset) + "]\n"
        }
        else {
            if binding <= -2 {
                recordType := functionParameterType(source, pool, functionId, "", -2 - binding)
                var resultType: string := functionResultTypeAt(source, pool, functionId)
                var hidden: int := 0
                if indirectResult(source, resultType) = 1 { hidden := 1 }
                offset := (-2 - binding + hidden + 1) * 8
                address := " mov rax, qword ptr [rbp-" + token.number(offset) + "]\n"
                if str.length(recordType) > 0 && str.char(recordType, 0) = 42 { address := " lea rax, [rbp-" + token.number(offset) + "]\n" }
            }
        }
        if str.length(address) = 0 { return "" }
        return recordPathAddress(source, address, recordType, path)
    end

    fn arrayAddress(source: string, pool: *[12582912]int, functionId: int, id: int): string
    begin
        if id < 0 { return "" }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.nameKind() {
            var fieldAddress: string := qualifiedFieldAddress(source, pool, functionId, id)
            if str.length(fieldAddress) > 0 { return fieldAddress }
            var name: string := str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2))
            var offset: int := boundLocalOffset(source, pool, functionId, id)
            if offset < 0 { return "" }
            if isParameter(source, pool, functionId, name) = 1 { return " mov rax, qword ptr [rbp-" + token.number(offset) + "]\n" }
            return " lea rax, [rbp-" + token.number(offset) + "]\n"
        }
        if kind = ast.sliceKind() { return arraySliceAddress(source, pool, functionId, id) }
        if kind = ast.indexKind() { return arrayElementAddress(source, pool, functionId, id) }
        if kind = ast.memberKind() { return memberAddress(source, pool, functionId, id) }
        if kind = ast.unaryKind() && ast.read(pool, id, 10) = 42 { return integerExpression(source, pool, functionId, ast.read(pool, id, 3)) }
        if kind = ast.callKind() { return callCode(source, pool, functionId, id) }
        return ""
    end

    fn arrayExpressionType(source: string, pool: *[12582912]int, functionId: int, id: int): int
    begin
        var type: string := arrayType(source, pool, functionId, id)
        if str.length(type) > 0 && str.char(type, 0) = 91 { return 1 }
        return 0
    end

    fn arrayLengthIsFixedLocal(source: string, pool: *[12582912]int, functionId: int, baseId: int): int
    begin
        if baseId < 0 || ast.read(pool, baseId, 0) != ast.nameKind() { return 0 }
        var binding: int := ast.read(pool, baseId, 11)
        if binding < 0 || isParameter(source, pool, functionId, str.slice(source, ast.read(pool, baseId, 1), ast.read(pool, baseId, 2))) = 1 { return 0 }
        var declaredType: string := typeTextForFunction(source, pool, functionId, ast.read(pool, binding, 7), ast.read(pool, binding, 8), 1)
        if str.length(declaredType) = 0 || str.char(declaredType, 0) != 91 { return 0 }
        if ast.read(pool, binding, 6) >= 0 { return 0 }
        var candidate: int := functionId
        var finish: int := ast.read(pool, functionId, 11)
        while candidate < finish {
            if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 0) = ast.assignKind() {
                var target: int := ast.read(pool, candidate, 3)
                if target >= 0 && ast.read(pool, target, 0) = ast.nameKind() && ast.read(pool, target, 11) = binding { return 0 }
            }
            if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 0) = ast.unaryKind() && ast.read(pool, candidate, 10) = 38 {
                var addressTarget: int := ast.read(pool, candidate, 3)
                if addressTarget >= 0 && ast.read(pool, addressTarget, 0) = ast.nameKind() && ast.read(pool, addressTarget, 11) = binding { return 0 }
            }
            if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 0) = ast.callKind() {
                var argument: int := ast.read(pool, candidate, 6)
                while argument >= 0 {
                    var argumentKind: int := ast.read(pool, argument, 0)
                    if argumentKind = ast.nameKind() && ast.read(pool, argument, 11) = binding { return 0 }
                    if argumentKind = ast.unaryKind() && ast.read(pool, argument, 10) = 38 {
                        var addressArgument: int := ast.read(pool, argument, 3)
                        if addressArgument >= 0 && ast.read(pool, addressArgument, 0) = ast.nameKind() && ast.read(pool, addressArgument, 11) = binding { return 0 }
                    }
                    argument := ast.read(pool, argument, 5)
                }
            }
            candidate := candidate + 1
        }
        return 1
    end

    fn loopInitialCounterValue(source: string, pool: *[12582912]int, functionId: int, loopId: int, binding: int): [3]int
    begin
        var result: [3]int
        var initial: [2]int := compileTimeIntegerValue(source, pool, ast.read(pool, binding, 6), 0)
        if initial[0] = 0 { return result }
        var latestPosition: int := ast.read(pool, binding, 2)
        var statement: int := ast.read(pool, functionId, 6)
        while statement >= 0 && statement != loopId {
            if ast.read(pool, statement, 0) = ast.assignKind() {
                var target: int := ast.read(pool, statement, 3)
                if target >= 0 && ast.read(pool, target, 0) = ast.nameKind() && ast.read(pool, target, 11) = binding {
                    initial := compileTimeIntegerValue(source, pool, ast.read(pool, statement, 4), 0)
                    if initial[0] = 0 { return result }
                    latestPosition := ast.read(pool, statement, 2)
                }
            }
            statement := ast.read(pool, statement, 5)
        }
        if statement != loopId { return result }
        var candidate: int := functionId
        var finish: int := ast.read(pool, functionId, 11)
        while candidate < finish {
            if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 0) = ast.assignKind() && ast.read(pool, candidate, 1) > latestPosition && ast.read(pool, candidate, 1) < ast.read(pool, loopId, 1) {
                var target: int := ast.read(pool, candidate, 3)
                if target >= 0 && ast.read(pool, target, 0) = ast.nameKind() && ast.read(pool, target, 11) = binding { return result }
            }
            candidate := candidate + 1
        }
        result[0] := 1
        result[1] := initial[1]
        result[2] := latestPosition
        return result
    end

    fn loopCounterRange(source: string, pool: *[12582912]int, functionId: int, binding: int, position: int): [3]int
    begin
        var result: [3]int
        var limit: int := ast.read(pool, functionId, 11)
        var loop: int := functionId
        while loop < limit {
            if ast.read(pool, loop, 9) = functionId && ast.read(pool, loop, 0) = ast.loopKind() && ast.read(pool, loop, 1) <= position && ast.read(pool, loop, 2) > position {
                var bodyBlock: int := ast.read(pool, loop, 6)
                var bodyStart: int := ast.read(pool, bodyBlock, 1)
                var bodyFinish: int := ast.read(pool, bodyBlock, 2)
                if position >= bodyStart && position < bodyFinish {
                    var condition: int := ast.read(pool, loop, 3)
                    if ast.read(pool, condition, 0) = ast.binaryKind() && ast.read(pool, condition, 10) = 60 {
                        var conditionIndex: int := ast.read(pool, condition, 3)
                        if conditionIndex >= 0 && ast.read(pool, conditionIndex, 0) = ast.nameKind() && ast.read(pool, conditionIndex, 11) = binding {
                                // Resolve the latest direct initialization before
                                // this loop (for example `i := 1` after a declaration
                                // initialized to zero), then reject hidden writes.
                                var initial: [3]int := loopInitialCounterValue(source, pool, functionId, loop, binding)
                                if initial[0] = 0 {
                                    // Nested loop declarations are not direct
                                    // entries in the function statement chain.
                                    // In that case, start from the declaration
                                    // initializer; the all-node scan below
                                    // rejects any intervening mutation.
                                    var declaredInitial: [2]int := compileTimeIntegerValue(source, pool, ast.read(pool, binding, 6), 0)
                                    if declaredInitial[0] = 1 {
                                        initial[0] := 1
                                        initial[1] := declaredInitial[1]
                                        initial[2] := ast.read(pool, binding, 2)
                                    }
                                }
                            var bound: [2]int := compileTimeIntegerValue(source, pool, ast.read(pool, condition, 4), 0)
                                if initial[0] = 1 && initial[1] >= 0 && initial[1] <= 1000000000 && bound[0] = 1 && bound[1] > initial[1] && bound[1] <= 1000000000 {
                                // The counter must not be changed, aliased, or
                                // exposed to inline assembly before this loop.
                                // The loop-initial-value helper only follows
                                // direct statements, so scan all AST nodes in
                                // the source interval as well (including nested
                                // branches that precede the loop).
                                var prior: int := functionId
                                while prior < limit {
                                    if ast.read(pool, prior, 1) > initial[2] && ast.read(pool, prior, 2) < ast.read(pool, loop, 1) {
                                        if ast.read(pool, prior, 0) = ast.assignKind() {
                                            var priorTarget: int := ast.read(pool, prior, 3)
                                            if priorTarget >= 0 && ast.read(pool, priorTarget, 0) = ast.nameKind() && ast.read(pool, priorTarget, 11) = binding { return result }
                                        }
                                        if ast.read(pool, prior, 0) = ast.unaryKind() && ast.read(pool, prior, 10) = 38 {
                                            var priorAddress: int := ast.read(pool, prior, 3)
                                            if priorAddress >= 0 && ast.read(pool, priorAddress, 0) = ast.nameKind() && ast.read(pool, priorAddress, 11) = binding { return result }
                                        }
                                        if ast.read(pool, prior, 0) = ast.assemblyKind() { return result }
                                    }
                                    prior := prior + 1
                                }
                                var updates: int := 0
                                var updateId: int := -1
                                var candidate: int := functionId
                                while candidate < limit {
                                    if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 0) = ast.assignKind() && ast.read(pool, candidate, 1) > ast.read(pool, loop, 1) && ast.read(pool, candidate, 2) < ast.read(pool, loop, 2) {
                                        var target: int := ast.read(pool, candidate, 3)
                                        if target >= 0 && ast.read(pool, target, 0) = ast.nameKind() && ast.read(pool, target, 11) = binding {
                                            updates := updates + 1
                                            updateId := candidate
                                        }
                                    }
                                    if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 0) = ast.unaryKind() && ast.read(pool, candidate, 10) = 38 {
                                        var addressed: int := ast.read(pool, candidate, 3)
                                        if addressed >= 0 && ast.read(pool, addressed, 0) = ast.nameKind() && ast.read(pool, addressed, 11) = binding { updates := updates + 2 }
                                    }
                                    if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 0) = ast.assemblyKind() { updates := updates + 2 }
                                    candidate := candidate + 1
                                }
                                if updates = 1 && updateId >= 0 && position <= ast.read(pool, updateId, 1) {
                                    var increment: int := ast.read(pool, updateId, 4)
                                    if ast.read(pool, increment, 0) = ast.binaryKind() && ast.read(pool, increment, 10) = 43 {
                                        var incrementIndex: int := ast.read(pool, increment, 3)
                                        var amount: [2]int := compileTimeIntegerValue(source, pool, ast.read(pool, increment, 4), 0)
                                        if incrementIndex >= 0 && ast.read(pool, incrementIndex, 0) = ast.nameKind() && ast.read(pool, incrementIndex, 11) = binding && amount[0] = 1 && amount[1] = 1 {
                                            var statement: int := ast.read(pool, bodyBlock, 6)
                                            while statement >= 0 && statement != updateId { statement := ast.read(pool, statement, 5) }
                                            if statement = updateId {
                                                result[0] := 1
                                                result[1] := initial[1]
                                                result[2] := bound[1] - 1
                                                return result
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            loop := loop + 1
        }
        return result
    end

    fn descendingLoopCounterRange(source: string, pool: *[12582912]int, functionId: int, binding: int, position: int): [3]int
    begin
        var result: [3]int
        if binding < 0 || ast.read(pool, binding, 6) < 0 { return result }
        var limit: int := ast.read(pool, functionId, 11)
        var loop: int := functionId
        while loop < limit {
            if ast.read(pool, loop, 9) = functionId && ast.read(pool, loop, 0) = ast.loopKind() && ast.read(pool, loop, 1) <= position && ast.read(pool, loop, 2) > position {
                var body: int := ast.read(pool, loop, 6)
                if position >= ast.read(pool, body, 1) && position < ast.read(pool, body, 2) {
                    var condition: int := ast.read(pool, loop, 3)
                    if ast.read(pool, condition, 0) = ast.binaryKind() && ast.read(pool, condition, 10) = 260 { condition := ast.read(pool, condition, 3) }
                    if ast.read(pool, condition, 0) = ast.binaryKind() && ast.read(pool, condition, 10) = 62 {
                        var counter: int := ast.read(pool, condition, 3)
                        var lower: [2]int := compileTimeIntegerValue(source, pool, ast.read(pool, condition, 4), 0)
                        if counter >= 0 && ast.read(pool, counter, 0) = ast.nameKind() && ast.read(pool, counter, 11) = binding && lower[0] = 1 && lower[1] = 0 {
                            var initial: [3]int := expressionIntegerRange(source, pool, functionId, ast.read(pool, binding, 6), ast.read(pool, binding, 1), 0)
                            if initial[0] = 1 && initial[1] >= 0 && initial[2] > initial[1] {
                                var writes: int := 0
                                var update: int := -1
                                var candidate: int := functionId
                                while candidate < limit {
                                    if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 1) >= ast.read(pool, body, 1) && ast.read(pool, candidate, 2) <= ast.read(pool, body, 2) {
                                        if ast.read(pool, candidate, 0) = ast.loopKind() || ast.read(pool, candidate, 0) = ast.callKind() { return result }
                                        if ast.read(pool, candidate, 0) = ast.assignKind() {
                                            var target: int := ast.read(pool, candidate, 3)
                                            if target >= 0 && ast.read(pool, target, 0) = ast.nameKind() && ast.read(pool, target, 11) = binding {
                                                writes := writes + 1
                                                update := candidate
                                            }
                                        }
                                        if ast.read(pool, candidate, 0) = ast.unaryKind() && ast.read(pool, candidate, 10) = 38 {
                                            var addressed: int := ast.read(pool, candidate, 3)
                                            if addressed >= 0 && ast.read(pool, addressed, 0) = ast.nameKind() && ast.read(pool, addressed, 11) = binding { writes := writes + 2 }
                                        }
                                        if ast.read(pool, candidate, 0) = ast.assemblyKind() { writes := writes + 2 }
                                    }
                                    candidate := candidate + 1
                                }
                                if writes = 1 && update >= 0 {
                                    var increment: int := ast.read(pool, update, 4)
                                    if ast.read(pool, increment, 0) = ast.binaryKind() && ast.read(pool, increment, 10) = 45 {
                                        var left: int := ast.read(pool, increment, 3)
                                        var amount: [2]int := compileTimeIntegerValue(source, pool, ast.read(pool, increment, 4), 0)
                                        if left >= 0 && ast.read(pool, left, 0) = ast.nameKind() && ast.read(pool, left, 11) = binding && amount[0] = 1 && amount[1] = 1 {
                                            result[0] := 1
                                            result[1] := 1
                                            result[2] := initial[2]
                                            return result
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            loop := loop + 1
        }
        return result
    end

    fn expressionIntegerRange(source: string, pool: *[12582912]int, functionId: int, id: int, position: int, depth: int): [3]int
    begin
        var result: [3]int
        if id < 0 || depth > 16 || expressionType(source, pool, functionId, id) != "int" { return result }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.literalKind() {
            var constant: [2]int := compileTimeIntegerValue(source, pool, id, 0)
            if constant[0] = 1 && constant[1] >= -1000000000 && constant[1] <= 1000000000 {
                result[0] := 1
                result[1] := constant[1]
                result[2] := constant[1]
            }
            return result
        }
        if kind = ast.nameKind() {
            var binding: int := ast.read(pool, id, 11)
            if binding < 0 { return result }
            var constant: [2]int := compileTimeIntegerValue(source, pool, id, 0)
            if constant[0] = 1 && constant[1] >= -1000000000 && constant[1] <= 1000000000 {
                result[0] := 1
                result[1] := constant[1]
                result[2] := constant[1]
                return result
            }
            var counter: [3]int := loopCounterRange(source, pool, functionId, binding, position)
            if counter[0] = 1 { return counter }
            var descending: [3]int := descendingLoopCounterRange(source, pool, functionId, binding, position)
            if descending[0] = 1 { return descending }
            var limit: int := ast.read(pool, functionId, 11)
            var candidate: int := functionId
            while candidate < limit {
                if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 0) = ast.assignKind() {
                    var target: int := ast.read(pool, candidate, 3)
                    if target >= 0 && ast.read(pool, target, 0) = ast.nameKind() && ast.read(pool, target, 11) = binding { return result }
                }
                if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 0) = ast.unaryKind() && ast.read(pool, candidate, 10) = 38 {
                    var addressed: int := ast.read(pool, candidate, 3)
                    if addressed >= 0 && ast.read(pool, addressed, 0) = ast.nameKind() && ast.read(pool, addressed, 11) = binding { return result }
                }
                if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 0) = ast.assemblyKind() { return result }
                candidate := candidate + 1
            }
            var initializer: int := ast.read(pool, binding, 6)
            if initializer >= 0 && ast.read(pool, binding, 2) <= position {
                return expressionIntegerRange(source, pool, functionId, initializer, ast.read(pool, binding, 1), depth + 1)
            }
            return result
        }
        if kind = ast.unaryKind() && ast.read(pool, id, 10) = 45 {
            var operand: [3]int := expressionIntegerRange(source, pool, functionId, ast.read(pool, id, 3), position, depth + 1)
            if operand[0] = 1 {
                result[0] := 1
                result[1] := -operand[2]
                result[2] := -operand[1]
            }
            return result
        }
        if kind = ast.binaryKind() {
            var operation: int := ast.read(pool, id, 10)
            if operation = 43 || operation = 45 || operation = 42 {
                var left: [3]int := expressionIntegerRange(source, pool, functionId, ast.read(pool, id, 3), position, depth + 1)
                var right: [3]int := expressionIntegerRange(source, pool, functionId, ast.read(pool, id, 4), position, depth + 1)
                if left[0] = 0 || right[0] = 0 { return result }
                if operation = 43 {
                    result[1] := left[1] + right[1]
                    result[2] := left[2] + right[2]
                }
                if operation = 45 {
                    result[1] := left[1] - right[2]
                    result[2] := left[2] - right[1]
                }
                if operation = 42 {
                    var values: [4]int
                    values[0] := left[1] * right[1]
                    values[1] := left[1] * right[2]
                    values[2] := left[2] * right[1]
                    values[3] := left[2] * right[2]
                    result[1] := values[0]
                    result[2] := values[0]
                    var item: int := 1
                    while item < 4 {
                        if values[item] < result[1] { result[1] := values[item] }
                        if values[item] > result[2] { result[2] := values[item] }
                        item := item + 1
                    }
                }
                if result[1] < -1000000000 || result[2] > 1000000000 {
                    result[0] := 0
                    return result
                }
                result[0] := 1
                return result
            }
        }
        return result
    end

    fn arrayIndexIsProvenInBounds(source: string, pool: *[12582912]int, functionId: int, accessId: int, indexId: int, capacity: int): int
    begin
        if indexId < 0 || ast.read(pool, indexId, 0) != ast.nameKind() { return 0 }
        var binding: int := ast.read(pool, indexId, 11)
        if binding < 0 { return 0 }
        if ast.read(pool, binding, 6) < 0 { return 0 }
        var functionFinish: int := ast.read(pool, functionId, 11)
        var loop: int := functionId
        while loop < functionFinish {
            if ast.read(pool, loop, 9) = functionId && ast.read(pool, loop, 0) = ast.loopKind() && ast.read(pool, loop, 1) <= ast.read(pool, accessId, 1) && ast.read(pool, loop, 2) >= ast.read(pool, accessId, 2) {
                var condition: int := ast.read(pool, loop, 3)
                if ast.read(pool, condition, 0) = ast.binaryKind() && ast.read(pool, condition, 10) = 60 {
                    var conditionIndex: int := ast.read(pool, condition, 3)
                    if conditionIndex >= 0 && ast.read(pool, conditionIndex, 0) = ast.nameKind() && ast.read(pool, conditionIndex, 11) = binding {
                        var initial: [3]int := loopInitialCounterValue(source, pool, functionId, loop, binding)
                        var bound: [2]int := compileTimeIntegerValue(source, pool, ast.read(pool, condition, 4), 0)
                        if initial[0] = 1 && initial[1] >= 0 && bound[0] = 1 && bound[1] > initial[1] && bound[1] <= capacity {
                            var updates: int := 0
                            var updateId: int := -1
                            var candidate: int := functionId
                            while candidate < functionFinish {
                                if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 0) = ast.assemblyKind() { return 0 }
                                if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 0) = ast.assignKind() {
                                    var target: int := ast.read(pool, candidate, 3)
                                    if target >= 0 && ast.read(pool, target, 0) = ast.nameKind() && ast.read(pool, target, 11) = binding && ast.read(pool, candidate, 1) > ast.read(pool, loop, 1) && ast.read(pool, candidate, 2) < ast.read(pool, loop, 2) {
                                        updates := updates + 1
                                        updateId := candidate
                                    }
                                }
                                if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 0) = ast.unaryKind() && ast.read(pool, candidate, 10) = 38 {
                                    var addressTarget: int := ast.read(pool, candidate, 3)
                                    if addressTarget >= 0 && ast.read(pool, addressTarget, 0) = ast.nameKind() && ast.read(pool, addressTarget, 11) = binding { updates := updates + 2 }
                                }
                                candidate := candidate + 1
                            }
                            if updates = 1 && updateId >= 0 {
                                var increment: int := ast.read(pool, updateId, 4)
                                if ast.read(pool, increment, 0) = ast.binaryKind() && ast.read(pool, increment, 10) = 43 {
                                    var incrementIndex: int := ast.read(pool, increment, 3)
                                    var amount: [2]int := compileTimeIntegerValue(source, pool, ast.read(pool, increment, 4), 0)
                                    if incrementIndex >= 0 && ast.read(pool, incrementIndex, 0) = ast.nameKind() && ast.read(pool, incrementIndex, 11) = binding && amount[0] = 1 && amount[1] = 1 && ast.read(pool, accessId, 2) <= ast.read(pool, updateId, 1) {
                                        var body: int := ast.read(pool, ast.read(pool, loop, 6), 6)
                                        while body >= 0 && body != updateId { body := ast.read(pool, body, 5) }
                                        if body = updateId { return 1 }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            loop := loop + 1
        }
        return 0
    end

    fn arrayElementAddress(source: string, pool: *[12582912]int, functionId: int, id: int): string
    begin
        if id < 0 || ast.read(pool, id, 0) != ast.indexKind() { return "" }
        var baseId: int := ast.read(pool, id, 3)
        var index: string := integerExpression(source, pool, functionId, ast.read(pool, id, 4))
        if str.length(index) = 0 { return "" }
        var baseType: string := arrayType(source, pool, functionId, baseId)
        var width: int := arrayElementWords(source, baseType) * 8
        if width <= 0 { return "" }
        var capacity: int := arrayCapacity(baseType)
        // A fixed local array can use its compile-time capacity for bounds
        // checks and a direct stack-relative address, even in a large frame.
        if capacity > 0 && arrayLengthIsFixedLocal(source, pool, functionId, baseId) = 1 {
            var offset: int := boundLocalOffset(source, pool, functionId, baseId)
            if offset < 0 { return "" }
            var address: string := ""
            if width = 8 { address := " lea rax, [rbp-" + token.number(offset) + "+rax*8]\n" }
            else {
                if isPowerOfTwo(width) = 1 {
                    var shift: int := 0
                    var stride: int := width
                    while stride > 1 {
                        stride := stride / 2
                        shift := shift + 1
                    }
                    address := " shl rax, " + token.number(shift) + "\n lea rax, [rbp-" + token.number(offset) + "+rax]\n"
                } else {
                    address := " imul rax, " + token.number(width) + "\n lea rax, [rbp-" + token.number(offset) + "+rax]\n"
                }
            }
            var indexRange: [3]int := expressionIntegerRange(source, pool, functionId, ast.read(pool, id, 4), ast.read(pool, id, 1), 0)
            if indexRange[0] = 1 && indexRange[1] >= 0 && indexRange[2] < capacity {
                var direct: string := directLocalArrayAddress(source, pool, functionId, ast.read(pool, id, 4), offset, width)
                if str.length(direct) > 0 { return direct }
                return index + address
            }
            if arrayIndexIsProvenInBounds(source, pool, functionId, id, ast.read(pool, id, 4), capacity) = 1 { return index + address }
            return index + " cmp rax, " + token.number(capacity) + "\n jae .LxeArrayIndexFail\n" + address
        }
        var base: string := arrayAddress(source, pool, functionId, baseId)
        if str.length(base) = 0 { return "" }
        var indexCheck: string := ""
        var throughPointer: int := 0
        if baseId >= 0 && ast.read(pool, baseId, 0) = ast.unaryKind() && ast.read(pool, baseId, 10) = 42 { throughPointer := 1 }
        if capacity > 0 && throughPointer = 1 {
            indexCheck := " cmp rax, " + token.number(capacity) + "\n jae .LxeArrayIndexFail\n"
            if arrayIndexIsProvenInBounds(source, pool, functionId, id, ast.read(pool, id, 4), capacity) = 1 { indexCheck := "" }
        }
        if capacity > 0 && throughPointer = 0 {
            var lengthOffset: int := capacity * arrayElementWords(source, baseType) * 8
            var label: string := token.number(id)
            indexCheck := " mov rdx, qword ptr [rsp]\n mov rcx, qword ptr [rdx+" + token.number(lengthOffset) + "]\n test rcx, rcx\n jnz .LxeArrayLengthKnown" + label + "\n mov rcx, " + token.number(capacity) + "\n jmp .LxeArrayLengthReady" + label + "\n.LxeArrayLengthKnown" + label + ":\n dec rcx\n.LxeArrayLengthReady" + label + ":\n cmp rax, rcx\n jae .LxeArrayIndexFail\n"
        }
        var baseOperand: string := simpleOperand(base)
        if throughPointer = 1 && capacity > 0 && str.length(baseOperand) > 0 {
            if width = 1 || width = 2 || width = 4 || width = 8 { return index + indexCheck + " mov rcx, " + baseOperand + "\n lea rax, [rcx+rax*" + token.number(width) + "]\n" }
            return index + indexCheck + " imul rax, " + token.number(width) + "\n add rax, " + baseOperand + "\n"
        }
        return base + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + index + indexCheck + " imul rax, " + token.number(width) + "\n mov rcx, rax\n mov rax, qword ptr [rsp]\n add rax, rcx\n add rsp, 16\n"
    end

    fn directLocalArrayAddress(source: string, pool: *[12582912]int, functionId: int, indexId: int, arrayOffset: int, width: int): string
    begin
        if indexId < 0 || width <= 0 || width > 8 || isPowerOfTwo(width) = 0 { return "" }
        var name: int := -1
        var displacement: int := 0
        var kind: int := ast.read(pool, indexId, 0)
        if kind = ast.nameKind() { name := indexId }
        else {
            if kind = ast.binaryKind() {
                var operation: int := ast.read(pool, indexId, 10)
                if operation != 43 && operation != 45 { return "" }
                var left: int := ast.read(pool, indexId, 3)
                var right: int := ast.read(pool, indexId, 4)
                var constant: [2]int := compileTimeIntegerValue(source, pool, right, 0)
                if left >= 0 && ast.read(pool, left, 0) = ast.nameKind() && constant[0] = 1 {
                    name := left
                    displacement := constant[1]
                }
                else {
                    if operation = 43 {
                        constant := compileTimeIntegerValue(source, pool, left, 0)
                        if right >= 0 && ast.read(pool, right, 0) = ast.nameKind() && constant[0] = 1 {
                            name := right
                            displacement := constant[1]
                        }
                    }
                }
                if operation = 45 { displacement := -displacement }
            }
        }
        if name < 0 { return "" }
        if displacement > 268435455 || displacement < -268435455 { return "" }
        var register: int := registerIndexForName(source, pool, functionId, name)
        if register < 0 { return "" }
        var byteDisplacement: int := displacement * width
        if byteDisplacement > 2147483647 || byteDisplacement < -2147483647 { return "" }
        var suffix: string := ""
        if byteDisplacement > 0 { suffix := "+" + token.number(byteDisplacement) }
        if byteDisplacement < 0 { suffix := token.number(byteDisplacement) }
        var scale: string := ""
        if width > 1 { scale := "*" + token.number(width) }
        return " lea rax, [rbp-" + token.number(arrayOffset) + "+" + registerName(register) + scale + suffix + "]\n"
    end

    fn directLocalArrayMemory(source: string, pool: *[12582912]int, functionId: int, indexId: int, arrayOffset: int, width: int): string
    begin
        if indexId < 0 || arrayOffset < 0 || width <= 0 || width > 8 || isPowerOfTwo(width) = 0 { return "" }
        var name: int := -1
        var displacement: int := 0
        var kind: int := ast.read(pool, indexId, 0)
        if kind = ast.nameKind() { name := indexId }
        else {
            if kind = ast.binaryKind() {
                var operation: int := ast.read(pool, indexId, 10)
                if operation != 43 && operation != 45 { return "" }
                var left: int := ast.read(pool, indexId, 3)
                var right: int := ast.read(pool, indexId, 4)
                var constant: [2]int := compileTimeIntegerValue(source, pool, right, 0)
                if left >= 0 && ast.read(pool, left, 0) = ast.nameKind() && constant[0] = 1 {
                    name := left
                    displacement := constant[1]
                }
                else {
                    if operation = 43 {
                        constant := compileTimeIntegerValue(source, pool, left, 0)
                        if right >= 0 && ast.read(pool, right, 0) = ast.nameKind() && constant[0] = 1 {
                            name := right
                            displacement := constant[1]
                        }
                    }
                }
                if operation = 45 { displacement := -displacement }
            }
        }
        if name < 0 || displacement > 268435455 || displacement < -268435455 { return "" }
        var register: int := registerIndexForName(source, pool, functionId, name)
        if register < 0 { return "" }
        var byteDisplacement: int := displacement * width
        if byteDisplacement > 2147483647 || byteDisplacement < -2147483647 { return "" }
        var suffix: string := ""
        if byteDisplacement > 0 { suffix := "+" + token.number(byteDisplacement) }
        if byteDisplacement < 0 { suffix := token.number(byteDisplacement) }
        var scale: string := ""
        if width > 1 { scale := "*" + token.number(width) }
        return "[rbp-" + token.number(arrayOffset) + "+" + registerName(register) + scale + suffix + "]"
    end

    fn arrayCopyWords(source: string, pool: *[12582912]int, functionId: int, sourceId: int, destinationOffset: int, words: int): string
    begin
        var from: string := arrayAddress(source, pool, functionId, sourceId)
        if str.length(from) = 0 || words <= 0 { return "" }
        return from + " sub rsp, 16\n mov qword ptr [rsp], rax\n lea rdi, [rbp-" + token.number(destinationOffset) + "]\n mov rsi, qword ptr [rsp]\n mov rcx, " + token.number(words) + "\n rep movsq\n add rsp, 16\n"
    end

    fn arrayTemporaryWords(source: string, pool: *[12582912]int, functionId: int): int
    begin
        var total: int := 0
        var id: int := functionId
        var finish: int := ast.read(pool, functionId, 11)
        while id < finish {
            if ast.read(pool, id, 9) = functionId {
                if ast.read(pool, id, 0) = ast.callKind() { total := total + ast.read(pool, id, 11) }
                else { if ast.read(pool, id, 0) = ast.sliceKind() { total := total + typeWords(source, arrayType(source, pool, functionId, id)) } }
            }
            id := id + 1
        }
        return total
    end

    fn arrayCallWords(source: string, pool: *[12582912]int, functionId: int, callId: int): int
    begin
        if callId < 0 || ast.read(pool, callId, 0) != ast.callKind() { return 0 }
        var called: int := ast.read(pool, callId, 3)
        if called < 0 { return 0 }
        var name: string := str.slice(source, ast.read(pool, called, 1), ast.read(pool, called, 2))
        var cachedTarget: int := ast.read(pool, called, 11)
        var result: string := ""
        if cachedTarget > 0 { result := functionResultTypeAt(source, pool, cachedTarget - 1) }
        else { result := functionResultType(source, pool, functionId, name) }
        if str.length(result) > 0 && (str.char(result, 0) = 91 || recordWordCount(source, result) > 0) { return typeWords(source, result) }
        return 0
    end

    fn arrayTemporaryOffset(source: string, pool: *[12582912]int, functionId: int, wanted: int): int
    begin
        var parameters: int := parameterCount(source, pool, functionId)
        var hidden: int := 0
        var resultType: string := functionResultTypeAt(source, pool, functionId)
        if indirectResult(source, resultType) = 1 { hidden := 1 }
        var offset: int := (parameters + hidden + integerLocalCount(source, pool, functionId)) * 8
        var id: int := functionId
        while id <= wanted {
            if ast.read(pool, id, 9) = functionId {
                var words: int := 0
                if ast.read(pool, id, 0) = ast.callKind() { words := ast.read(pool, id, 11) }
                else { if ast.read(pool, id, 0) = ast.sliceKind() { words := typeWords(source, arrayType(source, pool, functionId, id)) } }
                if words > 0 {
                    offset := offset + words * 8
                    if id = wanted { return offset }
                }
            }
            id := id + 1
        }
        return -1
    end

    fn registerName(index: int): string
    begin
        if index = 0 { return "rbx" }
        if index = 1 { return "r12" }
        if index = 2 { return "r13" }
        if index = 3 { return "r14" }
        if index = 4 { return "r15" }
        return ""
    end

    fn saveRegisters(source: string, pool: *[12582912]int, functionId: int): string
    begin
        var output: string := str.builder("")
        var count: int := optimizer.registerCount(source, ast.read(pool, functionId, 7), ast.read(pool, functionId, 8))
        var hidden: int := 0
        var resultType: string := functionResultTypeAt(source, pool, functionId)
        if indirectResult(source, resultType) = 1 { hidden := 1 }
        var offset: int := (parameterCount(source, pool, functionId) + hidden + integerLocalCount(source, pool, functionId) + arrayTemporaryWords(source, pool, functionId) + 2) * 8
        var index: int := 0
        while index < count {
            output := str.append(output, " mov qword ptr [rbp-" + token.number(offset + index * 8) + "], " + registerName(index) + "\n")
            index := index + 1
        }
        return output
    end

    fn restoreRegisters(source: string, pool: *[12582912]int, functionId: int): string
    begin
        var output: string := str.builder("")
        var count: int := optimizer.registerCount(source, ast.read(pool, functionId, 7), ast.read(pool, functionId, 8))
        var hidden: int := 0
        var resultType: string := functionResultTypeAt(source, pool, functionId)
        if indirectResult(source, resultType) = 1 { hidden := 1 }
        var offset: int := (parameterCount(source, pool, functionId) + hidden + integerLocalCount(source, pool, functionId) + arrayTemporaryWords(source, pool, functionId) + 2) * 8
        var index: int := 0
        while index < count {
            output := str.append(output, " mov " + registerName(index) + ", qword ptr [rbp-" + token.number(offset + index * 8) + "]\n")
            index := index + 1
        }
        return output
    end

    fn gcDepth(source: string, pool: *[12582912]int, functionId: int, before: int): int
    begin
        var depth: int := 0
        var position: int := ast.read(pool, functionId, 7)
        var line: int := 1
        while position < before {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() || item[1] >= before { position := before }
            else {
                if item[0] = token.nameKind() && str.slice(source, item[1], item[2]) = "gc" {
                    var dot: [4]int := parser.significant(source, item[2], item[3])
                    var mode: [4]int := parser.significant(source, dot[2], dot[3])
                    if dot[0] = 46 && str.slice(source, mode[1], mode[2]) = "begin" { depth := depth + 1 }
                    if dot[0] = 46 && str.slice(source, mode[1], mode[2]) = "end" && depth > 0 { depth := depth - 1 }
                }
                position := item[2]
                line := item[3]
            }
        }
        return depth
    end

    fn gcExitCode(source: string, pool: *[12582912]int, functionId: int, before: int): string
    begin
        var output: string := str.builder("")
        var depth: int := gcDepth(source, pool, functionId, before)
        while depth > 0 {
            output := str.append(output, " call " + runtime.gcPopName() + "\n")
            depth := depth - 1
        }
        return output
    end

    fn findFrom(source: string, wanted: string, start: int): int
    begin
        var sourceLength: int := str.length(source)
        var wantedLength: int := str.length(wanted)
        var position: int := start
        if position < 0 { position := 0 }
        while position + wantedLength <= sourceLength {
            var matched: int := 0
            while matched < wantedLength && str.char(source, position + matched) = str.char(wanted, matched) {
                matched := matched + 1
            }
            if matched = wantedLength { return position }
            position := position + 1
        }
        return -1
    end

    fn resolveAliasType(source: string, value: string, depth: int, scope: string): string
    begin
        if depth > 16 || str.length(value) = 0 { return "" }
        if value = "int" || value = "flt" || value = "string" || value = "str" || value = "void" { return value }
        if str.char(value, 0) = 42 {
            var target: string := resolveAliasType(source, str.slice(value, 1, str.length(value)), depth + 1, scope)
            if str.length(target) = 0 { return "" }
            return "*" + target
        }
        if str.char(value, 0) = 91 {
            var closing: int := str.find(value, "]")
            if closing < 0 { return "" }
            var element: string := resolveAliasType(source, str.slice(value, closing + 1, str.length(value)), depth + 1, scope)
            if str.length(element) = 0 { return "" }
            return str.slice(value, 0, closing + 1) + element
        }
        var aliasName: string := value
        var desiredScope: string := scope
        var dot: int := -1
        var dotIndex: int := 0
        while dotIndex < str.length(value) {
            if str.char(value, dotIndex) = 46 { dot := dotIndex }
            dotIndex := dotIndex + 1
        }
        if dot >= 0 {
            desiredScope := str.slice(value, 0, dot)
            aliasName := str.slice(value, dot + 1, str.length(value))
        }
        var position: int := 0
        var line: int := 1
        var foundScoped: string := ""
        var foundGlobal: string := ""
        var exactPattern: string := "type " + aliasName + ":"
        var exactSearch: int := 0
        if findFrom(source, exactPattern, 0) >= 0 { exactSearch := 1 }
        while position <= str.length(source) {
            var item: [4]int
            if exactSearch = 1 {
                var match: int := findFrom(source, exactPattern, position)
                if match < 0 { position := str.length(source) + 1 }
                else {
                    position := match
                    item := lexer.scan(source, position, line)
                }
            }
            else { item := lexer.scan(source, position, line) }
            if position > str.length(source) { }
            else {
            if item[0] = token.endKind() { position := str.length(source) + 1 }
            else {
                if item[0] = token.nameKind() && str.slice(source, item[1], item[2]) = "type" {
                    var alias: [4]int := lexer.scan(source, item[2], item[3])
                    var colon: [4]int := lexer.scan(source, alias[2], alias[3])
                    var aliasScope: string := ""
                    var aliasMatches: int := 0
                    if alias[0] = token.nameKind() && colon[0] = 58 && str.slice(source, alias[1], alias[2]) = aliasName { aliasMatches := 1 }
                    if aliasMatches = 1 { aliasScope := moduleAt(source, item[1]) }
                    if alias[0] = token.nameKind() && colon[0] = 58 && str.slice(source, alias[1], alias[2]) = aliasName && (aliasScope = desiredScope || str.length(aliasScope) = 0) {
                        var marker: [4]int := lexer.scan(source, colon[2], colon[3])
                        var resolved: string := ""
                        if str.slice(source, marker[1], marker[2]) = "record" {
                            resolved := aliasName
                            if str.length(aliasScope) > 0 { resolved := aliasScope + "." + aliasName }
                        }
                        else {
                            var start: int := colon[2]
                            var finish: [4]int := lexer.scan(source, start, colon[3])
                            while finish[0] != 10 && finish[0] != token.endKind() { finish := lexer.scan(source, finish[2], finish[3]) }
                            var raw: string := str.builder("")
                            var offset: int := start
                            while offset < finish[1] {
                                var character: int := str.char(source, offset)
                                if character > 32 { raw := str.append(raw, token.character(character)) }
                                offset := offset + 1
                            }
                            resolved := resolveAliasType(source, raw, depth + 1, aliasScope)
                        }
                        if str.length(resolved) = 0 { return "" }
                        if aliasScope = desiredScope && str.length(desiredScope) > 0 {
                            if str.length(foundScoped) > 0 && foundScoped != resolved { return "" }
                            foundScoped := resolved
                        }
                        else {
                            if str.length(aliasScope) = 0 {
                                if str.length(foundGlobal) > 0 && foundGlobal != resolved { return "" }
                                foundGlobal := resolved
                            }
                        }
                    }
                }
                position := item[2]
                line := item[3]
            }
            }
        }
        if str.length(foundScoped) > 0 { return foundScoped }
        return foundGlobal
    end

    fn typeText(source: string, start: int, finish: int, line: int): string
    begin
        var value: string := str.builder("")
        var position: int := start
        while position < finish {
            var character: int := str.char(source, position)
            if character > 32 { value := str.append(value, token.character(character)) }
            position := position + 1
        }
        if primitiveType(value) = 1 { return value }
        return cachedAliasType(source, value, moduleAt(source, start))
    end

    fn typeTextForFunction(source: string, pool: *[12582912]int, functionId: int, start: int, finish: int, line: int): string
    begin
        var module: string := functionModule(source, pool, functionId)
        if str.length(module) > 0 { module := str.slice(module, 0, str.length(module) - 1) }
        return typeTextInModule(source, start, finish, line, module)
    end

    fn typeTextInModule(source: string, start: int, finish: int, line: int, module: string): string
    begin
        var value: string := str.builder("")
        var position: int := start
        while position < finish {
            var character: int := str.char(source, position)
            if character > 32 {
                value := str.append(value, token.character(character))
            }
            position := position + 1
        }
        return cachedAliasType(source, value, module)
    end

    fn primitiveType(value: string): int
    begin
        var index: int := 0
        var size: int := str.length(value)
        while index < size && str.char(value, index) = 42 { index := index + 1 }
        while index < size && str.char(value, index) = 91 {
            var closing: int := index + 1
            while closing < size && str.char(value, closing) != 93 { closing := closing + 1 }
            index := closing + 1
            while index < size && str.char(value, index) = 42 { index := index + 1 }
        }
        var base: string := str.slice(value, index, size)
        if base = "int" || base = "flt" || base = "string" || base = "str" || base = "void" { return 1 }
        return 0
    end

    fn cachedAliasType(source: string, value: string, module: string): string
    begin
        if primitiveType(value) = 1 { return value }
        var key: string := "A" + module + "|" + value
        if memo.has(key) = 1 { return memo.get(key) }
        return memo.put(key, resolveAliasType(source, value, 0, module))
    end

    fn localType(source: string, pool: *[12582912]int, functionId: int, wanted: string, before: int): string
    begin
        var resolvedDeclaration: int := localDeclaration(source, pool, functionId, wanted, before)
        var functionName: string := str.slice(source, ast.read(pool, functionId, 3), ast.read(pool, functionId, 4))
        if functionName != "main" && resolvedDeclaration < 0 {
            var opening: [4]int := parser.significant(source, ast.read(pool, functionId, 4), 1)
            var parameter: [4]int := parser.significant(source, opening[2], opening[3])
            while parameter[0] != 41 && parameter[0] != token.endKind() {
                var colon: [4]int := parser.significant(source, parameter[2], parameter[3])
                var typeStart: [4]int := parser.significant(source, colon[2], colon[3])
                var typeFinish: [4]int := typeStart
                while typeFinish[0] != 44 && typeFinish[0] != 41 && typeFinish[0] != token.endKind() {
                    typeFinish := parser.significant(source, typeFinish[2], typeFinish[3])
                }
                if str.slice(source, parameter[1], parameter[2]) = wanted { return typeTextForFunction(source, pool, functionId, typeStart[1], typeFinish[1], typeStart[3]) }
                parameter := typeFinish
                if parameter[0] = 44 { parameter := parser.significant(source, parameter[2], parameter[3]) }
            }
        }
        if resolvedDeclaration < 0 { return "" }
        var position: int := ast.read(pool, functionId, 7)
        var finish: int := ast.read(pool, functionId, 8)
        var line: int := 1
        while position < finish && position < before {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() || item[1] >= finish { position := finish }
            else {
                if item[0] = token.nameKind() && str.slice(source, item[1], item[2]) = "var" {
                    var name: [4]int := parser.significant(source, item[2], item[3])
                    var colon: [4]int := parser.significant(source, name[2], name[3])
                    var type: [4]int := parser.significant(source, colon[2], colon[3])
                    if name[0] = token.nameKind() && colon[0] = 58 && name[1] = resolvedDeclaration {
                        var typeFinish: [4]int := type
                    while typeFinish[0] != token.assignKind() && typeFinish[0] != 10 && typeFinish[0] != token.endKind() && typeFinish[1] < finish {
                            typeFinish := lexer.scan(source, typeFinish[2], typeFinish[3])
                        }
                        return typeTextForFunction(source, pool, functionId, type[1], typeFinish[1], type[3])
                    }
                }
                position := item[2]
                line := item[3]
            }
        }
        return ""
    end

    fn recordPathType(source: string, initialType: string, path: string): string
    begin
        var type: string := initialType
        var rest: string := path
        while str.length(rest) > 0 {
            var dot: int := str.find(rest, ".")
            var field: string := rest
            if dot >= 0 { field := str.slice(rest, 0, dot) }
            if str.length(type) > 1 && str.char(type, 0) = 42 { type := str.slice(type, 1, str.length(type)) }
            type := recordFieldType(source, type, field)
            if str.length(type) = 0 { return "" }
            if dot < 0 { rest := "" }
            else { rest := str.slice(rest, dot + 1, str.length(rest)) }
        }
        return type
    end

    fn recordPathOffset(source: string, initialType: string, path: string): int
    begin
        var type: string := initialType
        var rest: string := path
        var offset: int := 0
        while str.length(rest) > 0 {
            var dot: int := str.find(rest, ".")
            var field: string := rest
            if dot >= 0 { field := str.slice(rest, 0, dot) }
            var fieldOffset: int := recordFieldOffset(source, type, field)
            if fieldOffset < 0 { return -1 }
            offset := offset + fieldOffset
            type := recordFieldType(source, type, field)
            if str.length(type) = 0 { return -1 }
            if dot < 0 { rest := "" }
            else { rest := str.slice(rest, dot + 1, str.length(rest)) }
        }
        return offset
    end

    // Emits code that turns the address in rax into the address of a dotted field path.
    // Pointer-typed fields along the path are dereferenced automatically.
    fn recordPathAddress(source: string, address: string, initialType: string, path: string): string
    begin
        var type: string := initialType
        var rest: string := path
        var code: string := str.builder(address)
        while str.length(rest) > 0 {
            var dot: int := str.find(rest, ".")
            var field: string := rest
            if dot >= 0 { field := str.slice(rest, 0, dot) }
            if str.length(type) > 1 && str.char(type, 0) = 42 {
                code := str.append(code, " mov rax, qword ptr [rax]\n")
                type := str.slice(type, 1, str.length(type))
            }
            var fieldOffset: int := recordFieldOffset(source, type, field)
            if fieldOffset < 0 { return "" }
            if fieldOffset > 0 { code := str.append(code, " add rax, " + token.number(fieldOffset) + "\n") }
            type := recordFieldType(source, type, field)
            if str.length(type) = 0 { return "" }
            if dot < 0 { rest := "" }
            else { rest := str.slice(rest, dot + 1, str.length(rest)) }
        }
        return code
    end

    fn boundLocalType(source: string, pool: *[12582912]int, functionId: int, nameId: int): string
    begin
        if nameId < 0 || ast.read(pool, nameId, 0) != ast.nameKind() { return "" }
        var binding: int := ast.read(pool, nameId, 11)
        var path: string := ""
        var dot: int := str.find(str.slice(source, ast.read(pool, nameId, 1), ast.read(pool, nameId, 2)), ".")
        if dot >= 0 { path := str.slice(source, ast.read(pool, nameId, 1) + dot + 1, ast.read(pool, nameId, 2)) }
        if binding >= 0 {
            var baseType: string := typeTextForFunction(source, pool, functionId, ast.read(pool, binding, 7), ast.read(pool, binding, 8), 1)
            if str.length(path) > 0 { return recordPathType(source, baseType, path) }
            return baseType
        }
        if binding <= -2 {
            var parameterType: string := functionParameterType(source, pool, functionId, "", -2 - binding)
            if str.length(path) > 0 { return recordPathType(source, parameterType, path) }
            return parameterType
        }
        return ""
    end

    fn boundLocalOffset(source: string, pool: *[12582912]int, functionId: int, nameId: int): int
    begin
        if nameId < 0 || ast.read(pool, nameId, 0) != ast.nameKind() { return -1 }
        var binding: int := ast.read(pool, nameId, 11)
        var path: string := ""
        var dot: int := str.find(str.slice(source, ast.read(pool, nameId, 1), ast.read(pool, nameId, 2)), ".")
        if dot >= 0 { path := str.slice(source, ast.read(pool, nameId, 1) + dot + 1, ast.read(pool, nameId, 2)) }
        if binding >= 0 {
            var fieldOffset: int := recordPathOffset(source, typeTextForFunction(source, pool, functionId, ast.read(pool, binding, 7), ast.read(pool, binding, 8), 1), path)
            if fieldOffset < 0 {
                if str.length(path) > 0 { return -1 }
                fieldOffset := 0
            }
            return ast.read(pool, binding, 11) - fieldOffset
        }
        if binding <= -2 {
            var functionName: string := str.slice(source, ast.read(pool, functionId, 3), ast.read(pool, functionId, 4))
            var resultType: string := functionResultTypeAt(source, pool, functionId)
            var hidden: int := 0
            if indirectResult(source, resultType) = 1 { hidden := 1 }
            var offset: int := (-2 - binding + hidden + 1) * 8
            var parameterType: string := functionParameterType(source, pool, functionId, "", -2 - binding)
            var fieldOffset: int := recordPathOffset(source, parameterType, path)
            if fieldOffset < 0 && str.length(path) > 0 { return -1 }
            if fieldOffset > 0 { offset := offset + fieldOffset }
            return offset
        }
        return -1
    end

    fn registerIndexForName(source: string, pool: *[12582912]int, functionId: int, nameId: int): int
    begin
        if nameId < 0 || ast.read(pool, nameId, 0) != ast.nameKind() { return -1 }
        var cached: int := ast.read(pool, nameId, 10)
        if cached != 0 { return cached - 2 }
        var name: string := str.slice(source, ast.read(pool, nameId, 1), ast.read(pool, nameId, 2))
        var before: int := ast.read(pool, nameId, 1)
        var binding: int := ast.read(pool, nameId, 11)
        if binding >= 0 { before := ast.read(pool, binding, 3) }
        var result: int := 0
        if binding >= 0 {
            // Every use of one declaration shares the same answer.
            var key: string := "reg:" + str.number(ast.read(pool, functionId, 7)) + ":" + str.number(before) + ":" + name
            if memo.has(key) = 1 { result := memo.number(memo.get(key)) }
            else { result := memo.putNumber(key, optimizer.registerIndex(source, ast.read(pool, functionId, 7), ast.read(pool, functionId, 8), name, before)) }
        }
        else { result := optimizer.registerIndex(source, ast.read(pool, functionId, 7), ast.read(pool, functionId, 8), name, before) }
        ast.write(pool, nameId, 10, result + 2)
        return result
    end

    fn floatExpression(source: string, pool: *[12582912]int, functionId: int, id: int): string
    begin
        if id < 0 { return "" }
        var kind: int := ast.read(pool, id, 0)
        if (kind = ast.binaryKind() || kind = ast.callKind() || kind = ast.indexKind() || kind = ast.unaryKind()) && expressionType(source, pool, functionId, id) = "int" {
            var integral: string := integerExpression(source, pool, functionId, id)
            if str.length(integral) > 0 { return integral + " cvtsi2sd xmm0, rax\n" }
        }
        if kind = ast.literalKind() {
            if ast.read(pool, id, 10) != token.numberKind() { return "" }
            var value: string := str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2))
            if str.find(value, ".") >= 0 {
                return " movsd xmm0, qword ptr [rip+.Lflt" + token.number(ast.read(pool, id, 1)) + "]\n"
            }
            return " mov rax, " + value + "\n cvtsi2sd xmm0, rax\n"
        }
        if kind = ast.nameKind() {
            var name: string := str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2))
            var offset: int := boundLocalOffset(source, pool, functionId, id)
            var type: string := boundLocalType(source, pool, functionId, id)
            var fieldAddress: string := qualifiedFieldAddress(source, pool, functionId, id)
            if (offset < 0 && str.length(fieldAddress) = 0) || (type != "int" && type != "flt") { return "" }
            if str.length(fieldAddress) > 0 {
                if type = "flt" { return fieldAddress + " movsd xmm0, qword ptr [rax]\n" }
                return fieldAddress + " mov rax, qword ptr [rax]\n cvtsi2sd xmm0, rax\n"
            }
            if type = "flt" { return " movsd xmm0, qword ptr [rbp-" + token.number(offset) + "]\n" }
            var register: int := registerIndexForName(source, pool, functionId, id)
            if register >= 0 { return " mov rax, " + registerName(register) + "\n cvtsi2sd xmm0, rax\n" }
            return " mov rax, qword ptr [rbp-" + token.number(offset) + "]\n cvtsi2sd xmm0, rax\n"
        }
        if kind = ast.unaryKind() && ast.read(pool, id, 10) = 45 {
            var operand: string := floatExpression(source, pool, functionId, ast.read(pool, id, 3))
            if str.length(operand) = 0 { return "" }
            return operand + " mov rax, -9223372036854775808\n movq xmm1, rax\n xorpd xmm0, xmm1\n"
        }
        if kind = ast.unaryKind() && ast.read(pool, id, 10) = 42 {
            var pointer: string := integerExpression(source, pool, functionId, ast.read(pool, id, 3))
            if str.length(pointer) = 0 { return "" }
            return pointer + " movsd xmm0, qword ptr [rax]\n"
        }
        if kind = ast.indexKind() && expressionType(source, pool, functionId, id) = "flt" {
            var address: string := arrayElementAddress(source, pool, functionId, id)
            if str.length(address) = 0 { return "" }
            return address + " movsd xmm0, qword ptr [rax]\n"
        }
        if kind = ast.memberKind() && expressionType(source, pool, functionId, id) = "flt" {
            var address: string := memberAddress(source, pool, functionId, id)
            if str.length(address) = 0 { return "" }
            return address + " movsd xmm0, qword ptr [rax]\n"
        }
        if kind = ast.callKind() {
            var output: string := callCode(source, pool, functionId, id)
            var called: int := ast.read(pool, id, 3)
            if called < 0 { return "" }
            var name: string := str.slice(source, ast.read(pool, called, 1), ast.read(pool, called, 2))
            var cachedTarget: int := ast.read(pool, called, 11)
            var resultType: string := ""
            if cachedTarget > 0 { resultType := functionResultTypeAt(source, pool, cachedTarget - 1) }
            else { resultType := functionResultType(source, pool, functionId, name) }
            if resultType = "flt" { return output }
            if str.length(output) = 0 { return "" }
            return output + " cvtsi2sd xmm0, rax\n"
        }
        if kind = ast.binaryKind() {
            var operation: int := ast.read(pool, id, 10)
            var left: string := floatExpression(source, pool, functionId, ast.read(pool, id, 3))
            var right: string := floatExpression(source, pool, functionId, ast.read(pool, id, 4))
            if str.length(left) = 0 || str.length(right) = 0 { return "" }
            var code: string := left + " sub rsp, 16\n movsd qword ptr [rsp], xmm0\n" + right + " movapd xmm1, xmm0\n movsd xmm0, qword ptr [rsp]\n add rsp, 16\n"
            if operation = 43 { return code + " addsd xmm0, xmm1\n" }
            if operation = 45 { return code + " subsd xmm0, xmm1\n" }
            if operation = 42 { return code + " mulsd xmm0, xmm1\n" }
            if operation = 47 { return code + " divsd xmm0, xmm1\n" }
        }
        return ""
    end

    fn functionLabel(name: string): string
    begin
        var result: string := str.builder("xe")
        var index: int := 0
        while index < str.length(name) {
            var value: int := str.char(name, index)
            if value = 46 { result := str.append(result, token.character(46)) }
            else { result := str.append(result, token.character(value)) }
            index := index + 1
        }
        return result
    end

    fn simpleName(name: string): string
    begin
        var position: int := 0
        var last: int := 0
        while position < str.length(name) {
            if str.char(name, position) = 46 { last := position + 1 }
            position := position + 1
        }
        return str.slice(name, last, str.length(name))
    end

    fn moduleTable(source: string): string
    begin
        if memo.has("#modules") = 1 { return memo.get("#modules") }
        var table: string := str.builder("")
        var pending: string := ""
        var current: string := ""
        var currentBegin: int := -1
        var moduleDepth: int := -1
        var depth: int := 0
        var position: int := 0
        var line: int := 1
        var size: int := str.length(source)
        while position < size {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() { position := size }
            else {
                if item[0] = token.nameKind() {
                    var word: string := str.slice(source, item[1], item[2])
                    if word = "module" && depth = 0 {
                        var name: [4]int := parser.significant(source, item[2], item[3])
                        pending := str.slice(source, name[1], name[2])
                    }
                    else {
                        if word = "begin" {
                            depth := depth + 1
                            if str.length(pending) > 0 {
                                current := pending
                                currentBegin := item[1]
                                pending := ""
                                moduleDepth := depth
                            }
                        }
                        else {
                            if word = "end" {
                                if depth = moduleDepth {
                                    table := str.append(table, current + "," + str.number(currentBegin) + "," + str.number(item[1]) + ";")
                                    current := ""
                                    moduleDepth := -1
                                }
                                if depth > 0 { depth := depth - 1 }
                            }
                        }
                    }
                }
                position := item[2]
                line := item[3]
            }
        }
        if moduleDepth >= 0 { table := str.append(table, current + "," + str.number(currentBegin) + "," + str.number(size + 1) + ";") }
        return memo.put("#modules", table)
    end

    fn moduleAt(source: string, finish: int): string
    begin
        var table: string := moduleTable(source)
        var index: int := 0
        var size: int := str.length(table)
        while index < size {
            var nameEnd: int := index
            while str.char(table, nameEnd) != 44 { nameEnd := nameEnd + 1 }
            var startEnd: int := nameEnd + 1
            var first: int := 0
            while str.char(table, startEnd) != 44 {
                first := first * 10 + str.char(table, startEnd) - 48
                startEnd := startEnd + 1
            }
            var stopEnd: int := startEnd + 1
            var last: int := 0
            while str.char(table, stopEnd) != 59 {
                last := last * 10 + str.char(table, stopEnd) - 48
                stopEnd := stopEnd + 1
            }
            if first < finish && finish <= last { return str.slice(table, index, nameEnd) }
            index := stopEnd + 1
        }
        return ""
    end

    fn moduleAtSlow(source: string, finish: int): string
    begin
        var module: string := ""
        var pending: string := ""
        var moduleDepth: int := -1
        var depth: int := 0
        var position: int := 0
        var line: int := 1
        while position < finish {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() || item[1] >= finish { position := finish }
            else {
                if item[0] = token.nameKind() {
                    var word: string := str.slice(source, item[1], item[2])
                    if word = "module" && depth = 0 {
                        var name: [4]int := parser.significant(source, item[2], item[3])
                        pending := str.slice(source, name[1], name[2])
                    }
                    else {
                        if word = "begin" {
                            depth := depth + 1
                            if str.length(pending) > 0 {
                                module := pending
                                pending := ""
                                moduleDepth := depth
                            }
                        }
                        else {
                            if word = "end" {
                                if depth = moduleDepth {
                                    module := ""
                                    moduleDepth := -1
                                }
                                if depth > 0 { depth := depth - 1 }
                            }
                        }
                    }
                }
                position := item[2]
                line := item[3]
            }
        }
        return module
    end

    fn functionModule(source: string, pool: *[12582912]int, functionId: int): string
    begin
        var start: int := ast.read(pool, functionId, 9)
        if start < 0 { return "" }
        var keyword: [4]int := lexer.scan(source, start, 1)
        var name: [4]int := parser.significant(source, keyword[2], keyword[3])
        var finish: int := name[2]
        var path: [4]int := parser.significant(source, finish, name[3])
        while path[0] = 46 {
            var part: [4]int := parser.significant(source, path[2], path[3])
            finish := part[2]
            path := parser.significant(source, finish, part[3])
        }
        return str.slice(source, name[1], finish) + "."
    end

    fn qualifiedFunctionName(source: string, pool: *[12582912]int, functionId: int): string
    begin
        var name: string := str.slice(source, ast.read(pool, functionId, 3), ast.read(pool, functionId, 4))
        var module: string := functionModule(source, pool, functionId)
        if str.length(module) > 0 { return module + name }
        return name
    end

    fn integerArgumentRegister(index: int): string
    begin
        if index = 0 { return "rdi" }
        if index = 1 { return "rsi" }
        if index = 2 { return "rdx" }
