    fn expressionType(source: string, pool: *[12582912]int, functionId: int, id: int): string
    begin
        if id < 0 { return "" }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.literalKind() {
            if ast.read(pool, id, 10) = token.stringKind() { return "string" }
            if ast.read(pool, id, 10) = token.numberKind() {
                if str.find(str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2)), ".") >= 0 { return "flt" }
                return "int"
            }
        }
        if kind = ast.nameKind() {
            var name: string := str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2))
            if name = "true" || name = "false" { return "int" }
