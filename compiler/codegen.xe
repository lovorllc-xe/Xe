        if index = 3 { return "xmm3" }
        if index = 4 { return "xmm4" }
        if index = 5 { return "xmm5" }
        if index = 6 { return "xmm6" }
        if index = 7 { return "xmm7" }
        return ""
    end

    fn functionStart(source: string, wanted: string): int
    begin
        var position: int := 0
        var target: string := simpleName(wanted)
        if str.find(wanted, ".") >= 0 { target := wanted }
        var search: string := "fn " + wanted
        while position < str.length(source) {
            var found: int := str.find(str.slice(source, position, str.length(source)), search)
            if found < 0 && str.find(wanted, ".") < 0 && search != "fn " + target {
                search := "fn " + target
                found := str.find(str.slice(source, position, str.length(source)), search)
            }
            if found < 0 { return -1 }
            found := found + position
            var item: [4]int := lexer.scan(source, found, 1)
            if item[0] = token.nameKind() && str.slice(source, item[1], item[2]) = "fn" {
                var name: [4]int := parser.significant(source, item[2], item[3])
                var finish: int := name[2]
                var finalName: [4]int := name
                var path: [4]int := parser.significant(source, finish, name[3])
                while path[0] = 46 {
                    var part: [4]int := parser.significant(source, path[2], path[3])
                    finish := part[2]
                    finalName := part
                    path := parser.significant(source, finish, part[3])
                }
                if str.slice(source, finalName[1], finalName[2]) = target { return finish }
            }
            position := found + 3
        }
        return -1
    end

    fn functionResultTypeAt(source: string, pool: *[12582912]int, target: int): string
