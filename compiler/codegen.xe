        }
        if name = "runtime.pointer.read" { return output + " mov rax, qword ptr [rdi]\n add rsp, " + token.number(stackBytes + padding + count * 16) + "\n" }
        if name = "runtime.pointer.write" { return output + " mov qword ptr [rdi], rsi\n xor eax, eax\n add rsp, " + token.number(stackBytes + padding + count * 16) + "\n" }
        if name = "runtime.pointer.cast.string" { return output + " mov rax, rdi\n add rsp, " + token.number(stackBytes + padding + count * 16) + "\n" }
        if name = "runtime.pointer.free" { return output + " call xe.free\n xor eax, eax\n add rsp, " + token.number(stackBytes + padding + count * 16) + "\n" }
