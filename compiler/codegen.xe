    fn functionCallResultForValue(source: string, pool: *[12582912]int, functionId: int, id: int): string
    begin
        if id < 0 || ast.read(pool, id, 0) != ast.callKind() { return "" }
        var called: int := ast.read(pool, id, 3)
        if called < 0 { return "" }
        var name: string := str.slice(source, ast.read(pool, called, 1), ast.read(pool, called, 2))
        var cachedTarget: int := ast.read(pool, called, 11)
        if cachedTarget > 0 { return functionResultTypeAt(source, pool, cachedTarget - 1) }
        return functionResultType(source, pool, functionId, name)
    end

    fn argumentTypeMatches(expected: string, actual: string): int
    begin
        if expected = "numeric" { return actual = "int" || actual = "flt" }
        if expected = "str" { expected := "string" }
        if actual = "str" { actual := "string" }
        if str.length(actual) = 0 { return 0 }
        if expected = actual { return 1 }
        if expected = "*void" && str.length(actual) > 0 && str.char(actual, 0) = 42 { return 1 }
        if str.length(expected) > 0 && str.char(expected, 0) = 42 && actual = "*void" { return 1 }
        if str.length(expected) > 0 && str.char(expected, 0) = 42 && actual = "*" { return 1 }
        return 0
    end

    fn nullPointerArgument(source: string, pool: *[12582912]int, expression: int): int
    begin
        if expression < 0 { return 0 }
        if ast.read(pool, expression, 0) = ast.literalKind() && ast.read(pool, expression, 10) = token.numberKind() && str.slice(source, ast.read(pool, expression, 1), ast.read(pool, expression, 2)) = "0" { return 1 }
        return 0
    end

    fn builtinParameterCount(name: string): int
    begin
        if name = "atomic.load" { return 1 }
        if name = "atomic.store" { return 2 }
        if name = "atomic.compare_exchange" { return 3 }
        if name = "flt.format" { return 2 }
        if name = "flt.toint" { return 1 }
        if name = "runtime.pointer.read" || name = "runtime.pointer.cast.string" || name = "runtime.pointer.free" || name = "runtime.pointer.is_null" || name = "alloc" || name = "new" || name = "free" || name = "delete" { return 1 }
        if name = "runtime.pointer.write" { return 2 }
        if name = "aligned_alloc" || name = "alloc.aligned" { return 2 }
        if name = "syscall.invoke3" { return 4 }
        if name = "syscall.invoke6" { return 7 }
        if name = "runtime.mem.copy" || name = "runtime.mem.set" || name = "runtime.mem.compare" { return 3 }
        if name = "runtime.hw.read8" || name = "runtime.hw.read32" { return 1 }
        if name = "runtime.hw.write8" || name = "runtime.hw.write32" { return 2 }
        if name = "arg.count" || name = "runtime.globals" || name = "runtime.gc.collect" { return 0 }
        if name = "runtime.gc.enable" || name = "runtime.gc.stats" { return 1 }
        if name = "str.builder" || name = "str.length" || name = "str.number" || name = "str.fromchar" || name = "arg.get" || name = "env.get" || name = "file.read" || name = "process.run" || name = "process.spawn" || name = "process.wait" || name = "thread.join" { return 1 }
        if name = "thread.start" { return 2 }
        if name = "str.append" || name = "str.char" || name = "str.find" || name = "str.equal" || name = "file.write" { return 2 }
        if name = "str.slice" { return 3 }
        return -1
    end

    fn builtinParameterType(name: string, index: int): string
    begin
        if name = "atomic.load" && index = 0 { return "*void" }
        if name = "atomic.store" && index = 0 { return "*void" }
        if name = "atomic.store" && index = 1 { return "int" }
        if name = "atomic.compare_exchange" && index = 0 { return "*void" }
        if name = "atomic.compare_exchange" && (index = 1 || index = 2) { return "int" }
        if name = "flt.format" && index = 0 { return "numeric" }
        if name = "flt.format" && index = 1 { return "int" }
        if name = "flt.toint" && index = 0 { return "flt" }
        if name = "runtime.pointer.is_null" && index = 0 { return "*void" }
        if name = "alloc" || name = "new" || name = "aligned_alloc" || name = "alloc.aligned" { return "int" }
        if (name = "runtime.pointer.read" || name = "runtime.pointer.cast.string" || name = "runtime.pointer.free") && index = 0 { return "*void" }
        if name = "runtime.pointer.write" && (index = 0 || index = 1) { return "*void" }
        if name = "syscall.invoke3" || name = "syscall.invoke6" { return "int" }
        if name = "runtime.mem.copy" && (index = 0 || index = 1) { return "*void" }
        if name = "runtime.mem.copy" && index = 2 { return "int" }
        if name = "runtime.mem.set" && index = 0 { return "*void" }
        if name = "runtime.mem.set" && (index = 1 || index = 2) { return "int" }
        if name = "runtime.mem.compare" && (index = 0 || index = 1) { return "*void" }
        if name = "runtime.mem.compare" && index = 2 { return "int" }
        if (name = "runtime.hw.read8" || name = "runtime.hw.read32" || name = "runtime.hw.write8" || name = "runtime.hw.write32") && index = 0 { return "*void" }
        if (name = "runtime.hw.write8" || name = "runtime.hw.write32") && index = 1 { return "int" }
        if (name = "runtime.gc.enable" || name = "runtime.gc.stats") && index = 0 { return "int" }
        if name = "str.builder" && index = 0 { return "string" }
        if name = "str.append" { return "string" }
        if name = "str.length" && index = 0 { return "string" }
        if name = "str.slice" && index = 0 { return "string" }
        if name = "str.slice" && (index = 1 || index = 2) { return "int" }
        if name = "str.char" && index = 0 { return "string" }
        if name = "str.char" && index = 1 { return "int" }
        if (name = "str.find" || name = "str.equal") { return "string" }
        if (name = "str.number" || name = "str.fromchar" || name = "arg.get") && index = 0 { return "int" }
        if name = "env.get" && index = 0 { return "string" }
        if (name = "process.spawn" || name = "process.run") && index = 0 { return "string" }
        if name = "process.wait" && index = 0 { return "int" }
        if name = "thread.start" && (index = 0 || index = 1) { return "*void" }
        if name = "thread.join" && index = 0 { return "int" }
        if (name = "file.read" || name = "process.run") && index = 0 { return "string" }
        if name = "file.write" { return "string" }
        return ""
    end

    fn memoryFailure(label: string, message: string, id: int): string
    begin
        var messageLabel: string := ".LxeMemoryMessage" + token.number(id)
        var bytes: string := str.builder("")
        var position: int := 0
        while position < str.length(message) {
            if position > 0 { bytes := str.append(bytes, ",") }
            bytes := str.append(bytes, token.number(str.char(message, position)))
            position := position + 1
        }
        return label + ":\n mov eax, 1\n mov edi, 2\n lea rsi, [rip+" + messageLabel + "]\n mov edx, " + token.number(str.length(message)) + "\n syscall\n mov eax, 60\n mov edi, 1\n syscall\n ud2\n.section .rodata\n" + messageLabel + ":\n.byte " + bytes + "\n.section .text\n"
    end

    fn directCallArgument(source: string, pool: *[12582912]int, functionId: int, id: int): int
    begin
        if id < 0 { return 0 }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.literalKind() && ast.read(pool, id, 10) = token.numberKind() {
            if str.find(str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2)), ".") < 0 { return 1 }
            return 0
        }
        if kind = ast.nameKind() {
            var type: string := expressionType(source, pool, functionId, id)
            if type = "int" || (str.length(type) > 0 && str.char(type, 0) = 42) || recordWordCount(source, type) > 0 { return 1 }
            return 0
        }
        if kind = ast.unaryKind() {
            var operation: int := ast.read(pool, id, 10)
            var operand: int := ast.read(pool, id, 3)
            if operation = 38 && operand >= 0 && ast.read(pool, operand, 0) = ast.nameKind() { return 1 }
            if operation = 45 && operand >= 0 && ast.read(pool, operand, 0) = ast.literalKind() && ast.read(pool, operand, 10) = token.numberKind() && str.find(str.slice(source, ast.read(pool, operand, 1), ast.read(pool, operand, 2)), ".") < 0 { return 1 }
        }
        return 0
    end

    fn callCode(source: string, pool: *[12582912]int, functionId: int, id: int): string
