    fn gcLocalInitializers(source: string, pool: *[12582912]int, functionId: int, gcId: int): string
    begin
        var output: string := str.builder("")
        var position: int := ast.read(pool, gcId, 7)
        var finish: int := ast.read(pool, gcId, 8)
        var line: int := 1
        while position < finish {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() || item[1] >= finish { position := finish }
            else {
                if item[0] = token.nameKind() && str.slice(source, item[1], item[2]) = "var" {
                    var name: [4]int := parser.significant(source, item[2], item[3])
                    var colon: [4]int := parser.significant(source, name[2], name[3])
                    var type: [4]int := parser.significant(source, colon[2], colon[3])
                    var equal: [4]int := parser.significant(source, type[2], type[3])
                    var value: [4]int := parser.significant(source, equal[2], equal[3])
                    var typeText: string := str.slice(source, type[1], type[2])
                    var negative: int := 0
                    if value[0] = 45 {
                        negative := 1
                        value := parser.significant(source, value[2], value[3])
                    }
                    if name[0] = token.nameKind() && colon[0] = 58 && equal[0] = token.assignKind() && value[0] = token.numberKind() {
