                        return leftCode + " cmp rax, " + token.number(rightValue[1]) + "\n " + jump + " " + label + "\n"
                    }
                    var rightCode: string := integerExpression(source, pool, functionId, rightId)
                    if str.length(rightCode) = 0 { return "" }
                    var rightSimple: string := simpleOperand(rightCode)
                    if str.length(rightSimple) > 0 { return leftCode + " cmp rax, " + rightSimple + "\n " + jump + " " + label + "\n" }
                    return leftCode + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + rightCode + " mov rcx, rax\n mov rax, qword ptr [rsp]\n add rsp, 16\n cmp rax, rcx\n " + jump + " " + label + "\n"
                }
