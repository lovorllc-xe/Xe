            var operation: int := ast.read(pool, id, 10)
            var operand: int := ast.read(pool, id, 3)
            var type: string := expressionType(source, pool, functionId, operand)
            if operation = 33 && type = "int" { return "int" }
            if operation = 38 {
                if operand >= 0 && ast.read(pool, operand, 0) = ast.nameKind() && functionNode(source, pool, functionId, str.slice(source, ast.read(pool, operand, 1), ast.read(pool, operand, 2))) >= 0 { return "*void" }
                return "*" + type
            }
            if operation = 42 && str.length(type) > 0 && str.char(type, 0) = 42 { return str.slice(type, 1, str.length(type)) }
            if operation = 45 && (type = "int" || type = "flt") { return type }
            if operation = 126 && type = "int" { return "int" }
            if operation = 64 && str.length(type) > 0 && str.char(type, 0) = 42 { return "int" }
            if operation = 35 && (type = "int" || (str.length(type) > 0 && str.char(type, 0) = 42)) { return "int" }
