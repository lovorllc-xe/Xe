                    if operation = 257 { if whenTrue = 1 { jump := "jne" } else { jump := "je" } }
                    if operation = 60 { if whenTrue = 1 { jump := "jl" } else { jump := "jge" } }
                    if operation = 62 { if whenTrue = 1 { jump := "jg" } else { jump := "jle" } }
                    if operation = 258 { if whenTrue = 1 { jump := "jle" } else { jump := "jg" } }
                    if operation = 259 { if whenTrue = 1 { jump := "jge" } else { jump := "jl" } }
