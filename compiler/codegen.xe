        if kind = ast.memberKind() {
            var baseType: string := expressionType(source, pool, functionId, ast.read(pool, id, 3))
            var field: string := str.slice(source, ast.read(pool, id, 7), ast.read(pool, id, 8))
            if str.length(baseType) > 1 && str.char(baseType, 0) = 42 { baseType := str.slice(baseType, 1, str.length(baseType)) }
            return recordFieldType(source, baseType, field)
        }
