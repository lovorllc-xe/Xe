    fn emitBlock(source: string, pool: *[12582912]int, functionId: int, blockId: int): string
    begin
        if blockId < 0 || ast.read(pool, blockId, 0) != ast.blockKind() { return "" }
        var output: string := str.builder("")
        var statement: int := ast.read(pool, blockId, 6)
        var visited: int := 0
        while statement >= 0 && visited < 32768 {
            output := str.append(output, emitStatement(source, pool, functionId, statement))
            statement := ast.read(pool, statement, 5)
            visited := visited + 1
        }
        output := str.append(output, deferredCode(source, pool, functionId, ast.read(pool, blockId, 6), ast.read(pool, blockId, 2)))
        return output
    end

    fn emitStatements(source: string, pool: *[12582912]int, functionId: int, first: int): string
    begin
        var output: string := str.builder("")
        var statement: int := first
        var visited: int := 0
        while statement >= 0 && visited < 32768 {
            output := str.append(output, emitStatement(source, pool, functionId, statement))
            statement := ast.read(pool, statement, 5)
            visited := visited + 1
        }
        return output
    end

    fn branchCondition(source: string, pool: *[12582912]int, functionId: int, expression: int, label: string, whenTrue: int): string
    begin
        if expression < 0 { return "" }
        var kind: int := ast.read(pool, expression, 0)
        if kind = ast.unaryKind() && ast.read(pool, expression, 10) = 33 {
            return branchCondition(source, pool, functionId, ast.read(pool, expression, 3), label, 1 - whenTrue)
        }
        if kind = ast.binaryKind() {
            var operation: int := ast.read(pool, expression, 10)
            var leftId: int := ast.read(pool, expression, 3)
            var rightId: int := ast.read(pool, expression, 4)
            if operation = 260 {
