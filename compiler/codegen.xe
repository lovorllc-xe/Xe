                    var scalarLabel: string := ".LxeMemCompareScalar" + token.number(id)
                    var scalarDifferent: string := ".LxeMemCompareScalarDifferent" + token.number(id)
                    var vectorLabel: string := ".LxeMemCompareVector" + token.number(id)
                    var vectorMismatch: string := ".LxeMemCompareVectorMismatch" + token.number(id)
                    var vectorTail: string := ".LxeMemCompareVectorTail" + token.number(id)
                    var doneLabel: string := ".LxeMemCompareDone" + token.number(id)
                    var sizeFailure: string := ".LxeMemCompareSizeFailure" + token.number(id)
                    var pointerFailure: string := ".LxeMemComparePointerFailure" + token.number(id)
                    output := str.append(output, " test rdx, rdx\n js " + sizeFailure + "\n test rdx, rdx\n jz " + equalLabel + "\n test rdi, rdi\n jz " + pointerFailure + "\n test rsi, rsi\n jz " + pointerFailure + "\n cmp rdx, 64\n jb " + scalarLabel + "\n call xe.cpu.avx2\n test eax, eax\n jz " + scalarLabel + "\n mov r8, rdx\n" + vectorLabel + ":\n cmp r8, 32\n jb " + vectorTail + "\n vmovdqu ymm0, ymmword ptr [rdi]\n vpcmpeqb ymm0, ymm0, ymmword ptr [rsi]\n vpmovmskb eax, ymm0\n cmp eax, -1\n jne " + vectorMismatch + "\n add rdi, 32\n add rsi, 32\n sub r8, 32\n jmp " + vectorLabel + "\n" + vectorTail + ":\n mov rcx, r8\n cld\n repe cmpsb\n jne " + differentLabel + "\n xor eax, eax\n vzeroupper\n jmp " + doneLabel + "\n" + vectorMismatch + ":\n not eax\n bsf ecx, eax\n movzx eax, byte ptr [rdi+rcx]\n movzx ecx, byte ptr [rsi+rcx]\n sub eax, ecx\n movsxd rax, eax\n vzeroupper\n jmp " + doneLabel + "\n" + scalarLabel + ":\n mov rcx, rdx\n cld\n repe cmpsb\n jne " + differentLabel + "\n" + equalLabel + ":\n xor eax, eax\n jmp " + doneLabel + "\n" + differentLabel + ":\n movzx eax, byte ptr [rdi-1]\n movzx ecx, byte ptr [rsi-1]\n sub eax, ecx\n movsxd rax, eax\njmp " + doneLabel + "\n" + memoryFailure(sizeFailure, "memory size cannot be negative\n", id * 2) + memoryFailure(pointerFailure, "memory compare requires non-null pointers\n", id * 2 + 1) + doneLabel + ":\n")
                }
                else {
                    if name = "runtime.hw.read8" { output := str.append(output, " movzx eax, byte ptr [rdi]\n") }
                    else {
                        if name = "runtime.hw.read32" { output := str.append(output, " movsxd rax, dword ptr [rdi]\n") }
                        else {
                            if name = "runtime.hw.write8" { output := str.append(output, " mov byte ptr [rdi], sil\n xor eax, eax\n") }
                            else {
                                if name = "runtime.hw.write32" { output := str.append(output, " mov dword ptr [rdi], esi\n xor eax, eax\n") }
                                else {
        if name = "syscall.invoke3" {
            output := str.append(output, " mov rax, rdi\n mov rdi, rsi\n mov rsi, rdx\n mov rdx, rcx\n syscall\n")
        }
        else {
            if name = "syscall.invoke6" {
                output := str.append(output, " mov rax, rdi\n mov r10, r8\n mov r8, r9\n mov r9, qword ptr [rsp]\n mov rdi, rsi\n mov rsi, rdx\n mov rdx, rcx\n syscall\n")
            }
            else {
                if name = "env.get" { output := str.append(output, " call xeenv.get\n") }
                else {
                    if name = "process.spawn" { output := str.append(output, " call xeprocess.spawn\n") }
                    else {
                        if name = "process.wait" { output := str.append(output, " call xeprocess.wait\n") }
                        else {
                            if name = "thread.start" { output := str.append(output, " call xe.thread.start\n") }
                            else {
                                if name = "thread.join" { output := str.append(output, " call xe.thread.join\n") }
                                else { output := str.append(output, " call " + functionLabel(name) + "\n") }
                            }
                        }
                    }
                }
            }
        }
                                }
                            }
                    }
                }
            }
        }
        }
        return output + " add rsp, " + token.number(stackBytes + padding + count * 16) + "\n"
    end

    fn stringExpression(source: string, pool: *[12582912]int, functionId: int, id: int): string
    begin
        if id < 0 { return "" }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.literalKind() && ast.read(pool, id, 10) = token.stringKind() {
            return " lea rax, [rip+.Lstr" + token.number(ast.read(pool, id, 1)) + "]\n"
        }
        if kind = ast.nameKind() {
            var name: string := str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2))
            var offset: int := boundLocalOffset(source, pool, functionId, id)
            var fieldAddress: string := qualifiedFieldAddress(source, pool, functionId, id)
            if str.length(fieldAddress) > 0 { return fieldAddress + " mov rax, qword ptr [rax]\n" }
            if offset < 0 { return "" }
            return " mov rax, qword ptr [rbp-" + token.number(offset) + "]\n"
        }
        if kind = ast.memberKind() {
            var address: string := memberAddress(source, pool, functionId, id)
            if str.length(address) = 0 { return "" }
            return address + " mov rax, qword ptr [rax]\n"
        }
        if kind = ast.indexKind() {
            var address: string := arrayElementAddress(source, pool, functionId, id)
            if str.length(address) = 0 { return "" }
            return address + " mov rax, qword ptr [rax]\n"
        }
        if kind = ast.unaryKind() && ast.read(pool, id, 10) = 42 {
            var pointer: string := integerExpression(source, pool, functionId, ast.read(pool, id, 3))
            if str.length(pointer) = 0 { return "" }
            return pointer + " mov rax, qword ptr [rax]\n"
        }
        if kind = ast.callKind() { return callCode(source, pool, functionId, id) }
        if kind = ast.binaryKind() && ast.read(pool, id, 10) = 43 {
            var left: string := stringExpression(source, pool, functionId, ast.read(pool, id, 3))
            var right: string := stringExpression(source, pool, functionId, ast.read(pool, id, 4))
            if str.length(left) = 0 || str.length(right) = 0 { return "" }
            return left + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + right + " mov rsi, rax\n mov rdi, qword ptr [rsp]\n add rsp, 16\n call xestr.concat\n"
        }
        return ""
    end

    fn arraySumIndexIsSimple(pool: *[12582912]int, id: int): int
    begin
        if id < 0 { return 0 }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.nameKind() || kind = ast.literalKind() { return 1 }
        if kind = ast.unaryKind() && ast.read(pool, id, 10) = 45 { return arraySumIndexIsSimple(pool, ast.read(pool, id, 3)) }
        if kind = ast.binaryKind() {
            var operation: int := ast.read(pool, id, 10)
            if operation = 43 || operation = 45 || operation = 42 {
                return arraySumIndexIsSimple(pool, ast.read(pool, id, 3)) * arraySumIndexIsSimple(pool, ast.read(pool, id, 4))
            }
        }
        return 0
    end

    fn collectArraySumLeaves(source: string, pool: *[12582912]int, functionId: int, id: int, leaves: *[32]int, count: *int, arrayCount: *int): int
    begin
        if id < 0 { return 0 }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.binaryKind() && ast.read(pool, id, 10) = 43 {
            if collectArraySumLeaves(source, pool, functionId, ast.read(pool, id, 3), leaves, count, arrayCount) = 0 { return 0 }
            return collectArraySumLeaves(source, pool, functionId, ast.read(pool, id, 4), leaves, count, arrayCount)
        }
        if kind = ast.indexKind() && *count < 32 {
            var baseId: int := ast.read(pool, id, 3)
            var indexId: int := ast.read(pool, id, 4)
            if arrayLengthIsFixedLocal(source, pool, functionId, baseId) = 1 && arraySumIndexIsSimple(pool, indexId) = 1 {
                (*leaves)[*count] := id
                *count := *count + 1
                *arrayCount := *arrayCount + 1
                return 1
            }
            return 0
        }
        if *count < 32 && expressionType(source, pool, functionId, id) = "int" && arraySumIndexIsSimple(pool, id) = 1 {
            (*leaves)[*count] := id
            *count := *count + 1
            return 1
        }
        return 0
    end

    fn arraySumCode(source: string, pool: *[12582912]int, functionId: int, id: int): string
    begin
        var leaves: [32]int
        var count: int := 0
        var arrayCount: int := 0
        if collectArraySumLeaves(source, pool, functionId, id, &leaves, &count, &arrayCount) = 0 || count < 2 || arrayCount = 0 { return "" }
        var output: string := str.builder("")
        var index: int := 0
        while index < count {
            var value: string := integerExpression(source, pool, functionId, leaves[index])
            if str.length(value) = 0 { return "" }
            if index = 0 { output := str.append(output, value + " mov r10, rax\n") }
            else { output := str.append(output, value + " add r10, rax\n") }
            index := index + 1
        }
        return output + " mov rax, r10\n"
    end

    fn isInsideArrayIndex(pool: *[12582912]int, functionId: int, id: int): int
    begin
        var start: int := ast.read(pool, id, 1)
        var finish: int := ast.read(pool, id, 2)
        var candidate: int := functionId
        var limit: int := ast.read(pool, functionId, 11)
        while candidate < limit {
            if ast.read(pool, candidate, 9) = functionId && ast.read(pool, candidate, 0) = ast.indexKind() {
                var indexId: int := ast.read(pool, candidate, 4)
                if indexId >= 0 && ast.read(pool, indexId, 1) <= start && ast.read(pool, indexId, 2) >= finish { return 1 }
            }
            candidate := candidate + 1
        }
        return 0
    end

    fn scalarProductSumCode(source: string, pool: *[12582912]int, functionId: int, id: int): string
    begin
        if id < 0 || ast.read(pool, id, 0) != ast.binaryKind() || ast.read(pool, id, 10) != 43 { return "" }
        var leftId: int := ast.read(pool, id, 3)
        var rightId: int := ast.read(pool, id, 4)
        if ast.read(pool, leftId, 0) != ast.nameKind() || ast.read(pool, rightId, 0) != ast.binaryKind() || ast.read(pool, rightId, 10) != 42 { return "" }
        if ast.read(pool, ast.read(pool, rightId, 3), 0) != ast.nameKind() || ast.read(pool, ast.read(pool, rightId, 4), 0) != ast.nameKind() { return "" }
        if expressionType(source, pool, functionId, leftId) != "int" || expressionType(source, pool, functionId, rightId) != "int" { return "" }
        if isInsideArrayIndex(pool, functionId, id) = 1 { return "" }
        var left: string := integerExpression(source, pool, functionId, leftId)
        var right: string := integerExpression(source, pool, functionId, rightId)
        if str.length(left) = 0 || str.length(right) = 0 { return "" }
        return left + " mov r10, rax\n" + right + " add r10, rax\n mov rax, r10\n"
    end

    fn expressionContainsCall(pool: *[12582912]int, id: int, depth: int): int
    begin
        if id < 0 { return 0 }
        if depth > 32 { return 1 }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.callKind() { return 1 }
        if kind = ast.unaryKind() { return expressionContainsCall(pool, ast.read(pool, id, 3), depth + 1) }
        if kind = ast.binaryKind() {
            if expressionContainsCall(pool, ast.read(pool, id, 3), depth + 1) = 1 { return 1 }
            return expressionContainsCall(pool, ast.read(pool, id, 4), depth + 1)
        }
        if kind = ast.indexKind() {
            if expressionContainsCall(pool, ast.read(pool, id, 3), depth + 1) = 1 { return 1 }
            return expressionContainsCall(pool, ast.read(pool, id, 4), depth + 1)
        }
        if kind = ast.memberKind() { return expressionContainsCall(pool, ast.read(pool, id, 3), depth + 1) }
        return 0
    end

    // Returns X when code is exactly " mov rax, X" and X is a register, a
    // stack slot, or an immediate that does not involve rax or rsp.
    fn simpleOperand(code: string): string
    begin
        var size: int := str.length(code)
        if size < 12 || str.slice(code, 0, 10) != " mov rax, " || str.char(code, size - 1) != 10 { return "" }
        var operand: string := str.slice(code, 10, size - 1)
        if str.find(operand, token.character(10)) >= 0 { return "" }
        if str.find(operand, "rax") >= 0 || str.find(operand, "eax") >= 0 || str.find(operand, "rsp") >= 0 || str.find(operand, "rcx") >= 0 || str.find(operand, "rdx") >= 0 { return "" }
        var first: int := str.char(operand, 0)
        if (first >= 48 && first <= 57) || first = 45 {
            if str.length(operand) > 10 { return "" }
            var value: [2]int := parseInteger(operand)
            if value[0] = 0 || value[1] < -2147483648 || value[1] > 2147483647 { return "" }
        }
        return operand
    end

    fn operandIsRegisterOrImmediate(operand: string): int
    begin
        if str.length(operand) = 0 { return 0 }
        if str.find(operand, "[") >= 0 { return 0 }
        return 1
    end

    fn integerExpression(source: string, pool: *[12582912]int, mainId: int, id: int): string
    begin
        if id < 0 { return "" }
        var kind: int := ast.read(pool, id, 0)
        if kind = ast.binaryKind() && ast.read(pool, id, 10) = 43 {
            var arraySum: string := arraySumCode(source, pool, mainId, id)
            if str.length(arraySum) > 0 { return arraySum }
            var scalarProductSum: string := scalarProductSumCode(source, pool, mainId, id)
            if str.length(scalarProductSum) > 0 { return scalarProductSum }
        }
        if kind = ast.literalKind() {
            if ast.read(pool, id, 10) = token.stringKind() { return stringExpression(source, pool, mainId, id) }
            if ast.read(pool, id, 10) != token.numberKind() { return "" }
            var number: string := str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2))
            if str.find(number, ".") >= 0 { return "" }
            return " mov rax, " + number + "\n"
        }
        if kind = ast.nameKind() {
            var name: string := str.slice(source, ast.read(pool, id, 1), ast.read(pool, id, 2))
            var type: string := boundLocalType(source, pool, mainId, id)
            if str.length(type) > 0 && str.char(type, 0) = 91 { return arrayAddress(source, pool, mainId, id) }
            var fieldAddress: string := qualifiedFieldAddress(source, pool, mainId, id)
            if str.length(fieldAddress) > 0 { return fieldAddress + " mov rax, qword ptr [rax]\n" }
            var offset: int := boundLocalOffset(source, pool, mainId, id)
            var register: int := registerIndexForName(source, pool, mainId, id)
            if register >= 0 { return " mov rax, " + registerName(register) + "\n" }
            if offset < 0 {
                if name = "true" { return " mov rax, 1\n" }
                if name = "false" { return " xor eax, eax\n" }
                return ""
            }
            return " mov rax, qword ptr [rbp-" + token.number(offset) + "]\n"
        }
        if kind = ast.memberKind() {
            var address: string := memberAddress(source, pool, mainId, id)
            if str.length(address) = 0 { return "" }
            return address + " mov rax, qword ptr [rax]\n"
        }
        if kind = ast.callKind() {
            return callCode(source, pool, mainId, id)
        }
        if kind = ast.unaryKind() {
            var operand: string := integerExpression(source, pool, mainId, ast.read(pool, id, 3))
            var operation: int := ast.read(pool, id, 10)
            if operation = 45 { return operand + " neg rax\n" }
            if operation = 33 { return operand + " test rax, rax\n sete al\n movzx rax, al\n" }
            if operation = 126 { return operand + " not rax\n" }
            if operation = 42 { return operand + " mov rax, qword ptr [rax]\n" }
            if operation = 38 {
                var value: int := ast.read(pool, id, 3)
                if value >= 0 && ast.read(pool, value, 0) = ast.indexKind() { return arrayElementAddress(source, pool, mainId, value) }
                if value >= 0 && ast.read(pool, value, 0) = ast.memberKind() { return memberAddress(source, pool, mainId, value) }
                if value >= 0 && ast.read(pool, value, 0) = ast.nameKind() {
                    var name: string := str.slice(source, ast.read(pool, value, 1), ast.read(pool, value, 2))
                    var function: int := functionNode(source, pool, mainId, name)
                    if function >= 0 { return " lea rax, [rip+" + functionLabel(qualifiedFunctionName(source, pool, function)) + "]\n" }
                    var fieldAddress: string := qualifiedFieldAddress(source, pool, mainId, value)
                    if str.length(fieldAddress) > 0 { return fieldAddress }
                    var offset: int := boundLocalOffset(source, pool, mainId, value)
                    if offset >= 0 { return " lea rax, [rbp-" + token.number(offset) + "]\n" }
                }
                return ""
            }
            if operation = 64 { return operand }
            if operation = 35 { return operand + " mov rax, qword ptr [rax]\n" }
            return ""
        }
        if kind = ast.indexKind() {
            var baseId: int := ast.read(pool, id, 3)
            var baseType: string := arrayType(source, pool, mainId, baseId)
            var width: int := arrayElementWords(source, baseType) * 8
            var capacity: int := arrayCapacity(baseType)
            if capacity > 0 && arrayLengthIsFixedLocal(source, pool, mainId, baseId) = 1 {
                var range: [3]int := expressionIntegerRange(source, pool, mainId, ast.read(pool, id, 4), ast.read(pool, id, 1), 0)
                if range[0] = 1 && range[1] >= 0 && range[2] < capacity {
                    var offset: int := boundLocalOffset(source, pool, mainId, baseId)
                    var memory: string := directLocalArrayMemory(source, pool, mainId, ast.read(pool, id, 4), offset, width)
                    if offset >= 0 && str.length(memory) > 0 { return " mov rax, qword ptr " + memory + "\n" }
                }
            }
            var address: string := arrayElementAddress(source, pool, mainId, id)
            if str.length(address) = 0 { return "" }
            return address + " mov rax, qword ptr [rax]\n"
        }
        if kind = ast.binaryKind() {
            var operation: int := ast.read(pool, id, 10)
            var leftType: string := expressionType(source, pool, mainId, ast.read(pool, id, 3))
            var rightType: string := expressionType(source, pool, mainId, ast.read(pool, id, 4))
            if operation != 256 && operation != 257 && (leftType = "string" || leftType = "str" || rightType = "string" || rightType = "str") {
                if operation = 43 && (leftType = "string" || leftType = "str") && (rightType = "string" || rightType = "str") { return stringExpression(source, pool, mainId, id) }
                return ""
            }
            if (operation = 43 || operation = 45) && str.length(leftType) > 0 && str.char(leftType, 0) = 42 && rightType = "int" {
                var pointerCode: string := integerExpression(source, pool, mainId, ast.read(pool, id, 3))
                var amountCode: string := integerExpression(source, pool, mainId, ast.read(pool, id, 4))
                if str.length(pointerCode) = 0 || str.length(amountCode) = 0 { return "" }
                var stride: int := 8
                if leftType = "*" || leftType = "*void" { stride := 1 }
                var adjustment: string := " add "
                if operation = 45 { adjustment := " sub " }
                return pointerCode + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + amountCode + " imul rax, " + token.number(stride) + "\n mov rcx, rax\n mov rax, qword ptr [rsp]\n add rsp, 16\n" + adjustment + "rax, rcx\n"
            }
            if operation = 43 && leftType = "int" && str.length(rightType) > 0 && str.char(rightType, 0) = 42 {
                var amount: string := integerExpression(source, pool, mainId, ast.read(pool, id, 3))
                var pointer: string := integerExpression(source, pool, mainId, ast.read(pool, id, 4))
                if str.length(amount) = 0 || str.length(pointer) = 0 { return "" }
                var stride: int := 8
                if rightType = "*" || rightType = "*void" { stride := 1 }
                return amount + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + pointer + " imul qword ptr [rsp], " + token.number(stride) + "\n add rax, qword ptr [rsp]\n add rsp, 16\n"
            }
            if (operation = 256 || operation = 257 || operation = 258 || operation = 259 || operation = 60 || operation = 62) && stringExpressionType(source, pool, mainId, ast.read(pool, id, 3)) = 1 && stringExpressionType(source, pool, mainId, ast.read(pool, id, 4)) = 1 {
                var leftString: string := stringExpression(source, pool, mainId, ast.read(pool, id, 3))
                var rightString: string := stringExpression(source, pool, mainId, ast.read(pool, id, 4))
                if str.length(leftString) = 0 || str.length(rightString) = 0 { return "" }
                var suffix: string := token.number(id)
                var less: string := ".LxeStringLess" + suffix
                var greater: string := ".LxeStringGreater" + suffix
                var equal: string := ".LxeStringEqual" + suffix
                var done: string := ".LxeStringCompareDone" + suffix
                var comparison: string := str.builder(leftString + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + rightString + " mov rsi, rax\n mov rdi, qword ptr [rsp]\n add rsp, 16\n")
                comparison := str.append(comparison, less + ":\n movzx eax, byte ptr [rdi]\n movzx edx, byte ptr [rsi]\n cmp eax, edx\n jb " + less + "Value\n ja " + greater + "Value\n test eax, eax\n jz " + equal + "\n inc rdi\n inc rsi\n jmp " + less + "\n")
                comparison := str.append(comparison, less + "Value:\n mov rax, -1\n jmp " + done + "\n" + greater + "Value:\n mov rax, 1\n jmp " + done + "\n" + equal + ":\n xor eax, eax\n" + done + ":\n")
                if operation = 256 { return comparison + " test rax, rax\n sete al\n movzx rax, al\n" }
                if operation = 257 { return comparison + " test rax, rax\n setne al\n movzx rax, al\n" }
                if operation = 60 { return comparison + " test rax, rax\n setl al\n movzx rax, al\n" }
                if operation = 62 { return comparison + " test rax, rax\n setg al\n movzx rax, al\n" }
                if operation = 258 { return comparison + " test rax, rax\n setle al\n movzx rax, al\n" }
                return comparison + " test rax, rax\n setge al\n movzx rax, al\n"
            }
            if operation = 43 && stringExpressionType(source, pool, mainId, id) = 1 { return stringExpression(source, pool, mainId, id) }
            if operation = 260 || operation = 261 {
                var leftValue: string := integerExpression(source, pool, mainId, ast.read(pool, id, 3))
                var rightValue: string := integerExpression(source, pool, mainId, ast.read(pool, id, 4))
                if str.length(leftValue) = 0 || str.length(rightValue) = 0 { return "" }
                var shortLabel: string := ".LlogicShort" + token.number(id)
                var doneLabel: string := ".LlogicDone" + token.number(id)
                var jump: string := "jz"
                var shortValue: string := "0"
                if operation = 261 {
                    jump := "jnz"
                    shortValue := "1"
                }
                return leftValue + " test rax, rax\n " + jump + " " + shortLabel + "\n" + rightValue + " test rax, rax\n setne al\n movzx rax, al\n jmp " + doneLabel + "\n" + shortLabel + ":\n mov eax, " + shortValue + "\n" + doneLabel + ":\n"
            }
            if (operation = 256 || operation = 257 || operation = 258 || operation = 259 || operation = 60 || operation = 62) && (floatExpressionType(source, pool, mainId, ast.read(pool, id, 3)) = 1 || floatExpressionType(source, pool, mainId, ast.read(pool, id, 4)) = 1) {
                var leftFloat: string := floatExpression(source, pool, mainId, ast.read(pool, id, 3))
                var rightFloat: string := floatExpression(source, pool, mainId, ast.read(pool, id, 4))
                if str.length(leftFloat) = 0 || str.length(rightFloat) = 0 { return "" }
                var compare: string := leftFloat + " sub rsp, 16\n movsd qword ptr [rsp], xmm0\n" + rightFloat + " movapd xmm1, xmm0\n movsd xmm0, qword ptr [rsp]\n add rsp, 16\n ucomisd xmm0, xmm1\n"
                if operation = 256 { return compare + " sete al\n setnp dl\n and al, dl\n movzx rax, al\n" }
                if operation = 257 { return compare + " setne al\n setp dl\n or al, dl\n movzx rax, al\n" }
                if operation = 60 { return compare + " setb al\n setnp dl\n and al, dl\n movzx rax, al\n" }
                if operation = 62 { return compare + " seta al\n movzx rax, al\n" }
                if operation = 258 { return compare + " setbe al\n setnp dl\n and al, dl\n movzx rax, al\n" }
                if operation = 259 { return compare + " setae al\n movzx rax, al\n" }
            }
            var leftId: int := ast.read(pool, id, 3)
            var rightId: int := ast.read(pool, id, 4)
