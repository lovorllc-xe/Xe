                        if str.slice(typeText, 0, 3) = "flt" && str.find(literal, ".") >= 0 {
                            output := str.append(output, " movsd xmm0, qword ptr [rip+.Lflt" + token.number(value[1]) + "]\n")
                            if negative = 1 { output := str.append(output, " mov rax, -9223372036854775808\n movq xmm1, rax\n xorpd xmm0, xmm1\n") }
                            output := str.append(output, " movsd qword ptr [rbp-" + token.number(offset) + "], xmm0\n")
                        }
                        else {
                            if str.slice(typeText, 0, 3) = "int" && str.find(literal, ".") < 0 {
                                var immediate: string := literal
                                if negative = 1 { immediate := "-" + immediate }
                                output := str.append(output, " mov rax, " + immediate + "\n mov qword ptr [rbp-" + token.number(offset) + "], rax\n")
                            }
