            var pointerFailure: string := ".LxeMemCopyPointerFailure" + suffix
            var backward: string := ".LxeMemCopyBackward" + suffix
            var forward: string := ".LxeMemCopyForward" + suffix
            var done: string := ".LxeMemCopyDone" + suffix
