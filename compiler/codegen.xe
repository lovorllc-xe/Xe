    fn functionNodeSlow(source: string, pool: *[12582912]int, functionId: int, wanted: string): int
    begin
        var lookup: string := wanted
        var module: string := functionModule(source, pool, functionId)
        var candidate: int := ast.read(pool, functionId, 10)
        var simpleMatch: int := -1
        while candidate >= 0 {
            var candidateName: string := str.slice(source, ast.read(pool, candidate, 3), ast.read(pool, candidate, 4))
            if simpleName(candidateName) = simpleName(lookup) {
                var candidateModule: string := functionModule(source, pool, candidate)
                if candidateModule + candidateName = lookup { return candidate }
                if simpleMatch < 0 { simpleMatch := candidate }
