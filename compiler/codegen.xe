            var offset: int := ast.read(pool, statement, 11)
            var type: string := typeTextForFunction(source, pool, functionId, ast.read(pool, statement, 7), ast.read(pool, statement, 8), 1)
            var register: int := optimizer.registerIndex(source, ast.read(pool, functionId, 7), ast.read(pool, functionId, 8), name, ast.read(pool, statement, 3))
            var value: int := ast.read(pool, statement, 6)
            var recordSize: int := recordWordCount(source, declaredType)
            if recordSize > 0 {
                if value >= 0 { return recordCopyTo(source, pool, functionId, value, offset, recordSize) }
                return " lea rdi, [rbp-" + token.number(offset) + "]\n xor eax, eax\n mov rcx, " + token.number(recordSize) + "\n rep stosq\n" + initializeArrayLengthsAt(source, declaredType, offset, 0)
            }
            if str.length(declaredType) > 0 && str.char(declaredType, 0) = 91 {
                if value < 0 {
                    return " lea rdi, [rbp-" + token.number(offset) + "]\n xor eax, eax\n mov rcx, " + token.number(typeWords(source, declaredType)) + "\n rep stosq\n" + initializeArrayLengthsAt(source, declaredType, offset, 0)
                }
                return arrayCopyWords(source, pool, functionId, value, offset, typeWords(source, declaredType))
            }
            if offset < 0 { return "" }
            if value < 0 {
                if declaredType = "flt" { return " mov qword ptr [rbp-" + token.number(offset) + "], 0\n" }
                if declaredType = "string" || declaredType = "str" { return " lea rax, [rip+.LxeEmpty]\n mov qword ptr [rbp-" + token.number(offset) + "], rax\n" }
                if register >= 0 { return " xor eax, eax\n mov " + registerName(register) + ", rax\n" }
                return " mov qword ptr [rbp-" + token.number(offset) + "], 0\n"
            }
            if declaredType = "flt" {
                return floatExpression(source, pool, functionId, value) + " movsd qword ptr [rbp-" + token.number(offset) + "], xmm0\n"
            }
            if register >= 0 { return integerExpression(source, pool, functionId, value) + " mov " + registerName(register) + ", rax\n" }
            return integerExpression(source, pool, functionId, value) + " mov qword ptr [rbp-" + token.number(offset) + "], rax\n"
        }
        if kind = ast.assignKind() {
            var target: int := ast.read(pool, statement, 3)
            if target < 0 { return "" }
            if ast.read(pool, target, 0) = ast.indexKind() {
                var valueId: int := ast.read(pool, statement, 4)
                var baseId: int := ast.read(pool, target, 3)
                var baseType: string := arrayType(source, pool, functionId, baseId)
                var width: int := arrayElementWords(source, baseType) * 8
                var capacity: int := arrayCapacity(baseType)
                if expressionType(source, pool, functionId, target) = "int" && expressionContainsCall(pool, valueId, 0) = 0 && capacity > 0 && arrayLengthIsFixedLocal(source, pool, functionId, baseId) = 1 {
                    var range: [3]int := expressionIntegerRange(source, pool, functionId, ast.read(pool, target, 4), ast.read(pool, target, 1), 0)
                    if range[0] = 1 && range[1] >= 0 && range[2] < capacity {
                        var arrayOffset: int := boundLocalOffset(source, pool, functionId, baseId)
                        var memory: string := directLocalArrayMemory(source, pool, functionId, ast.read(pool, target, 4), arrayOffset, width)
                        if arrayOffset >= 0 && str.length(memory) > 0 { return integerExpression(source, pool, functionId, valueId) + " mov qword ptr " + memory + ", rax\n" }
                    }
                }
                var element: string := arrayElementAddress(source, pool, functionId, target)
                if str.length(element) = 0 { return "" }
                var recordElementWords: int := recordWordCount(source, expressionType(source, pool, functionId, target))
                if recordElementWords > 0 {
                    var recordValue: string := recordAddress(source, pool, functionId, ast.read(pool, statement, 4))
                    if str.length(recordValue) = 0 { return "" }
                    return element + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + recordValue + " mov rsi, rax\n mov rdi, qword ptr [rsp]\n mov rcx, " + token.number(recordElementWords) + "\n rep movsq\n add rsp, 16\n"
                }
                if expressionType(source, pool, functionId, target) = "flt" {
                    return element + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + floatExpression(source, pool, functionId, ast.read(pool, statement, 4)) + " mov rcx, qword ptr [rsp]\n movsd qword ptr [rcx], xmm0\n add rsp, 16\n"
                }
                if expressionType(source, pool, functionId, target) = "string" || expressionType(source, pool, functionId, target) = "str" {
                    return element + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + stringExpression(source, pool, functionId, ast.read(pool, statement, 4)) + " mov rcx, qword ptr [rsp]\n mov qword ptr [rcx], rax\n add rsp, 16\n"
                }
                if expressionContainsCall(pool, valueId, 0) = 0 {
                    return element + " mov r11, rax\n" + integerExpression(source, pool, functionId, valueId) + " mov qword ptr [r11], rax\n"
                }
                return element + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + integerExpression(source, pool, functionId, valueId) + " mov rcx, qword ptr [rsp]\n mov qword ptr [rcx], rax\n add rsp, 16\n"
            }
            if ast.read(pool, target, 0) = ast.memberKind() {
                var member: string := memberAddress(source, pool, functionId, target)
                if str.length(member) = 0 { return "" }
                var memberType: string := expressionType(source, pool, functionId, target)
                var memberWords: int := recordWordCount(source, memberType)
                if memberWords > 0 {
                    var value: int := ast.read(pool, statement, 4)
                    var record: string := recordAddress(source, pool, functionId, value)
                    if str.length(record) = 0 { return "" }
                    return member + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + record + " mov rsi, rax\n mov rdi, qword ptr [rsp]\n mov rcx, " + token.number(memberWords) + "\n rep movsq\n add rsp, 16\n"
                }
                if str.length(memberType) > 0 && str.char(memberType, 0) = 91 {
                    var value: int := ast.read(pool, statement, 4)
                    var array: string := arrayAddress(source, pool, functionId, value)
                    if str.length(array) = 0 { return "" }
                    return member + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + array + " mov rsi, rax\n mov rdi, qword ptr [rsp]\n mov rcx, " + token.number(typeWords(source, memberType)) + "\n rep movsq\n add rsp, 16\n"
                }
                if expressionType(source, pool, functionId, target) = "flt" {
                    return member + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + floatExpression(source, pool, functionId, ast.read(pool, statement, 4)) + " mov rcx, qword ptr [rsp]\n movsd qword ptr [rcx], xmm0\n add rsp, 16\n"
                }
                if expressionType(source, pool, functionId, target) = "string" || expressionType(source, pool, functionId, target) = "str" {
                    return member + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + stringExpression(source, pool, functionId, ast.read(pool, statement, 4)) + " mov rcx, qword ptr [rsp]\n mov qword ptr [rcx], rax\n add rsp, 16\n"
                }
                return member + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + integerExpression(source, pool, functionId, ast.read(pool, statement, 4)) + " mov rcx, qword ptr [rsp]\n mov qword ptr [rcx], rax\n add rsp, 16\n"
            }
            if ast.read(pool, target, 0) = ast.unaryKind() && ast.read(pool, target, 10) = 35 {
                var address: string := integerExpression(source, pool, functionId, ast.read(pool, target, 3))
                var value: string := integerExpression(source, pool, functionId, ast.read(pool, statement, 4))
                if str.length(address) = 0 || str.length(value) = 0 { return "" }
                return address + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + value + " mov rcx, qword ptr [rsp]\n mov qword ptr [rcx], rax\n add rsp, 16\n"
            }
            if ast.read(pool, target, 0) = ast.unaryKind() && ast.read(pool, target, 10) = 42 {
                var pointer: string := integerExpression(source, pool, functionId, ast.read(pool, target, 3))
                if str.length(pointer) = 0 { return "" }
                if expressionType(source, pool, functionId, target) = "flt" {
                    return pointer + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + floatExpression(source, pool, functionId, ast.read(pool, statement, 4)) + " mov rcx, qword ptr [rsp]\n movsd qword ptr [rcx], xmm0\n add rsp, 16\n"
                }
                if expressionType(source, pool, functionId, target) = "string" || expressionType(source, pool, functionId, target) = "str" {
                    return pointer + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + stringExpression(source, pool, functionId, ast.read(pool, statement, 4)) + " mov rcx, qword ptr [rsp]\n mov qword ptr [rcx], rax\n add rsp, 16\n"
                }
                return pointer + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + integerExpression(source, pool, functionId, ast.read(pool, statement, 4)) + " mov rcx, qword ptr [rsp]\n mov qword ptr [rcx], rax\n add rsp, 16\n"
            }
            if ast.read(pool, target, 0) != ast.nameKind() { return "" }
            var name: string := str.slice(source, ast.read(pool, target, 1), ast.read(pool, target, 2))
            var offset: int := boundLocalOffset(source, pool, functionId, target)
            var type: string := boundLocalType(source, pool, functionId, target)
            var qualifiedAddress: string := qualifiedFieldAddress(source, pool, functionId, target)
            if str.length(qualifiedAddress) > 0 {
                var aggregateWords: int := recordWordCount(source, type)
                if aggregateWords > 0 {
                    var recordValue: string := recordAddress(source, pool, functionId, ast.read(pool, statement, 4))
                    if str.length(recordValue) = 0 { return "" }
                    return qualifiedAddress + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + recordValue + " mov rsi, rax\n mov rdi, qword ptr [rsp]\n mov rcx, " + token.number(aggregateWords) + "\n rep movsq\n add rsp, 16\n"
                }
                if str.length(type) > 0 && str.char(type, 0) = 91 {
                    var arrayValue: string := arrayAddress(source, pool, functionId, ast.read(pool, statement, 4))
                    if str.length(arrayValue) = 0 { return "" }
                    return qualifiedAddress + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + arrayValue + " mov rsi, rax\n mov rdi, qword ptr [rsp]\n mov rcx, " + token.number(typeWords(source, type)) + "\n rep movsq\n add rsp, 16\n"
                }
                if type = "flt" { return qualifiedAddress + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + floatExpression(source, pool, functionId, ast.read(pool, statement, 4)) + " mov rcx, qword ptr [rsp]\n movsd qword ptr [rcx], xmm0\n add rsp, 16\n" }
                if type = "string" || type = "str" { return qualifiedAddress + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + stringExpression(source, pool, functionId, ast.read(pool, statement, 4)) + " mov rcx, qword ptr [rsp]\n mov qword ptr [rcx], rax\n add rsp, 16\n" }
                return qualifiedAddress + " sub rsp, 16\n mov qword ptr [rsp], rax\n" + integerExpression(source, pool, functionId, ast.read(pool, statement, 4)) + " mov rcx, qword ptr [rsp]\n mov qword ptr [rcx], rax\n add rsp, 16\n"
            }
            if str.length(type) > 0 && str.char(type, 0) = 91 { return arrayCopyWords(source, pool, functionId, ast.read(pool, statement, 4), offset, typeWords(source, type)) }
            var recordWords: int := recordWordCount(source, type)
            if recordWords > 0 { return recordCopyTo(source, pool, functionId, ast.read(pool, statement, 4), offset, recordWords) }
            if type = "flt" { return floatExpression(source, pool, functionId, ast.read(pool, statement, 4)) + " movsd qword ptr [rbp-" + token.number(offset) + "], xmm0\n" }
            var register: int := registerIndexForName(source, pool, functionId, target)
            if register >= 0 {
                var assigned: string := integerExpression(source, pool, functionId, ast.read(pool, statement, 4))
                var targetRegister: string := registerName(register)
                var prefix: string := " mov rax, " + targetRegister + "\n"
                var prefixSize: int := str.length(prefix)
                var assignedSize: int := str.length(assigned)
                if assignedSize > prefixSize && str.slice(assigned, 0, prefixSize) = prefix {
                    var update: string := str.slice(assigned, prefixSize, assignedSize)
                    if str.find(str.slice(update, 0, str.length(update) - 1), token.character(10)) < 0 && str.find(update, "rax") > 0 && str.find(update, "rcx") < 0 && str.find(update, "rdx") < 0 {
                        var opEnd: int := str.find(update, " rax, ")
                        if opEnd > 0 {
                            var opcode: string := str.slice(update, 0, opEnd)
                            var rest: string := str.slice(update, opEnd + 6, str.length(update))
                            if (opcode = " add" || opcode = " sub" || opcode = " and" || opcode = " or" || opcode = " xor") && str.find(rest, "rax") < 0 { return opcode + " " + targetRegister + ", " + rest }
                        }
                    }
                }
                var simple: string := simpleOperand(assigned)
                if str.length(simple) > 0 { return " mov " + targetRegister + ", " + simple + "\n" }
                var tailAdd: string := " mov rcx, rax\n mov rax, " + targetRegister + "\n add rax, rcx\n"
                var tailSize: int := str.length(tailAdd)
                if assignedSize > tailSize && str.slice(assigned, assignedSize - tailSize, assignedSize) = tailAdd { return str.slice(assigned, 0, assignedSize - tailSize) + " add " + targetRegister + ", rax\n" }
                return assigned + " mov " + targetRegister + ", rax\n"
            }
            if offset < 0 { return "" }
            return integerExpression(source, pool, functionId, ast.read(pool, statement, 4)) + " mov qword ptr [rbp-" + token.number(offset) + "], rax\n"
        }
        if kind = ast.returnKind() {
            var value: int := ast.read(pool, statement, 6)
            var deferred: string := deferredCode(source, pool, functionId, ast.read(pool, functionId, 6), ast.read(pool, statement, 1))
            var restore: string := ""
            if str.slice(source, ast.read(pool, functionId, 3), ast.read(pool, functionId, 4)) != "main" { restore := restoreRegisters(source, pool, functionId) }
            if value < 0 { return deferred + " xor eax, eax\n" + restore + " leave\n ret\n" }
            var resultType: string := functionResultTypeAt(source, pool, functionId)
            if resultType = "flt" { return deferred + floatExpression(source, pool, functionId, value) + restore + " leave\n ret\n" }
            if indirectResult(source, resultType) = 1 {
                var array: string := recordAddress(source, pool, functionId, value)
                if str.char(resultType, 0) = 91 { array := arrayAddress(source, pool, functionId, value) }
                var words: int := typeWords(source, resultType)
                if str.length(array) = 0 || words <= 0 { return "" }
                return deferred + array + " mov rsi, rax\n mov rdi, qword ptr [rbp-8]\n mov rcx, " + token.number(words) + "\n rep movsq\n mov rax, qword ptr [rbp-8]\n" + restore + " leave\n ret\n"
            }
            return deferred + integerExpression(source, pool, functionId, value) + restore + " leave\n ret\n"
        }
        if kind = ast.deferKind() { return "" }
        if kind = ast.expressionKind() {
            var expression: int := ast.read(pool, statement, 6)
            if expression >= 0 && ast.read(pool, expression, 0) = ast.callKind() {
                var called: int := ast.read(pool, expression, 3)
                if called >= 0 && ast.read(pool, called, 0) = ast.nameKind() {
                    var word: string := str.slice(source, ast.read(pool, called, 1), ast.read(pool, called, 2))
                    if word = "write" || word = "writeln" {
                        var argument: int := ast.read(pool, expression, 6)
                        return writeCallCode(source, pool, functionId, word, argument, ast.read(pool, statement, 1))
                    }
                    if word = "read" || word = "readln" {
                        var argument: int := ast.read(pool, expression, 6)
                        if argument >= 0 { return readArgumentCode(source, pool, functionId, word, argument) }
                    }
                }
            }
            return integerExpression(source, pool, functionId, expression)
        }
        if kind = ast.assemblyKind() {
            var raw: string := str.slice(source, ast.read(pool, statement, 1), ast.read(pool, statement, 2))
            var opening: int := str.find(raw, "{")
            var closing: int := str.length(raw) - 1
            if opening >= 0 && closing > opening { return str.slice(raw, opening + 1, closing) + token.character(10) }
            return ""
        }
        if kind = ast.gcKind() {
            return " call " + runtime.gcPushName() + "\n" + emitBlock(source, pool, functionId, ast.read(pool, statement, 6)) + " call " + runtime.gcPopName() + "\n"
        }
        if kind = ast.branchKind() {
            var id: string := token.number(statement)
            var otherwise: string := ".LxeElse" + id
            var finish: string := ".LxeIfEnd" + id
            var condition: string := branchCondition(source, pool, functionId, ast.read(pool, statement, 3), otherwise, 0)
            var no: int := ast.read(pool, statement, 4)
            var output: string := str.builder(condition + emitBlock(source, pool, functionId, ast.read(pool, statement, 6)))
            if no >= 0 { output := str.append(output, " jmp " + finish + "\n" + otherwise + ":\n" + emitBlock(source, pool, functionId, no) + finish + ":\n") }
            else { output := str.append(output, otherwise + ":\n") }
            return output
        }
        if kind = ast.loopKind() {
            var id: string := token.number(statement)
            var again: string := ".LxeWhile" + id
            var finish: string := ".LxeWhileEnd" + id
            var condition: string := branchCondition(source, pool, functionId, ast.read(pool, statement, 3), finish, 0)
            return again + ":\n" + condition + emitBlock(source, pool, functionId, ast.read(pool, statement, 6)) + " jmp " + again + "\n" + finish + ":\n"
        }
        if kind = ast.switchKind() {
            var id: string := token.number(statement)
            var finish: string := ".LxeSwitchEnd" + id
            var selector: string := integerExpression(source, pool, functionId, ast.read(pool, statement, 3))
            var arms: int := ast.read(pool, statement, 6)
            var scratch: int := (integerLocalCount(source, pool, functionId) + parameterCount(source, pool, functionId)) * 8 + 8
            var output: string := str.builder(selector + " mov qword ptr [rbp-" + token.number(scratch) + "], rax\n")
            var arm: int := arms
            var visited: int := 0
            var fallback: int := -1
            while arm >= 0 && visited < 32768 {
                if ast.read(pool, arm, 10) = 1 { fallback := arm }
                else {
                    var switchValue: [2]int := integerValue(source, pool, ast.read(pool, arm, 3))
                    if switchValue[0] = 1 {
                        var next: string := ".LxeSwitchNext" + id + "x" + token.number(arm)
                        output := str.append(output, " cmp qword ptr [rbp-" + token.number(scratch) + "], " + token.number(switchValue[1]) + "\n jne " + next + "\n" + emitBlock(source, pool, functionId, ast.read(pool, arm, 6)) + " jmp " + finish + "\n" + next + ":\n")
                    }
                }
                arm := ast.read(pool, arm, 5)
                visited := visited + 1
            }
            if fallback >= 0 { output := str.append(output, emitBlock(source, pool, functionId, ast.read(pool, fallback, 6))) }
            return output + finish + ":\n"
        }
        return ""
    end

    fn integerLocalStatements(source: string, pool: *[12582912]int, mainId: int): string
    begin
        return emitStatements(source, pool, mainId, ast.read(pool, mainId, 6)) + deferredCode(source, pool, mainId, ast.read(pool, mainId, 6), ast.read(pool, mainId, 8))
    end

    fn integerReturnCode(source: string, pool: *[12582912]int, mainId: int): string
    begin
        var restore: string := ""
        if str.slice(source, ast.read(pool, mainId, 3), ast.read(pool, mainId, 4)) != "main" { restore := restoreRegisters(source, pool, mainId) }
        return " xor eax, eax\n" + restore + " leave\n ret\n"
    end

    fn integerHelpers(source: string, pool: *[12582912]int, program: [4]int): string
    begin
        var output: string := str.builder("")
        var functionId: int := program[1]
        var visited: int := 0
        while functionId >= 0 && visited < program[2] {
            var name: string := str.slice(source, ast.read(pool, functionId, 3), ast.read(pool, functionId, 4))
            if name != "main" {
                var statement: int := ast.read(pool, functionId, 6)
                var quick: string := ""
                if statement >= 0 { quick := fast.compile(source, pool, functionId) }
                if str.length(quick) > 0 { output := str.append(output, quick) }
                if statement >= 0 && str.length(quick) = 0 {
                    var label: string := functionLabel(qualifiedFunctionName(source, pool, functionId))
                    var opening: [4]int := parser.significant(source, ast.read(pool, functionId, 4), 1)
                    var parameter: [4]int := parser.significant(source, opening[2], opening[3])
                    var parameterIndex: int := 0
                    var integerIndex: int := 0
                    var floatIndex: int := 0
                    var stackIndex: int := 0
                    var aggregateWordsSeen: int := 0
                    var parameters: string := str.builder("")
                    var aggregateCopies: string := str.builder("")
                    var resultType: string := functionResultType(source, pool, functionId, name)
                    var hidden: int := 0
                    if indirectResult(source, resultType) = 1 {
                        hidden := 1
                        integerIndex := 1
                        parameters := str.append(parameters, " mov qword ptr [rbp-8], rdi\n")
                    }
                    while parameter[0] != 41 && parameter[0] != token.endKind() && parameterIndex < 32 {
                        var colon: [4]int := parser.significant(source, parameter[2], parameter[3])
                        var kind: [4]int := parser.significant(source, colon[2], colon[3])
                        var typeFinish: [4]int := kind
                        while typeFinish[0] != 44 && typeFinish[0] != 41 && typeFinish[0] != token.endKind() { typeFinish := parser.significant(source, typeFinish[2], typeFinish[3]) }
                        var type: string := typeTextForFunction(source, pool, functionId, kind[1], typeFinish[1], kind[3])
                        var destination: int := (parameterIndex + hidden + 1) * 8
                        var recordWords: int := recordWordCount(source, type)
                        if recordWords <= 0 && str.length(type) > 0 && str.char(type, 0) = 91 { recordWords := typeWords(source, type) }
                        if recordWords > 0 {
                            var recordOffset: int := (parameterCount(source, pool, functionId) + hidden + integerLocalCount(source, pool, functionId) + arrayTemporaryWords(source, pool, functionId) + 2 + optimizer.registerCount(source, ast.read(pool, functionId, 7), ast.read(pool, functionId, 8)) + recordParameterWords(source, pool, functionId) - aggregateWordsSeen) * 8
                            if integerIndex < 6 { parameters := str.append(parameters, " mov qword ptr [rbp-" + token.number(destination) + "], " + integerArgumentRegister(integerIndex) + "\n") }
                            else {
                                parameters := str.append(parameters, " mov rax, qword ptr [rbp+" + token.number(16 + stackIndex * 8) + "]\n mov qword ptr [rbp-" + token.number(destination) + "], rax\n")
                                stackIndex := stackIndex + 1
                            }
                            aggregateCopies := str.append(aggregateCopies, " mov r8, qword ptr [rbp-" + token.number(destination) + "]\n lea rdi, [rbp-" + token.number(recordOffset) + "]\n mov rsi, r8\n mov rcx, " + token.number(recordWords) + "\n rep movsq\n lea rax, [rbp-" + token.number(recordOffset) + "]\n mov qword ptr [rbp-" + token.number(destination) + "], rax\n")
                            aggregateWordsSeen := aggregateWordsSeen + recordWords
                            integerIndex := integerIndex + 1
                        }
                        else {
                        if type = "flt" {
                            if floatIndex < 8 { parameters := str.append(parameters, " movsd qword ptr [rbp-" + token.number(destination) + "], " + floatArgumentRegister(floatIndex) + "\n") }
                            else {
                                parameters := str.append(parameters, " mov rax, qword ptr [rbp+" + token.number(16 + stackIndex * 8) + "]\n mov qword ptr [rbp-" + token.number(destination) + "], rax\n")
                                stackIndex := stackIndex + 1
                            }
                            floatIndex := floatIndex + 1
                        }
                        else {
                            if integerIndex < 6 { parameters := str.append(parameters, " mov qword ptr [rbp-" + token.number(destination) + "], " + integerArgumentRegister(integerIndex) + "\n") }
                            else {
                                parameters := str.append(parameters, " mov rax, qword ptr [rbp+" + token.number(16 + stackIndex * 8) + "]\n mov qword ptr [rbp-" + token.number(destination) + "], rax\n")
                                stackIndex := stackIndex + 1
                            }
                            integerIndex := integerIndex + 1
                        }
                        }
                        parameter := typeFinish
                        if parameter[0] = 44 { parameter := parser.significant(source, parameter[2], parameter[3]) }
                        parameterIndex := parameterIndex + 1
                    }
                    parameters := str.append(parameters, aggregateCopies)
                    var frameSize: int := (parameterIndex + hidden + integerLocalCount(source, pool, functionId) + arrayTemporaryWords(source, pool, functionId) + recordParameterWords(source, pool, functionId) + 2 + optimizer.registerCount(source, ast.read(pool, functionId, 7), ast.read(pool, functionId, 8))) * 8
                    if frameSize < 16 { frameSize := 16 }
                    if frameSize % 16 != 0 { frameSize := frameSize + 8 }
                    output := str.append(output, ".global " + label + "\n.type " + label + ", @function\n" + label + ":\n push rbp\n mov rbp, rsp\n sub rsp, " + token.number(frameSize) + "\n" + saveRegisters(source, pool, functionId) + parameters)
                    output := str.append(output, integerLocalStatements(source, pool, functionId))
                    output := str.append(output, integerReturnCode(source, pool, functionId))
                }
            }
            functionId := ast.read(pool, functionId, 5)
            visited := visited + 1
        }
        return output
    end

    fn mainReturn(source: string, pool: *[12582912]int, mainId: int): string
    begin
        var statement: int := ast.read(pool, mainId, 6)
        var visited: int := 0
        while statement >= 0 && visited < 32768 {
            if ast.read(pool, statement, 0) = ast.returnKind() {
                var value: [2]int := integerValue(source, pool, ast.read(pool, statement, 6))
                if value[0] = 1 { return token.number(value[1]) }
                return "0"
            }
            statement := ast.read(pool, statement, 5)
            visited := visited + 1
        }
        return "0"
    end

    fn inlineAssembly(source: string): string
    begin
        var position: int := 0
        var line: int := 1
        var size: int := str.length(source)
        while position <= size {
            var item: [4]int := lexer.scan(source, position, line)
            if item[0] = token.endKind() { position := size + 1 }
            else {
                if item[0] = token.assemblyKind() {
                    var raw: string := str.slice(source, item[1], item[2])
                    var opening: int := str.find(raw, "{")
                    return str.slice(raw, opening + 1, str.length(raw) - 1)
                }
                position := item[2]
                line := item[3]
            }
        }
        return ""
    end

    fn calculation(source: string, functionName: string): string
    begin
        var label: string := str.builder(token.character(95))
        var namePosition: int := 0
        while namePosition < str.length(functionName) {
            var character: int := str.char(functionName, namePosition)
            if character = 46 { label := str.append(label, token.character(95)) }
            else { label := str.append(label, token.character(character)) }
            namePosition := namePosition + 1
        }
        var code: string := str.builder("\n.global " + label + "\n.type " + label + ", @function\n" + label + ":\n")
        code := str.append(code, " push rbp\n mov rbp, rsp\n sub rsp, 16\n mov qword ptr [rbp-8], rdi\n")
        code := str.append(code, " mov edi, " + allocationSize(source) + "\n call xe.alloc\n mov qword ptr [rbp-16], rax\n mov rdi, qword ptr [rbp-8]\n")
        code := str.append(code, inlineAssembly(source) + "\n mov rdi, qword ptr [rbp-16]\n call xe.free\n")
        code := str.append(code, " cvtsi2sd xmm0, qword ptr [rbp-8]\n mulsd xmm0, qword ptr [rip+.Lpi]\n leave\n ret\n")
        return code
    end

    fn generate(source: string, pool: *[12582912]int, program: [4]int): string
    begin
        var mainId: int := program[3]
        var mainBody: string := str.slice(source, ast.read(pool, mainId, 7), ast.read(pool, mainId, 8))
        var entry: string := runtime.startName()
        var separator: string := runtime.underscore()
        var output: string := str.builder(".intel" + separator + "syntax noprefix\n.section .rodata\n" + messages(source) + stringConstants(source) + floatConstants(source))
        output := str.append(output, ".section .text\n.global " + entry + "\n" + entry + ":\n mov rdi, qword ptr [rsp]\n mov qword ptr [rip+.LxeArgc], rdi\n lea rsi, [rsp+8]\n mov qword ptr [rip+.LxeArgv], rsi\n lea rdx, [rsi+rdi*8+8]\n mov qword ptr [rip+.LxeEnv], rdx\n mov qword ptr [rip+.LxeStackBase], rsp\n call main\n mov edi, eax\n mov eax, 60\n syscall\n")
        var localCount: int := integerLocalCount(source, pool, mainId)
        var stackSpace: int := 40 + (localCount + arrayTemporaryWords(source, pool, mainId)) * 8
        if stackSpace % 16 != 0 { stackSpace := stackSpace + 8 }
        output := str.append(output, ".global main\n.type main, @function\nmain:\n push rbp\n mov rbp, rsp\n sub rsp, " + token.number(stackSpace) + "\n")
        output := str.append(output, integerLocalStatements(source, pool, mainId))
        output := str.append(output, integerReturnCode(source, pool, mainId))
        output := str.append(output, integerHelpers(source, pool, program))
        output := str.append(output, runtime.assembly())
        output := str.append(output, ".section .note.GNU" + separator + "stack,\"\",@progbits\n")
        return optimizer.assembly(output)
    end

    fn freestandingBase(source: string, pool: *[12582912]int, program: [4]int): string
    begin
        var output: string := generate(source, pool, program)
        var runtimeMarker: string := ".section .rodata" + token.character(10) + ".LxeFloatHalf:"
        var runtimeStart: int := str.find(output, runtimeMarker)
        if runtimeStart >= 0 { output := str.slice(output, 0, runtimeStart) }
        var entry: string := ".global " + runtime.startName() + token.character(10) + runtime.startName() + ":" + token.character(10) + " mov rdi, qword ptr [rsp]" + token.character(10) + " mov qword ptr [rip+.LxeArgc], rdi" + token.character(10) + " lea rsi, [rsp+8]" + token.character(10) + " mov qword ptr [rip+.LxeArgv], rsi" + token.character(10) + " lea rdx, [rsi+rdi*8+8]" + token.character(10) + " mov qword ptr [rip+.LxeEnv], rdx" + token.character(10) + " mov qword ptr [rip+.LxeStackBase], rsp" + token.character(10) + " call main" + token.character(10) + " mov edi, eax" + token.character(10) + " mov eax, 60" + token.character(10) + " syscall" + token.character(10)
        var halt: string := ".global " + runtime.startName() + token.character(10) + runtime.startName() + ":" + token.character(10) + " mov rsp, 589824" + token.character(10) + " call main" + token.character(10) + ".LxeHalt:" + token.character(10) + " hlt" + token.character(10) + " jmp .LxeHalt" + token.character(10)
        return optimizer.replaceAll(output, entry, halt)
    end

    fn freestandingSupported(source: string, pool: *[12582912]int, program: [4]int, pe: int): int
    begin
        var functionId: int := program[1]
        var visitedFunctions: int := 0
        while functionId >= 0 && visitedFunctions < 32768 {
            var id: int := functionId
            var finish: int := ast.read(pool, functionId, 11)
            while id < finish {
                var kind: int := ast.read(pool, id, 0)
                if ast.read(pool, id, 9) = functionId && kind = ast.gcKind() { return 0 }
                if ast.read(pool, id, 9) = functionId && kind = ast.callKind() {
                    var called: int := ast.read(pool, id, 3)
                    if called >= 0 {
                        var name: string := str.slice(source, ast.read(pool, called, 1), ast.read(pool, called, 2))
                        if name = "alloc" || name = "free" || name = "write" || name = "writeln" || name = "read" || name = "readln" || str.find(name, "str.") = 0 || str.find(name, "file.") = 0 || str.find(name, "arg.") = 0 || name = "process.run" || name = "flt.format" { return 0 }
                    }
                }
                id := id + 1
            }
            functionId := ast.read(pool, functionId, 5)
            visitedFunctions := visitedFunctions + 1
        }
        return 1
    end

    fn generateBaremetal(source: string, pool: *[12582912]int, program: [4]int): string
    begin
        return freestandingBase(source, pool, program)
    end

    fn generateBaremetalNasm(source: string, pool: *[12582912]int, program: [4]int): string
    begin
        return optimizer.nasm(freestandingBase(source, pool, program))
    end

    fn generatePe(source: string, pool: *[12582912]int, program: [4]int): string
    begin
        var output: string := freestandingBase(source, pool, program)
        var halt: string := ".global " + runtime.startName() + token.character(10) + runtime.startName() + ":" + token.character(10) + " mov rsp, 589824" + token.character(10) + " call main" + token.character(10) + ".LxeHalt:" + token.character(10) + " hlt" + token.character(10) + " jmp .LxeHalt" + token.character(10)
        var windowsExit: string := ".global " + runtime.startName() + token.character(10) + runtime.startName() + ":" + token.character(10) + " sub rsp, 40" + token.character(10) + " call main" + token.character(10) + " mov ecx, eax" + token.character(10) + " call ExitProcess" + token.character(10) + " hlt" + token.character(10)
        output := optimizer.replaceAll(output, halt, windowsExit)
        return "extern ExitProcess" + token.character(10) + optimizer.nasm(output)
    end

    fn generateNasm(source: string, pool: *[12582912]int, program: [4]int): string
    begin
        return optimizer.nasm(generate(source, pool, program))
    end
end
