                else {
                    output := str.append(output, " mov rax, qword ptr [rsp+" + token.number(tempOffsetValue) + "]\n mov qword ptr [rsp+" + token.number(stackIndex * 8) + "], rax\n")
                    stackIndex := stackIndex + 1
                }
                gpIndex := gpIndex + 1
