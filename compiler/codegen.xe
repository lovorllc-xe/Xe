        }
        var colon: [4]int := parser.significant(source, cursor[2], cursor[3])
        if colon[0] != 58 { return "void" }
        var result: [4]int := parser.significant(source, colon[2], colon[3])
        var resultFinish: [4]int := result
        while resultFinish[0] != token.endKind() && str.slice(source, resultFinish[1], resultFinish[2]) != "begin" {
            resultFinish := parser.significant(source, resultFinish[2], resultFinish[3])
        }
        return typeTextForFunction(source, pool, target, result[1], resultFinish[1], result[3])
    end

    fn functionResultType(source: string, pool: *[12582912]int, functionId: int, wanted: string): string
    begin
        var key: string := "R" + functionModule(source, pool, functionId) + "|" + wanted
        if memo.has(key) = 1 { return memo.get(key) }
        return memo.put(key, functionResultTypeSlow(source, pool, functionId, wanted))
    end

    fn functionResultTypeSlow(source: string, pool: *[12582912]int, functionId: int, wanted: string): string
    begin
        if wanted = "atomic.load" || wanted = "atomic.compare_exchange" || wanted = "flt.toint" || wanted = "runtime.pointer.is_null" { return "int" }
        if wanted = "atomic.store" { return "void" }
        if wanted = "str.builder" || wanted = "str.append" || wanted = "str.slice" || wanted = "str.number" || wanted = "str.fromchar" || wanted = "arg.get" || wanted = "env.get" || wanted = "file.read" || wanted = "flt.format" { return "string" }
        if wanted = "runtime.pointer.read" || wanted = "runtime.globals" { return "*void" }
        if wanted = "runtime.pointer.cast.string" { return "*string" }
