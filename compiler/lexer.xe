module lexer
begin
    fn letter(value: int): int
    begin
        if value = 95 { return 1 }
        if value >= 65 && value <= 90 { return 1 }
        if value >= 97 && value <= 122 { return 1 }
        return 0
    end

    fn digit(value: int): int
    begin
        if value >= 48 && value <= 57 { return 1 }
        return 0
    end

    fn spanIs(source: string, first: int, finish: int, wanted: string): int
    begin
        if finish - first != str.length(wanted) { return 0 }
        var offset: int := 0
        while first + offset < finish {
            if str.char(source, first + offset) != str.char(wanted, offset) { return 0 }
            offset := offset + 1
        }
        return 1
    end

    fn scan(source: string, start: int, line: int): [4]int
    begin
        var size: int := str.length(source)
        var index: int := start
        var row: int := line
        var skipping: int := 1
        var continuation: int := 0
        while index < size && skipping = 1 {
            var value: int := str.char(source, index)
            if value = 10 {
                row := row + 1
                index := index + 1
                if continuation = 1 { continuation := 0 }
                else { return token.make(10, index - 1, index, row - 1) }
            }
            else {
                if value = 32 || value = 9 || value = 13 { index := index + 1 }
                else {
                    if value = 59 {
                        continuation := 1
                        index := index + 1
                    }
                    else {
                        if value = 47 && index + 1 < size && str.char(source, index + 1) = 47 {
                            while index < size && str.char(source, index) != 10 { index := index + 1 }
                        }
                        else { skipping := 0 }
                    }
                }
            }
        }
        if index >= size { return token.make(token.endKind(), size, size, row) }
        var first: int := index
        var value: int := str.char(source, index)
        if value = 34 {
            index := index + 1
            var closed: int := 0
            var escaped: int := 0
            while index < size && closed = 0 {
                value := str.char(source, index)
                if value = 10 { row := row + 1 }
                if escaped = 1 { escaped := 0 }
                else {
                    if value = 92 { escaped := 1 }
                    else { if value = 34 { closed := 1 } }
                }
                index := index + 1
            }
            if closed = 0 { return token.make(token.errorKind(), first, index, row) }
            return token.make(token.stringKind(), first, index, row)
        }
        if letter(value) = 1 {
            index := index + 1
            var finished: int := 0
            while index < size && finished = 0 {
                value := str.char(source, index)
                if letter(value) = 1 || digit(value) = 1 { index := index + 1 }
                else { finished := 1 }
            }
            if spanIs(source, first, index, "asm") = 1 {
                var opening: int := index
                var whitespace: int := 1
                while opening < size && whitespace = 1 {
                    value := str.char(source, opening)
                    if value = 32 || value = 9 || value = 13 { opening := opening + 1 }
                    else {
                        if value = 10 {
                            row := row + 1
                            opening := opening + 1
                        }
                        else { whitespace := 0 }
                    }
                }
                if opening >= size || str.char(source, opening) != 123 { return token.make(token.errorKind(), first, opening, row) }
                var depth: int := 1
                var quote: int := 0
                var escaped: int := 0
                index := opening + 1
                while index < size && depth > 0 {
                    value := str.char(source, index)
                    if quote = 1 {
                        if escaped = 1 { escaped := 0 }
                        else {
                            if value = 92 { escaped := 1 }
                            else { if value = quote { quote := 0 } }
                        }
                    }
                    else {
                        if value = 34 || value = 39 { quote := value }
                        else {
                            if value = 123 { depth := depth + 1 }
                            if value = 125 { depth := depth - 1 }
                            if value = 47 && index + 1 < size && str.char(source, index + 1) = 47 {
                                while index < size && str.char(source, index) != 10 { index := index + 1 }
                                value := 0
                            }
                        }
                    }
                    if value = 10 { row := row + 1 }
                    index := index + 1
                }
                if depth != 0 { return token.make(token.errorKind(), first, index, row) }
                return token.make(token.assemblyKind(), first, index, row)
            }
            return token.make(token.nameKind(), first, index, row)
        }
        if digit(value) = 1 {
            index := index + 1
            var finished: int := 0
            while index < size && finished = 0 {
                value := str.char(source, index)
                if digit(value) = 1 { index := index + 1 }
                else {
                    if value = 46 && index + 1 < size && digit(str.char(source, index + 1)) = 1 { index := index + 1 }
                    else { finished := 1 }
                }
            }
            return token.make(token.numberKind(), first, index, row)
        }
        if value = 60 && index + 1 < size && str.char(source, index + 1) = 60 { return token.make(token.shiftLeftKind(), first, first + 2, row) }
        if value = 62 && index + 1 < size && str.char(source, index + 1) = 62 { return token.make(token.shiftRightKind(), first, first + 2, row) }
        if value = 58 && index + 1 < size && str.char(source, index + 1) = 61 { return token.make(token.assignKind(), first, first + 2, row) }
        if value = 61 && index + 1 < size && str.char(source, index + 1) = 61 { return token.make(token.errorKind(), first, first + 2, row) }
        if value = 61 { return token.make(token.equalKind(), first, first + 1, row) }
        if value = 33 && index + 1 < size && str.char(source, index + 1) = 61 { return token.make(token.notEqualKind(), first, first + 2, row) }
        if value = 60 && index + 1 < size && str.char(source, index + 1) = 61 { return token.make(token.lessEqualKind(), first, first + 2, row) }
        if value = 62 && index + 1 < size && str.char(source, index + 1) = 61 { return token.make(token.greaterEqualKind(), first, first + 2, row) }
        if value = 38 && index + 1 < size && str.char(source, index + 1) = 38 { return token.make(token.andKind(), first, first + 2, row) }
        if value = 124 && index + 1 < size && str.char(source, index + 1) = 124 { return token.make(token.orKind(), first, first + 2, row) }
        return token.make(value, first, first + 1, row)
    end

    fn valid(source: string): int
    begin
        var index: int := 0
        var line: int := 1
        while index <= str.length(source) {
            var item: [4]int := scan(source, index, line)
            if item[0] = token.errorKind() { return 0 }
            if item[0] = token.endKind() { return 1 }
            index := item[2]
            line := item[3]
        }
        return 0
    end

    fn count(source: string, value: int): int
    begin
        var index: int := 0
        var total: int := 0
        while index < str.length(source) {
            if str.char(source, index) = value { total := total + 1 }
            index := index + 1
        }
        return total
    end
end
