fn collatz(n: int): int
begin
    var total: int := 0
    var i: int := 1
    while i < n {
        var x: int := i
        while x != 1 {
            if x % 2 = 0 {
                x := x / 2
            } else {
                x := 3 * x + 1
            }
            total := total + 1
        }
        i := i + 1
    }
    return total
end

fn parse(text: string): int
begin
    var value: int := 0
    var i: int := 0
    while i < str.length(text) {
        value := value * 10 + str.char(text, i) - 48
        i := i + 1
    }
    return value
end

fn main(): int
begin
    var n: int := parse(arg.get(0))
    writeln(collatz(n))
    return 0
end
