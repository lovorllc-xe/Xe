fn prefix(n: int): int
begin
    var a: *[268435456]int := alloc((n + 1) * 8)
    defer free(a)
    var zero_a: int := 0
    while zero_a < n + 1 {
        (*a)[zero_a] := 0
        zero_a := zero_a + 1
    }
    var i: int := 1
    while i <= n {
        (*a)[i] := (*a)[i - 1] + (i * i) % 13
        i := i + 1
    }
    var q: int := 0
    i := 1
    while i <= n {
        var lo: int := (i * 7) % n
        var hi: int := lo + (i % 50)
        if hi > n {
            hi := n
        }
        q := (q + (*a)[hi] - (*a)[lo]) % 1000000007
        i := i + 1
    }
    return q
end

fn parse(text: string): int
begin
    var value: int := 0
    var i: int := 0
    while i < str.length(text) {
        value := value * 10 + str.char(text, i) - 48
        i := i + 1
    }
    return value
end

fn main(): int
begin
    var n: int := parse(arg.get(0))
    writeln(prefix(n))
    return 0
end
