type Node: record
begin
    value: int
    next: *Node
end

fn listalloc(n: int): int
begin
    var head: *Node
    var i: int := 0
    while i < n {
        var node: *Node := alloc(16)
        node.value := i
        node.next := head
        head := node
        i := i + 1
    }
    var total: int := 0
    var cur: *Node := head
    while @cur != 0 {
        total := (total + cur.value) % 1000000007
        var following: *Node := cur.next
        free(cur)
        cur := following
    }
    return total
end

fn parse(text: string): int
begin
    var value: int := 0
    var i: int := 0
    while i < str.length(text) {
        value := value * 10 + str.char(text, i) - 48
        i := i + 1
    }
    return value
end

fn main(): int
begin
    var n: int := parse(arg.get(0))
    writeln(listalloc(n))
    return 0
end
