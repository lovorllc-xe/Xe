fn sumsq(n: int): int
begin
    var s: int := 0
    var i: int := 0
    while i < n {
        s := s + (i * i) % 7
        i := i + 1
    }
    return s
end

fn parse(text: string): int
begin
    var value: int := 0
    var i: int := 0
    while i < str.length(text) {
        value := value * 10 + str.char(text, i) - 48
        i := i + 1
    }
    return value
end

fn main(): int
begin
    var n: int := parse(arg.get(0))
    writeln(sumsq(n))
    return 0
end
