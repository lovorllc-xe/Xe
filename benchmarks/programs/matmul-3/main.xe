fn matmul(n: int): int
begin
    var a: *[268435456]int := alloc((n * n) * 8)
    defer free(a)
    var zero_a: int := 0
    while zero_a < n * n {
        (*a)[zero_a] := 0
        zero_a := zero_a + 1
    }
    var b: *[268435456]int := alloc((n * n) * 8)
    defer free(b)
    var zero_b: int := 0
    while zero_b < n * n {
        (*b)[zero_b] := 0
        zero_b := zero_b + 1
    }
    var c: *[268435456]int := alloc((n * n) * 8)
    defer free(c)
    var zero_c: int := 0
    while zero_c < n * n {
        (*c)[zero_c] := 0
        zero_c := zero_c + 1
    }
    var i: int := 0
    while i < n * n {
        (*a)[i] := (i * 7 + 3) % 10
        (*b)[i] := (i * 5 + 1) % 10
        i := i + 1
    }
    i := 0
    while i < n {
        var j: int := 0
        while j < n {
            var s: int := 0
            var k: int := 0
            while k < n {
                s := s + (*a)[i * n + k] * (*b)[k * n + j]
                k := k + 1
            }
            (*c)[i * n + j] := s
            j := j + 1
        }
        i := i + 1
    }
    var t: int := 0
    i := 0
    while i < n * n {
        t := (t + (*c)[i]) % 1000003
        i := i + 1
    }
    return t
end

fn parse(text: string): int
begin
    var value: int := 0
    var i: int := 0
    while i < str.length(text) {
        value := value * 10 + str.char(text, i) - 48
        i := i + 1
    }
    return value
end

fn main(): int
begin
    var n: int := parse(arg.get(0))
    writeln(matmul(n))
    return 0
end
