type Task: record
begin
    lo: int
    hi: int
    out: int
end

fn tsum_worker(arg: *void): int
begin
    var task: *Task := arg
    var s: int := 0
    var i: int := task.lo
    while i < task.hi {
        s := s + (i * i) % 7
        i := i + 1
    }
    task.out := s
    return 0
end

fn tsum(n: int): int
begin
    var tasks: [4]*Task
    var ids: [4]int
    var t: int := 0
    while t < 4 {
        var task: *Task := alloc(24)
        task.lo := n * t / 4
        task.hi := n * (t + 1) / 4
        task.out := 0
        tasks[t] := task
        ids[t] := thread.start(&tsum_worker, task)
        t := t + 1
    }
    var total: int := 0
    t := 0
    while t < 4 {
        thread.join(ids[t])
        var task: *Task := tasks[t]
        total := (total + task.out) % 1000000007
        free(task)
        t := t + 1
    }
    return total
end

fn parse(text: string): int
begin
    var value: int := 0
    var i: int := 0
    while i < str.length(text) {
        value := value * 10 + str.char(text, i) - 48
        i := i + 1
    }
    return value
end

fn main(): int
begin
    var n: int := parse(arg.get(0))
    writeln(tsum(n))
    return 0
end
