fn binsearch(n: int): int
begin
    var a: *[268435456]int := alloc((n) * 8)
    defer free(a)
    var zero_a: int := 0
    while zero_a < n {
        (*a)[zero_a] := 0
        zero_a := zero_a + 1
    }
    var i: int := 0
    while i < n {
        (*a)[i] := i * 3
        i := i + 1
    }
    var found: int := 0
    i := 0
    while i < n {
        var key: int := (i * 7) % (n * 3)
        var lo: int := 0
        var hi: int := n - 1
        while lo <= hi {
            var mid: int := (lo + hi) / 2
            if (*a)[mid] = key {
                found := found + 1
                lo := hi + 1
            } else {
                if (*a)[mid] < key {
                    lo := mid + 1
                } else {
                    hi := mid - 1
                }
            }
        }
        i := i + 1
    }
    return found
end

fn parse(text: string): int
begin
    var value: int := 0
    var i: int := 0
    while i < str.length(text) {
        value := value * 10 + str.char(text, i) - 48
        i := i + 1
    }
    return value
end

fn main(): int
begin
    var n: int := parse(arg.get(0))
    writeln(binsearch(n))
    return 0
end
