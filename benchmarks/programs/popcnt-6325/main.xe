fn popcnt(n: int): int
begin
    var t: int := 0
    var i: int := 0
    while i < n {
        var x: int := i
        while x != 0 {
            x := x & (x - 1)
            t := t + 1
        }
        i := i + 1
    }
    return t
end

fn parse(text: string): int
begin
    var value: int := 0
    var i: int := 0
    while i < str.length(text) {
        value := value * 10 + str.char(text, i) - 48
        i := i + 1
    }
    return value
end

fn main(): int
begin
    var n: int := parse(arg.get(0))
    writeln(popcnt(n))
    return 0
end
