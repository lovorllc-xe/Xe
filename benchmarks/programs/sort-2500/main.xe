fn sort(n: int): int
begin
    var a: *[268435456]int := alloc((n) * 8)
    defer free(a)
    var zero_a: int := 0
    while zero_a < n {
        (*a)[zero_a] := 0
        zero_a := zero_a + 1
    }
    var x: int := 12345
    var i: int := 0
    while i < n {
        x := (x * 1103515245 + 12345) % 2147483648
        (*a)[i] := x % 100000
        i := i + 1
    }
    i := 1
    while i < n {
        var v: int := (*a)[i]
        var j: int := i - 1
        while j >= 0 && (*a)[j] > v {
            (*a)[j + 1] := (*a)[j]
            j := j - 1
        }
        (*a)[j + 1] := v
        i := i + 1
    }
    var h: int := 0
    i := 0
    while i < n {
        h := (h * 31 + (*a)[i]) % 1000000007
        i := i + 1
    }
    return h
end

fn parse(text: string): int
begin
    var value: int := 0
    var i: int := 0
    while i < str.length(text) {
        value := value * 10 + str.char(text, i) - 48
        i := i + 1
    }
    return value
end

fn main(): int
begin
    var n: int := parse(arg.get(0))
    writeln(sort(n))
    return 0
end
