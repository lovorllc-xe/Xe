fn gcd(a: int, b: int): int
begin
    var x: int := a
    var y: int := b
    while y != 0 {
        var t: int := x % y
        x := y
        y := t
    }
    return x
end

fn gcdsum(n: int): int
begin
    var s: int := 0
    var i: int := 1
    while i <= n {
        s := s + gcd(i, n - i + 1)
        i := i + 1
    }
    return s
end

fn parse(text: string): int
begin
    var value: int := 0
    var i: int := 0
    while i < str.length(text) {
        value := value * 10 + str.char(text, i) - 48
        i := i + 1
    }
    return value
end

fn main(): int
begin
    var n: int := parse(arg.get(0))
    writeln(gcdsum(n))
    return 0
end
