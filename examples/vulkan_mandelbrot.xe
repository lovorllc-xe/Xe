// Runs a SPIR-V compute shader on the GPU through Vulkan and shows the result in a window.
// Build the shader first:  glslc tests/shaders/mandelbrot.comp -o tests/shaders/mandelbrot.spv
// Keys: arrows move, + / - zoom, Esc quits.
uses vulkan
uses window
uses strconv

fn main(): int
begin
    var vk: *vulkan.Vulkan := vulkan.open("xe mandelbrot")
    if @vk = 0 {
        writeln("Vulkan is not available")
        return 1
    }
    writeln("GPU: ", vulkan.device_name(vk), " (Vulkan ", vulkan.api_version(vk), ")")
    var win: *window.Window := window.open_fixed("Xe + Vulkan compute", 640, 420)
    if @win = 0 {
        writeln("no display found (set DISPLAY)")
        return 1
    }
    var limit: int := -1
    if arg.count() > 0 { limit := strconv.parse_int(arg.get(0)) }
    var w: int := 640
    var h: int := 420
    var out: *vulkan.Buffer := vulkan.buffer_new(vk, w * h * 4)
    var job: *vulkan.Compute := vulkan.compute_new(vk, "tests/shaders/mandelbrot.spv", 1, 20)
    if @job = 0 {
        writeln("could not load tests/shaders/mandelbrot.spv")
        return 1
    }
    vulkan.compute_bind(vk, job, 0, out)
    var push: *void := ffi.block(32)
    var cx: flt := -0.5
    var cy: flt := 0.0
    var zoom: flt := 1.0
    var frames: int := 0
    while window.is_open(win) && (limit < 0 || frames < limit) {
        window.poll(win)
        if window.key_pressed(win, window.key_escape()) = 1 { window.close(win) }
        var step: flt := 0.6 / zoom * window.delta_time(win)
        if window.key_down(win, window.key_left()) = 1 { cx := cx - step }
        if window.key_down(win, window.key_right()) = 1 { cx := cx + step }
        if window.key_down(win, window.key_up()) = 1 { cy := cy - step }
        if window.key_down(win, window.key_down_arrow()) = 1 { cy := cy + step }
        if window.key_down(win, 61) = 1 || window.key_down(win, 43) = 1 { zoom := zoom * (1.0 + window.delta_time(win) * 1.5) }
        if window.key_down(win, 45) = 1 { zoom := zoom / (1.0 + window.delta_time(win) * 1.5) }
        ffi.put32(push, 0, w)
        ffi.put32(push, 4, h)
        ffi.put_float32(push, 8, cx)
        ffi.put_float32(push, 12, cy)
        ffi.put_float32(push, 16, zoom)
        vulkan.compute_run(vk, job, (w + 7) / 8, (h + 7) / 8, 1, push)
        var i: int := 0
        var pixels: *[268435456]int := win.canvas.pixels
        while i < w * h {
            (*pixels)[i] := ffi.get32(out.data, i * 4)
            i := i + 1
        }
        canvas.text(win.canvas, 8, 6, "zoom " + str.number(flt.toint(zoom)) + "x   fps " + str.number(window.fps(win)), canvas.rgb(255, 255, 255))
        window.present(win)
        window.limit_fps(win, 60)
        frames := frames + 1
    }
    return 0
end
