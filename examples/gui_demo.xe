// A small GUI app: buttons, checkbox, radio buttons, slider, text box and a list.
// Run:  xe examples/gui_demo.xe && ./examples/gui_demo        (add a number to quit after that many frames)
uses gui
uses strconv

fn main(): int
begin
    var win: *window.Window := window.open("Xe GUI demo", 460, 330)
    if @win = 0 {
        writeln("no display found (set DISPLAY)")
        return 1
    }
    var limit: int := -1
    if arg.count() > 0 { limit := strconv.parse_int(arg.get(0)) }
    var ui: *gui.Gui := gui.new(win)
    var volume: int := 40
    var muted: int := 0
    var mode: int := 1
    var picked: int := 0
    var clicks: int := 0
    var name: *gui.TextBuf := gui.text_buffer(32)
    gui.text_set(name, "type here")
    var frames: int := 0
    while window.is_open(win) && (limit < 0 || frames < limit) {
        window.poll(win)
        if window.key_pressed(win, window.key_escape()) = 1 { window.close(win) }
        gui.start(ui)
        gui.panel(ui, 10, 10, 440, 310, "Xe GUI demo")
        gui.layout(ui, 24, 40, 200)
        if gui.button_auto(ui, "Clicked " + str.number(clicks) + " times") = 1 { clicks := clicks + 1 }
        gui.checkbox_auto(ui, "Muted", &muted)
        gui.slider_auto(ui, &volume, 0, 100)
        gui.label_auto(ui, "volume " + str.number(volume))
        gui.textbox_auto(ui, name)
        gui.radio(ui, 24, 196, "Low", &mode, 0)
        gui.radio(ui, 96, 196, "High", &mode, 1)
        gui.progress(ui, 24, 228, 200, 14, volume, 100)
        gui.list(ui, 250, 40, 180, "Apples|Oranges|Pears|Plums", &picked)
        gui.label(ui, 250, 150, "hello, " + gui.text_get(name))
        gui.dim_label(ui, 24, 296, "fps " + str.number(window.fps(win)) + "   Esc to quit")
        gui.finish(ui)
        window.limit_fps(win, 60)
        frames := frames + 1
    }
    return 0
end
