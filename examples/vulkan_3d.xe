// 3D scene rendered on the GPU with Vulkan and shown in a window (straight into the window's swapchain where the
// platform allows it, otherwise rendered offscreen and copied). Works on every platform and GPU with Vulkan.
// Mouse: drag to orbit, wheel to zoom. Esc quits.
uses vkscene
uses vkwindow
uses window
uses strconv

fn main(): int
begin
    var vk: *vulkan.Vulkan := vulkan.open("xe vulkan 3d")
    if @vk = 0 {
        writeln("Vulkan is not available")
        return 1
    }
    writeln("GPU: ", vulkan.device_name(vk))
    var win: *window.Window := window.open("Xe + Vulkan 3D", 800, 520)
    if @win = 0 {
        writeln("no display found (set DISPLAY)")
        return 1
    }
    var limit: int := -1
    if arg.count() > 0 { limit := strconv.parse_int(arg.get(0)) }
    var view: *vkwindow.View := vkwindow.new(vk, win, 1, 1)
    if vkwindow.direct(view) = 1 { writeln("presenting through a swapchain") }
    else { writeln("rendering offscreen and copying to the window") }
    var scene: *vkscene.Scene := vkscene.new_on(vk, vkwindow.target(view))
    var cube: *vkscene.Model := vkscene.model(vk, gfx3d.mesh_cube(1.2), 0.9, 0.4, 0.3)
    var ball: *vkscene.Model := vkscene.model(vk, gfx3d.mesh_sphere(0.7, 24, 36), 0.3, 0.55, 0.95)
    var ring: *vkscene.Model := vkscene.model(vk, gfx3d.mesh_torus(0.8, 0.28, 40, 20), 0.95, 0.8, 0.3)
    var ground: *vkscene.Model := vkscene.model(vk, gfx3d.mesh_plane(12.0, 12), 0.25, 0.4, 0.28)
    var angle: flt := 0.0
    var yaw: flt := 0.6
    var pitch: flt := 0.45
    var distance: flt := 6.5
    var last_x: int := 0
    var last_y: int := 0
    var frames: int := 0
    while window.is_open(win) && (limit < 0 || frames < limit) {
        window.poll(win)
        vkwindow.resize(vk, view, win)
        if window.key_pressed(win, window.key_escape()) = 1 { window.close(win) }
        if window.mouse_down(win, 1) = 1 {
            yaw := yaw - (win.mouse_x - last_x) * 0.01
            pitch := pitch + (win.mouse_y - last_y) * 0.01
            if pitch > 1.4 { pitch := 1.4 }
            if pitch < -0.2 { pitch := -0.2 }
        }
        last_x := win.mouse_x
        last_y := win.mouse_y
        distance := distance - win.wheel * 0.4
        if distance < 2.5 { distance := 2.5 }
        angle := angle + window.delta_time(win) * 1.2
        var ex: flt := distance * mathx.sin(yaw) * mathx.cos(pitch)
        var ey: flt := distance * mathx.sin(pitch) + 0.5
        var ez: flt := distance * mathx.cos(yaw) * mathx.cos(pitch)
        var down: *[16]flt := gfx3d.mat4_translate(0.0, -0.7, 0.0)
        var spin: *[16]flt := gfx3d.mat4_rot_y(angle)
        var lift: *[16]flt := gfx3d.mat4_translate(-1.7, 0.0, 0.0)
        var cube_model: *[16]flt := gfx3d.mat4_mul(lift, spin)
        var ball_model: *[16]flt := gfx3d.mat4_translate(1.7, mathx.sin(angle * 2.0) * 0.3, 0.0)
        var tilt: *[16]flt := gfx3d.mat4_rot_x(angle)
        var back: *[16]flt := gfx3d.mat4_translate(0.0, 0.5, -2.2)
        var ring_model: *[16]flt := gfx3d.mat4_mul(back, tilt)
        if vkscene.start(scene, 0.06, 0.07, 0.12) = 0 {
            vkscene.draw(scene, ground, down, ex, ey, ez, 0.0, 0.3, 0.0, 55.0)
            vkscene.draw(scene, cube, cube_model, ex, ey, ez, 0.0, 0.3, 0.0, 55.0)
            vkscene.draw(scene, ball, ball_model, ex, ey, ez, 0.0, 0.3, 0.0, 55.0)
            vkscene.draw(scene, ring, ring_model, ex, ey, ez, 0.0, 0.3, 0.0, 55.0)
            vkwindow.finish(vk, view, win)
        }
        gfx3d.mat4_free(down)
        gfx3d.mat4_free(spin)
        gfx3d.mat4_free(lift)
        gfx3d.mat4_free(cube_model)
        gfx3d.mat4_free(ball_model)
        gfx3d.mat4_free(tilt)
        gfx3d.mat4_free(back)
        gfx3d.mat4_free(ring_model)
        window.limit_fps(win, 60)
        frames := frames + 1
    }
    return 0
end
