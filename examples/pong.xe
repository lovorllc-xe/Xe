// Pong for two players: W/S and Up/Down move the paddles, Space restarts, Esc quits.
uses game
uses window
uses strconv

fn main(): int
begin
    var win: *window.Window := window.open_fixed("Xe Pong", 640, 400)
    if @win = 0 {
        writeln("no display found (set DISPLAY)")
        return 1
    }
    var limit: int := -1
    if arg.count() > 0 { limit := strconv.parse_int(arg.get(0)) }
    var cv: *canvas.Canvas := win.canvas
    var left_y: flt := 150.0
    var right_y: flt := 150.0
    var bx: flt := 320.0
    var by: flt := 200.0
    var vx: flt := 260.0
    var vy: flt := 140.0
    var left_score: int := 0
    var right_score: int := 0
    var sparks: *game.Particles := game.particles_new(400, canvas.rgb(255, 220, 120))
    var frames: int := 0
    while window.is_open(win) && (limit < 0 || frames < limit) {
        window.poll(win)
        if window.key_pressed(win, window.key_escape()) = 1 { window.close(win) }
        var dt: flt := window.delta_time(win)
        if dt > 0.05 { dt := 0.05 }
        if window.key_down(win, 119) = 1 { left_y := left_y - 320.0 * dt }
        if window.key_down(win, 115) = 1 { left_y := left_y + 320.0 * dt }
        if window.key_down(win, window.key_up()) = 1 { right_y := right_y - 320.0 * dt }
        if window.key_down(win, window.key_down_arrow()) = 1 { right_y := right_y + 320.0 * dt }
        left_y := game.clamp(left_y, 0.0, 320.0)
        right_y := game.clamp(right_y, 0.0, 320.0)
        bx := bx + vx * dt
        by := by + vy * dt
        if by < 6.0 {
            by := 6.0
            vy := 0.0 - vy
        }
        if by > 394.0 {
            by := 394.0
            vy := 0.0 - vy
        }
        if game.circle_rect_overlap(bx, by, 6.0, 20.0, left_y, 10.0, 80.0) = 1 && vx < 0.0 {
            vx := 0.0 - vx * 1.05
            vy := vy + (by - (left_y + 40.0)) * 3.0
            game.particles_burst(sparks, bx, by, 25, 160.0, 0.5)
        }
        if game.circle_rect_overlap(bx, by, 6.0, 610.0, right_y, 10.0, 80.0) = 1 && vx > 0.0 {
            vx := 0.0 - vx * 1.05
            vy := vy + (by - (right_y + 40.0)) * 3.0
            game.particles_burst(sparks, bx, by, 25, 160.0, 0.5)
        }
        if bx < 0.0 || bx > 640.0 {
            if bx < 0.0 { right_score := right_score + 1 }
            else { left_score := left_score + 1 }
            bx := 320.0
            by := 200.0
            vx := 260.0
            if window.key_down(win, 32) = 1 { vx := -260.0 }
            vy := 140.0
        }
        game.particles_update(sparks, dt, 120.0)
        canvas.clear(cv, canvas.rgb(12, 14, 24))
        var y: int := 0
        while y < 400 {
            canvas.fill_rect(cv, 319, y, 2, 12, canvas.rgb(60, 66, 90))
            y := y + 24
        }
        canvas.fill_rect(cv, 20, flt.toint(left_y), 10, 80, canvas.rgb(235, 238, 245))
        canvas.fill_rect(cv, 610, flt.toint(right_y), 10, 80, canvas.rgb(235, 238, 245))
        canvas.fill_circle(cv, flt.toint(bx), flt.toint(by), 6, canvas.rgb(255, 200, 80))
        game.particles_draw(sparks, cv, 0, 0)
        canvas.text_scaled(cv, 250, 12, str.number(left_score), canvas.rgb(235, 238, 245), 3)
        canvas.text_scaled(cv, 366, 12, str.number(right_score), canvas.rgb(235, 238, 245), 3)
        window.present(win)
        window.limit_fps(win, 60)
        frames := frames + 1
    }
    return 0
end
