uses collections

module string_utils
begin
    fn is.space(value: int): int
    begin
        if value = 32 || value = 9 || value = 10 || value = 11 || value = 12 || value = 13 { return 1 }
        return 0
    end

    fn trim(text: string): string
    begin
        var length: int := str.length(text)
        var first: int := 0
        while first < length && string_utils.is.space(str.char(text, first)) = 1 {
            first := first + 1
        }
        var last: int := length
        while last > first && string_utils.is.space(str.char(text, last - 1)) = 1 {
            last := last - 1
        }
        return str.slice(text, first, last)
    end

    fn add.part(parts: *collections.Vector, text: string): int
    begin
        var item: *string := alloc(64)
        *item := text
        return collections.vector.push(parts, item)
    end

    fn split(text: string, delimiter: string): *collections.Vector
    begin
        var parts: *collections.Vector := collections.vector.create(4)
        var length: int := str.length(text)
        var delimiter_length: int := str.length(delimiter)
        if delimiter_length = 0 {
            if length > 0 { string_utils.add.part(parts, text) }
            return parts
        }
        var start: int := 0
        while start <= length {
            var tail: string := str.slice(text, start, length)
            var found: int := str.find(tail, delimiter)
            if found < 0 {
                string_utils.add.part(parts, str.slice(text, start, length))
                return parts
            }
            var finish: int := start + found
            string_utils.add.part(parts, str.slice(text, start, finish))
            start := finish + delimiter_length
        }
        return parts
    end

    fn join(parts: *collections.Vector, delimiter: string): string
    begin
        var result: string := str.builder("")
        var index: int := 0
        while index < (*parts).size {
            if index > 0 { result := str.append(result, delimiter) }
            var item: *string := collections.vector.get.string(parts, index)
            result := str.append(result, *item)
            index := index + 1
        }
        return result
    end

    fn free.parts(parts: *collections.Vector): void
    begin
        var index: int := 0
        while index < (*parts).size {
            var item: *string := collections.vector.get.string(parts, index)
            runtime.pointer.free(item)
            index := index + 1
        }
        collections.vector.free(parts)
    end

    // Returns 0 for empty or malformed text. Integer overflow is reported by
    // the Stage 0 checked integer arithmetic rather than wrapping silently.
    fn to_int(text: string): int
    begin
        var value: string := trim(text)
        var length: int := str.length(value)
        if length = 0 { return 0 }
        var index: int := 0
        var sign: int := 1
        if str.char(value, 0) = 45 {
            sign := -1
            index := 1
        }
        else { if str.char(value, 0) = 43 { index := 1 } }
        if index = length { return 0 }
        var number: int := 0
        while index < length {
            var digit: int := str.char(value, index) - 48
            if digit < 0 || digit > 9 { return 0 }
            number := number * 10 + digit
            index := index + 1
        }
        return number * sign
    end
end
