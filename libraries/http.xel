// http: HTTP/1.1 client (GET/POST/any method, headers, chunked bodies). Plain http:// only.
uses url
uses tcp
uses dns
uses strmap
uses strings

module http
begin
    type Response: record
    begin
        status: int
        reason: string
        headers: *strmap.Map
        body: string
        error: string
    end

    fn empty(error: string): *http.Response
    begin
        var r: *http.Response := alloc(40)
        r.status := 0
        r.reason := ""
        r.headers := strmap.new()
        r.body := ""
        r.error := error
        return r
    end

    fn hex_value(text: string): int
    begin
        var value: int := 0
        var index: int := 0
        var going: int := 1
        while index < str.length(text) && going = 1 {
            var c: int := str.char(text, index)
            var v: int := -1
            if c >= 48 && c <= 57 { v := c - 48 }
            if c >= 97 && c <= 102 { v := c - 87 }
            if c >= 65 && c <= 70 { v := c - 55 }
            if v < 0 { going := 0 }
            else { value := value * 16 + v }
            index := index + 1
        }
        return value
    end

    fn read_response(conn: *tcp.Conn, method: string): *http.Response
    begin
        var r: *http.Response := empty("")
        var statusLine: string := tcp.read_line(conn)
        if strings.starts_with(statusLine, "HTTP/") = 0 {
            r.error := "invalid response: " + statusLine
            return r
        }
        var firstSpace: int := strings.index_of(statusLine, " ")
        var code: string := strings.substring(statusLine, firstSpace + 1, 3)
        r.status := (str.char(code, 0) - 48) * 100 + (str.char(code, 1) - 48) * 10 + str.char(code, 2) - 48
        r.reason := strings.trim(str.slice(statusLine, firstSpace + 4, str.length(statusLine)))
        var reading: int := 1
        while reading = 1 {
            var line: string := tcp.read_line(conn)
            if str.length(line) = 0 { reading := 0 }
            else {
                var colon: int := strings.index_of(line, ":")
                if colon > 0 { strmap.put(r.headers, strings.to_lower(strings.trim(str.slice(line, 0, colon))), strings.trim(str.slice(line, colon + 1, str.length(line)))) }
            }
        }
        if method = "HEAD" || r.status = 204 || r.status = 304 { return r }
        if strings.to_lower(strmap.get(r.headers, "transfer-encoding", "")) = "chunked" {
            var body: string := str.builder("")
            var chunking: int := 1
            while chunking = 1 {
                var size: int := hex_value(strings.trim(tcp.read_line(conn)))
                if size = 0 { chunking := 0 }
                else {
                    body := str.append(body, tcp.read_exact(conn, size))
                    tcp.read_line(conn)
                }
            }
            r.body := body
            return r
        }
        var lengthText: string := strmap.get(r.headers, "content-length", "")
        if str.length(lengthText) > 0 {
            var length: int := 0
            var k: int := 0
            while k < str.length(lengthText) {
                length := length * 10 + str.char(lengthText, k) - 48
                k := k + 1
            }
            r.body := tcp.read_exact(conn, length)
        }
        else { r.body := tcp.read_all(conn) }
        return r
    end

    // headers: extra header lines, each ending with \r\n (may be empty).
    fn request(method: string, target: string, headers: string, body: string): *http.Response
    begin
        var u: *url.Url := url.parse(target)
        if u.scheme != "http" { return empty("only http:// URLs are supported (no TLS)") }
        var address: string := dns.resolve(u.host)
        if str.length(address) = 0 { return empty("cannot resolve host " + u.host) }
        var conn: *tcp.Conn := tcp.connect(address, u.port)
        if tcp.ok(conn) = 0 { return empty("cannot connect to " + u.host + ":" + str.number(u.port)) }
        var resource: string := u.path
        if str.length(u.query) > 0 { resource := resource + "?" + u.query }
        var hostHeader: string := u.host
        if u.port != 80 { hostHeader := hostHeader + ":" + str.number(u.port) }
        var text: string := method + " " + resource + " HTTP/1.1\r\nHost: " + hostHeader + "\r\nUser-Agent: xe-http/2.0\r\nAccept: */*\r\nConnection: close\r\n" + headers
        if str.length(body) > 0 || method = "POST" || method = "PUT" { text := text + "Content-Length: " + str.number(str.length(body)) + "\r\n" }
        text := text + "\r\n" + body
        tcp.send(conn, text)
        var response: *http.Response := read_response(conn, method)
        tcp.close(conn)
        return response
    end

    fn get(target: string): *http.Response
    begin
        return request("GET", target, "", "")
    end

    fn post(target: string, contentType: string, body: string): *http.Response
    begin
        return request("POST", target, "Content-Type: " + contentType + "\r\n", body)
    end

    fn header(r: *http.Response, name: string): string
    begin
        return strmap.get(r.headers, strings.to_lower(name), "")
    end

    fn ok(r: *http.Response): int
    begin
        return str.length(r.error) = 0 && r.status >= 200 && r.status < 300
    end

    fn status_text(code: int): string
    begin
        if code = 200 { return "OK" }
        if code = 201 { return "Created" }
        if code = 204 { return "No Content" }
        if code = 301 { return "Moved Permanently" }
        if code = 302 { return "Found" }
        if code = 304 { return "Not Modified" }
        if code = 400 { return "Bad Request" }
        if code = 401 { return "Unauthorized" }
        if code = 403 { return "Forbidden" }
        if code = 404 { return "Not Found" }
        if code = 405 { return "Method Not Allowed" }
        if code = 500 { return "Internal Server Error" }
        if code = 503 { return "Service Unavailable" }
        return "Status"
    end
end
