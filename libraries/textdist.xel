// textdist: string similarity metrics (Levenshtein, Hamming, LCS, Jaro-Winkler).
module textdist
begin
    fn min3(a: int, b: int, c: int): int
    begin
        var m: int := a
        if b < m { m := b }
        if c < m { m := c }
        return m
    end

    fn levenshtein(a: string, b: string): int
    begin
        var n: int := str.length(a)
        var m: int := str.length(b)
        var row: *int := alloc((m + 1) * 8)
        var j: int := 0
        while j <= m {
            *(row + j) := j
            j := j + 1
        }
        var i: int := 1
        while i <= n {
            var previous: int := *row
            *row := i
            j := 1
            while j <= m {
                var saved: int := *(row + j)
                var cost: int := 1
                if str.char(a, i - 1) = str.char(b, j - 1) { cost := 0 }
                *(row + j) := min3(*(row + j) + 1, *(row + j - 1) + 1, previous + cost)
                previous := saved
                j := j + 1
            }
            i := i + 1
        }
        var result: int := *(row + m)
        free(row)
        return result
    end

    fn hamming(a: string, b: string): int
    begin
        if str.length(a) != str.length(b) { return -1 }
        var total: int := 0
        var index: int := 0
        while index < str.length(a) {
            if str.char(a, index) != str.char(b, index) { total := total + 1 }
            index := index + 1
        }
        return total
    end

    fn lcs_length(a: string, b: string): int
    begin
        var n: int := str.length(a)
        var m: int := str.length(b)
        var row: *int := alloc((m + 1) * 8)
        runtime.mem.set(row, 0, (m + 1) * 8)
        var i: int := 1
        while i <= n {
            var diagonal: int := 0
            var j: int := 1
            while j <= m {
                var saved: int := *(row + j)
                if str.char(a, i - 1) = str.char(b, j - 1) { *(row + j) := diagonal + 1 }
                else {
                    if *(row + j - 1) > *(row + j) { *(row + j) := *(row + j - 1) }
                }
                diagonal := saved
                j := j + 1
            }
            i := i + 1
        }
        var result: int := *(row + m)
        free(row)
        return result
    end

    fn similarity(a: string, b: string): flt
    begin
        var longest: int := str.length(a)
        if str.length(b) > longest { longest := str.length(b) }
        if longest = 0 { return 1.0 }
        return 1.0 - levenshtein(a, b) / (longest * 1.0)
    end

    fn jaro(a: string, b: string): flt
    begin
        var n: int := str.length(a)
        var m: int := str.length(b)
        if n = 0 && m = 0 { return 1.0 }
        if n = 0 || m = 0 { return 0.0 }
        var window: int := n
        if m > window { window := m }
        window := window / 2 - 1
        if window < 0 { window := 0 }
        var matchedA: *int := alloc(n * 8)
        var matchedB: *int := alloc(m * 8)
        runtime.mem.set(matchedA, 0, n * 8)
        runtime.mem.set(matchedB, 0, m * 8)
        var matches: int := 0
        var i: int := 0
        while i < n {
            var low: int := i - window
            if low < 0 { low := 0 }
            var high: int := i + window + 1
            if high > m { high := m }
            var j: int := low
            var found: int := 0
            while j < high && found = 0 {
                if *(matchedB + j) = 0 && str.char(a, i) = str.char(b, j) {
                    *(matchedA + i) := 1
                    *(matchedB + j) := 1
                    matches := matches + 1
                    found := 1
                }
                j := j + 1
            }
            i := i + 1
        }
        if matches = 0 { return 0.0 }
        var transpositions: int := 0
        var k: int := 0
        i := 0
        while i < n {
            if *(matchedA + i) = 1 {
                while *(matchedB + k) = 0 { k := k + 1 }
                if str.char(a, i) != str.char(b, k) { transpositions := transpositions + 1 }
                k := k + 1
            }
            i := i + 1
        }
        free(matchedA)
        free(matchedB)
        var mf: flt := matches * 1.0
        return (mf / n + mf / m + (mf - transpositions / 2.0) / mf) / 3.0
    end

    fn jaro_winkler(a: string, b: string): flt
    begin
        var score: flt := jaro(a, b)
        var prefix: int := 0
        while prefix < 4 && prefix < str.length(a) && prefix < str.length(b) && str.char(a, prefix) = str.char(b, prefix) { prefix := prefix + 1 }
        return score + prefix * 0.1 * (1.0 - score)
    end
end
