// ip: IPv4 address parsing/formatting, CIDR ranges and address classification.
uses strings

module ip
begin
    // Returns the address as a host-order int, or -1 if invalid.
    fn parse(text: string): int
    begin
        var value: int := 0
        var part: int := 0
        var digits: int := 0
        var dots: int := 0
        var index: int := 0
        while index < str.length(text) {
            var c: int := str.char(text, index)
            if c = 46 {
                if digits = 0 || part > 255 { return -1 }
                value := value * 256 + part
                part := 0
                digits := 0
                dots := dots + 1
            }
            else {
                if c < 48 || c > 57 { return -1 }
                part := part * 10 + c - 48
                digits := digits + 1
                if digits > 3 { return -1 }
            }
            index := index + 1
        }
        if dots != 3 || digits = 0 || part > 255 { return -1 }
        return value * 256 + part
    end

    fn format(address: int): string
    begin
        return str.number((address >> 24) & 255) + "." + str.number((address >> 16) & 255) + "." + str.number((address >> 8) & 255) + "." + str.number(address & 255)
    end

    fn valid(text: string): int
    begin
        return parse(text) >= 0
    end

    // 1 when address is inside the CIDR block, e.g. in_cidr("10.1.2.3", "10.0.0.0/8").
    fn in_cidr(address: string, cidr: string): int
    begin
        var slash: int := strings.index_of(cidr, "/")
        if slash < 0 { return parse(address) = parse(cidr) }
        var bits: int := 0
        var index: int := slash + 1
        while index < str.length(cidr) {
            bits := bits * 10 + str.char(cidr, index) - 48
            index := index + 1
        }
        var mask: int := 0
        if bits > 0 { mask := (4294967295 << (32 - bits)) & 4294967295 }
        var a: int := parse(address)
        var network: int := parse(str.slice(cidr, 0, slash))
        if a < 0 || network < 0 { return 0 }
        return (a & mask) = (network & mask)
    end

    fn is_private(text: string): int
    begin
        return in_cidr(text, "10.0.0.0/8") = 1 || in_cidr(text, "172.16.0.0/12") = 1 || in_cidr(text, "192.168.0.0/16") = 1
    end

    fn is_loopback(text: string): int
    begin
        return in_cidr(text, "127.0.0.0/8")
    end

    // sockaddr_in structure (16 bytes) for system calls.
    fn sockaddr(address: int, port: int): *void
    begin
        var raw: *void := alloc(16)
        runtime.mem.set(raw, 0, 16)
        runtime.hw.write8(raw, 2)
        runtime.hw.write8(raw + 2, (port >> 8) & 255)
        runtime.hw.write8(raw + 3, port & 255)
        runtime.hw.write8(raw + 4, (address >> 24) & 255)
        runtime.hw.write8(raw + 5, (address >> 16) & 255)
        runtime.hw.write8(raw + 6, (address >> 8) & 255)
        runtime.hw.write8(raw + 7, address & 255)
        return raw
    end

    fn sockaddr_address(raw: *void): int
    begin
        return (runtime.hw.read8(raw + 4) << 24) | (runtime.hw.read8(raw + 5) << 16) | (runtime.hw.read8(raw + 6) << 8) | runtime.hw.read8(raw + 7)
    end

    fn sockaddr_port(raw: *void): int
    begin
        return (runtime.hw.read8(raw + 2) << 8) | runtime.hw.read8(raw + 3)
    end
end
