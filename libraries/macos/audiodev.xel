// audiodev (macOS): there is no sound output backend on macOS yet, so open reports "no device" (0). The generators and
// WAV files of `audio` still work.
module audiodev
begin
    fn open(rate: int, channels: int): int
    begin
        return 0
    end

    fn write(handle: int, samples: *void, frames: int, channels: int): int
    begin
        return -1
    end

    fn close(handle: int)
    begin
    end
end
