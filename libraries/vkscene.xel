        text := str.append(text, "130000000900000020000400140000000900000010000000170004001700000006000000030000002000040018000000")
        text := str.append(text, "01000000170000003b0004001800000019000000010000002b000400060000001b0000000000803f2000040021000000")
        text := str.append(text, "0300000007000000200004002300000003000000170000003b0004002300000024000000030000003b00040018000000")
        text := str.append(text, "25000000010000003b0004002300000027000000030000002b0004000e0000002800000001000000180004002b000000")
        text := str.append(text, "17000000030000003b0004001800000033000000010000003600050002000000040000000000000003000000f8000200")
        text := str.append(text, "05000000410005001400000015000000130000000f0000003d0004001000000016000000150000003d00040017000000")
        text := str.append(text, "1a0000001900000051000500060000001c0000001a0000000000000051000500060000001d0000001a00000001000000")
        text := str.append(text, "51000500060000001e0000001a0000000200000050000700070000001f0000001c0000001d0000001e0000001b000000")
