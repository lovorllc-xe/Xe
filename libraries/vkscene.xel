        text := str.append(text, "03022307000001000b000d00360000000000000011000200010000000b00060001000000474c534c2e7374642e343530")
        text := str.append(text, "000000000e00030000000000010000000f000b0000000000040000006d61696e000000000d0000001900000024000000")
        text := str.append(text, "2500000027000000330000000300030002000000c201000004000a00474c5f474f4f474c455f6370705f7374796c655f")
        text := str.append(text, "6c696e655f646972656374697665000004000800474c5f474f4f474c455f696e636c7564655f64697265637469766500")
        text := str.append(text, "05000400040000006d61696e00000000050006000b000000676c5f50657256657274657800000000060006000b000000")
        text := str.append(text, "00000000676c5f506f736974696f6e00060007000b00000001000000676c5f506f696e7453697a650000000006000700")
