// vkscene: GPU-rendered 3D scenes with Vulkan, ready to use. It bundles lit vertex/fragment shaders, uploads
// `gfx3d` meshes to the GPU, and draws them with a z-buffer into an offscreen target that you copy into a
// `canvas` (to show with `window`) or save with `image`.
//
//     var vk: *vulkan.Vulkan := vulkan.open("game")
//     var scene: *vkscene.Scene := vkscene.new(vk, 640, 420)
//     var cube: *vkscene.Model := vkscene.model(vk, gfx3d.mesh_cube(1.0), 0.9, 0.4, 0.3)
//     // every frame:
//     vkscene.start(scene, 0.05, 0.06, 0.1)
//     vkscene.draw(scene, cube, model_matrix, camera_position_x, y, z, target_x, y, z, 60.0)
//     vkscene.finish(scene)
//     vkscene.to_canvas(scene, win.canvas)
uses vulkan
uses gfx3d
uses canvas

module vkscene
begin
    type Scene: record
    begin
        vk: *vulkan.Vulkan
        target: *vulkan.Target
        pipeline: *vulkan.Pipeline
        push: *void
        width: int
        height: int
    end

    type Model: record
    begin
        vertices: *vulkan.Buffer
        count: int
    end

    fn hex_digit(c: int): int
    begin
        if c >= 97 { return c - 87 }
        return c - 48
    end

    // Decodes a hex string into raw memory; returns the byte size through size_out[0].
    fn decode(text: string, size_out: *[1]int): *void
    begin
        var bytes: int := str.length(text) / 2
        var data: *void := alloc(bytes + 16)
        var i: int := 0
        while i < bytes {
            runtime.hw.write8(data + i, hex_digit(str.char(text, i * 2)) * 16 + hex_digit(str.char(text, i * 2 + 1)))
            i := i + 1
        }
        (*size_out)[0] := bytes
        return data
    end

