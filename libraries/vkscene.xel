        text := str.append(text, "02000000480005000b000000000000000b00000000000000480005000b000000010000000b0000000100000048000500")
        text := str.append(text, "0b000000020000000b00000003000000480005000b000000030000000b00000004000000470003001100000002000000")
        text := str.append(text, "480004001100000000000000050000004800050011000000000000000700000010000000480005001100000000000000")
        text := str.append(text, "230000000000000048000400110000000100000005000000480005001100000001000000070000001000000048000500")
        text := str.append(text, "1100000001000000230000004000000047000400190000001e0000000000000047000400240000001e00000000000000")
