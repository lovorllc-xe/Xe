// canvas: a software pixel surface with 2D drawing - lines, rectangles, circles, triangles,
// bitmap text, blitting with transparency and alpha blending. Colors are ints 0xRRGGBB.
// Pair it with `window` (to show it), `image` (to save it) and `gui` (widgets).

module canvas
begin
    type Canvas: record
    begin
        width: int
        height: int
        pixels: *[268435456]int
        font: *[1400]int
        clip_x0: int
        clip_y0: int
        clip_x1: int
        clip_y1: int
    end

    fn rgb(r: int, g: int, b: int): int
    begin
        return ((r & 255) << 16) | ((g & 255) << 8) | (b & 255)
    end

    fn red(color: int): int
    begin
        return (color >> 16) & 255
    end

    fn green(color: int): int
    begin
        return (color >> 8) & 255
    end

    fn blue(color: int): int
    begin
        return color & 255
    end

    fn mix(a: int, b: int, amount: int): int
    begin
        // amount 0..255: 0 gives a, 255 gives b
        var inverse: int := 255 - amount
        var r: int := (red(a) * inverse + red(b) * amount) / 255
        var g: int := (green(a) * inverse + green(b) * amount) / 255
        var bl: int := (blue(a) * inverse + blue(b) * amount) / 255
        return rgb(r, g, bl)
    end

    fn hex_digit(c: int): int
    begin
        if c >= 97 { return c - 87 }
        return c - 48
    end

    fn load_glyph(font: *[1400]int, glyph: int, hex: string)
    begin
        var row: int := 0
        while row < 14 {
            (*font)[glyph * 14 + row] := hex_digit(str.char(hex, row * 2)) * 16 + hex_digit(str.char(hex, row * 2 + 1))
            row := row + 1
        }
    end

    fn load_font(font: *[1400]int)
    begin
        load_glyph(font, 0, "0000000000000000000000000000")
        load_glyph(font, 1, "0000001818181818180018180000")
        load_glyph(font, 2, "0000002424242400000000000000")
        load_glyph(font, 3, "00001212147f2424fe6848480000")
        load_glyph(font, 4, "000000003c6840381c02463c0000")
        load_glyph(font, 5, "00000070909076186e0b0b0e0000")
        load_glyph(font, 6, "0000003c60203059cbc6463a0000")
        load_glyph(font, 7, "0000001818181800000000000000")
        load_glyph(font, 8, "0008081810101010101018080800")
        load_glyph(font, 9, "0030101808080808080818103000")
        load_glyph(font, 10, "0000001052383852100000000000")
        load_glyph(font, 11, "00000000181818fe181818000000")
        load_glyph(font, 12, "0000000000000000000018181010")
        load_glyph(font, 13, "00000000000000003c0000000000")
        load_glyph(font, 14, "0000000000000000000018180000")
        load_glyph(font, 15, "00000006040c0808101030206040")
        load_glyph(font, 16, "0000003c6446425a4246643c0000")
        load_glyph(font, 17, "00000078080808080808083e0000")
        load_glyph(font, 18, "0000003c4406040c1830607e0000")
        load_glyph(font, 19, "0000003c4406043c0606463c0000")
        load_glyph(font, 20, "0000000c1c142464447e04040000")
        load_glyph(font, 21, "0000007c60607c04060644380000")
        load_glyph(font, 22, "0000003c60407c664242663c0000")
        load_glyph(font, 23, "0000007e06040c08181810300000")
        load_glyph(font, 24, "0000003c6646643c6642663c0000")
        load_glyph(font, 25, "0000003c644646663e0604380000")
        load_glyph(font, 26, "0000000000181800000018180000")
        load_glyph(font, 27, "0000000000181800000018181010")
        load_glyph(font, 28, "0000000000021c60601c02000000")
        load_glyph(font, 29, "000000000000fe0000fe00000000")
        load_glyph(font, 30, "000000000040380e0e3840000000")
        load_glyph(font, 31, "0000003c06060c18100010100000")
        load_glyph(font, 32, "0000003c6242cf939393cf40601c")
        load_glyph(font, 33, "00000018183c2c24667e42c20000")
        load_glyph(font, 34, "0000007c4646467c4642467c0000")
        load_glyph(font, 35, "0000001c226040404060221c0000")
        load_glyph(font, 36, "0000007844464242424644780000")
        load_glyph(font, 37, "0000007e6060607e6060607e0000")
        load_glyph(font, 38, "0000007e6060607e606060600000")
        load_glyph(font, 39, "0000003c6240404e4242623c0000")
