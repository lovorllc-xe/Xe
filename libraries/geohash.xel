// geohash: encode and decode latitude/longitude as geohash strings; great-circle distance.
uses mathx

module geohash
begin
    fn alphabet(): string
    begin
        return "0123456789bcdefghjkmnpqrstuvwxyz"
    end

    fn encode(lat: flt, lon: flt, precision: int): string
    begin
        var latLow: flt := -90.0
        var latHigh: flt := 90.0
        var lonLow: flt := -180.0
        var lonHigh: flt := 180.0
        var out: string := str.builder("")
        var bit: int := 0
        var value: int := 0
        var even: int := 1
        while str.length(out) < precision {
            if even = 1 {
                var mid: flt := (lonLow + lonHigh) / 2.0
                if lon >= mid {
                    value := value * 2 + 1
                    lonLow := mid
                }
                else {
                    value := value * 2
                    lonHigh := mid
                }
            }
            else {
                var mid2: flt := (latLow + latHigh) / 2.0
                if lat >= mid2 {
                    value := value * 2 + 1
                    latLow := mid2
                }
                else {
                    value := value * 2
                    latHigh := mid2
                }
            }
            even := 1 - even
            bit := bit + 1
            if bit = 5 {
                out := str.append(out, str.slice(alphabet(), value, value + 1))
                bit := 0
                value := 0
            }
        }
        return out
    end

    // Returns [latitude, longitude] of the cell center.
    fn decode(hash: string): [2]flt
    begin
        var result: [2]flt
        var latLow: flt := -90.0
        var latHigh: flt := 90.0
        var lonLow: flt := -180.0
        var lonHigh: flt := 180.0
        var even: int := 1
        var i: int := 0
        while i < str.length(hash) {
            var value: int := 0
            var k: int := 0
            while k < 32 {
                if str.char(alphabet(), k) = str.char(hash, i) { value := k }
                k := k + 1
            }
            var bit: int := 4
            while bit >= 0 {
                var on: int := (value >> bit) & 1
                if even = 1 {
                    var mid: flt := (lonLow + lonHigh) / 2.0
                    if on = 1 { lonLow := mid }
                    else { lonHigh := mid }
                }
                else {
                    var mid2: flt := (latLow + latHigh) / 2.0
                    if on = 1 { latLow := mid2 }
                    else { latHigh := mid2 }
                }
                even := 1 - even
                bit := bit - 1
            }
            i := i + 1
        }
        result[0] := (latLow + latHigh) / 2.0
        result[1] := (lonLow + lonHigh) / 2.0
        return result
    end

    // Haversine distance in meters.
    fn distance(lat1: flt, lon1: flt, lat2: flt, lon2: flt): flt
    begin
        var dLat: flt := mathx.radians(lat2 - lat1)
        var dLon: flt := mathx.radians(lon2 - lon1)
        var a: flt := mathx.sin(dLat / 2.0) * mathx.sin(dLat / 2.0) + mathx.cos(mathx.radians(lat1)) * mathx.cos(mathx.radians(lat2)) * mathx.sin(dLon / 2.0) * mathx.sin(dLon / 2.0)
        return 12742000.0 * mathx.asin(mathx.sqrt(a))
    end

    fn bearing(lat1: flt, lon1: flt, lat2: flt, lon2: flt): flt
    begin
        var dLon: flt := mathx.radians(lon2 - lon1)
        var y: flt := mathx.sin(dLon) * mathx.cos(mathx.radians(lat2))
        var x: flt := mathx.cos(mathx.radians(lat1)) * mathx.sin(mathx.radians(lat2)) - mathx.sin(mathx.radians(lat1)) * mathx.cos(mathx.radians(lat2)) * mathx.cos(dLon)
        var degrees: flt := mathx.degrees(mathx.atan2(y, x))
        if degrees < 0.0 { degrees := degrees + 360.0 }
        return degrees
    end
end
