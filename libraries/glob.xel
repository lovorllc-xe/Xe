// glob: shell-style wildcard matching (* ? [abc] [a-z] [!x] and \ escapes).
module glob
begin
    fn class_match(pattern: string, start: int, value: int): [2]int
    begin
        var result: [2]int
        var index: int := start + 1
        var negate: int := 0
        var size: int := str.length(pattern)
        if index < size && (str.char(pattern, index) = 33 || str.char(pattern, index) = 94) {
            negate := 1
            index := index + 1
        }
        var matched: int := 0
        var first: int := 1
        while index < size && (str.char(pattern, index) != 93 || first = 1) {
            var low: int := str.char(pattern, index)
            var high: int := low
            if index + 2 < size && str.char(pattern, index + 1) = 45 && str.char(pattern, index + 2) != 93 {
                high := str.char(pattern, index + 2)
                index := index + 2
            }
            if value >= low && value <= high { matched := 1 }
            index := index + 1
            first := 0
        }
        if negate = 1 { matched := 1 - matched }
        result[0] := matched
        result[1] := index + 1
        return result
    end

    fn match_from(pattern: string, p: int, text: string, t: int): int
    begin
        var pi: int := p
        var ti: int := t
        var psize: int := str.length(pattern)
        var tsize: int := str.length(text)
        while pi < psize {
            var c: int := str.char(pattern, pi)
            if c = 42 {
                while pi < psize && str.char(pattern, pi) = 42 { pi := pi + 1 }
                if pi = psize { return 1 }
                var k: int := ti
                while k <= tsize {
                    if match_from(pattern, pi, text, k) = 1 { return 1 }
                    k := k + 1
                }
                return 0
            }
            if ti >= tsize { return 0 }
            if c = 63 {
                pi := pi + 1
                ti := ti + 1
            }
            else {
                if c = 91 {
                    var result: [2]int := class_match(pattern, pi, str.char(text, ti))
                    if result[0] = 0 { return 0 }
                    pi := result[1]
                    ti := ti + 1
                }
                else {
                    if c = 92 && pi + 1 < psize {
                        pi := pi + 1
                        c := str.char(pattern, pi)
                    }
                    if c != str.char(text, ti) { return 0 }
                    pi := pi + 1
                    ti := ti + 1
                }
            }
        }
        return ti = tsize
    end

    fn match(pattern: string, text: string): int
    begin
        return match_from(pattern, 0, text, 0)
    end

    fn has_magic(pattern: string): int
    begin
        var index: int := 0
        while index < str.length(pattern) {
            var c: int := str.char(pattern, index)
            if c = 42 || c = 63 || c = 91 { return 1 }
            index := index + 1
        }
        return 0
    end
end
