// strset: a set of strings built on strintmap.
uses strintmap

module strset
begin
    fn new(): *strintmap.Map
    begin
        return strintmap.new()
    end

    fn add(set: *strintmap.Map, value: string): int
    begin
        if strintmap.has(set, value) = 1 { return 0 }
        strintmap.put(set, value, 1)
        return 1
    end

    fn has(set: *strintmap.Map, value: string): int
    begin
        return strintmap.has(set, value)
    end

    fn remove(set: *strintmap.Map, value: string): int
    begin
        return strintmap.remove(set, value)
    end

    fn len(set: *strintmap.Map): int
    begin
        return strintmap.len(set)
    end

    fn union(left: *strintmap.Map, right: *strintmap.Map): *strintmap.Map
    begin
        var result: *strintmap.Map := strintmap.new()
        var slot: int := 0
        while slot < strintmap.capacity(left) {
            if strintmap.occupied(left, slot) = 1 { strintmap.put(result, strintmap.key_at(left, slot), 1) }
            slot := slot + 1
        }
        slot := 0
        while slot < strintmap.capacity(right) {
            if strintmap.occupied(right, slot) = 1 { strintmap.put(result, strintmap.key_at(right, slot), 1) }
            slot := slot + 1
        }
        return result
    end

    fn intersection(left: *strintmap.Map, right: *strintmap.Map): *strintmap.Map
    begin
        var result: *strintmap.Map := strintmap.new()
        var slot: int := 0
        while slot < strintmap.capacity(left) {
            if strintmap.occupied(left, slot) = 1 {
                if strintmap.has(right, strintmap.key_at(left, slot)) = 1 { strintmap.put(result, strintmap.key_at(left, slot), 1) }
            }
            slot := slot + 1
        }
        return result
    end
end
