// window: open a window (Linux X11 or Wayland, Windows, macOS: the same code on every platform), draw into its canvas, read the keyboard and mouse.
// The loop of every GUI app or game looks like:
//     var win: *window.Window := window.open("title", 640, 480)
//     while window.is_open(win) {
//         window.poll(win)                       // events -> key_down, mouse_x, ...
//         canvas.clear(win.canvas, canvas.rgb(0, 0, 0))
//         ...draw on win.canvas...
//         window.present(win)                    // show it
//         window.limit_fps(win, 60)
//     }
uses wevent
uses native
uses canvas
uses clock

module window
begin
    type Window: record
    begin
        native: *native.Window
        backend: int
        canvas: *canvas.Canvas
        width: int
        height: int
        is_open: int
        mouse_x: int
        mouse_y: int
        buttons: int
        pressed: int
        released: int
        wheel: int
        resized: int
        keys: *[1024]int
        edges: *[1024]int
        keycode_symbol: *[256]int
        typed: *[64]int
        typed_count: int
        event: *wevent.Event
        last_frame: int
        delta_ns: int
        fps_count: int
        fps_time: int
        fps: int
    end

    fn key_escape(): int
    begin
        return 256 + 27
    end

    fn key_enter(): int
    begin
        return 256 + 13
    end

    fn key_backspace(): int
    begin
        return 256 + 8
    end

    fn key_tab(): int
    begin
        return 256 + 9
    end

    fn key_delete(): int
    begin
        return 256 + 255
    end

    fn key_home(): int
    begin
        return 256 + 80
    end

    fn key_left(): int
    begin
        return 256 + 81
    end

    fn key_up(): int
    begin
        return 256 + 82
    end

    fn key_right(): int
    begin
        return 256 + 83
    end

    fn key_down_arrow(): int
    begin
        return 256 + 84
    end

    fn key_end(): int
    begin
        return 256 + 87
    end

    fn key_shift(): int
    begin
        return 256 + 225
    end

    fn key_control(): int
    begin
        return 256 + 227
    end

    fn key_alt(): int
    begin
        return 256 + 233
    end

    fn key_space(): int
    begin
        return 32
    end

    fn key_f(n: int): int
    begin
        return 256 + 190 + n - 1
    end

    // Letters are lowercase ('a' = 97) regardless of shift.
    fn key_index(symbol: int): int
    begin
        if symbol >= 65 && symbol <= 90 { return symbol + 32 }
        if symbol > 0 && symbol < 256 { return symbol }
        if (symbol & 65280) = 65280 { return 256 + (symbol & 255) }
        return 1023
    end

    // Which backend a window uses: 1 = Wayland, 2 = X11 (Linux), 3 = Win32, 4 = Cocoa.
    fn backend(win: *window.Window): int
    begin
        return win.backend
    end

    fn next_event(win: *window.Window, timeout_ms: int): int
    begin
        return native.next_event(win.native, win.event, timeout_ms)
    end

    // What a graphics API needs to draw into this window: native_kind 1 = X11 window, 2 = Win32 window, 0 = none;
    // native_handle is the window id / HWND. Used by vkwindow.
    fn native_kind(win: *window.Window): int
    begin
        return native.window_kind(win.native)
    end

    fn native_handle(win: *window.Window): int
    begin
        return native.window_handle(win.native)
    end

    // The color of one window pixel as 0xRRGGBB, or -1 when the platform cannot read it back.
    fn read_pixel(win: *window.Window, x: int, y: int): int
    begin
        return native.read_pixel(win.native, x, y)
    end

    fn open(title: string, width: int, height: int): *window.Window
    begin
        return open_with(title, width, height, 0)
    end

    // Linux: prefer native Wayland over X11 for this window (same as XE_BACKEND=wayland).
    fn open_wayland(title: string, width: int, height: int): *window.Window
    begin
        return open_with(title, width, height, 1)
    end

    fn open_with(title: string, width: int, height: int, prefer_wayland: int): *window.Window
    begin
        var none: *window.Window
        var n: *native.Window := native.open(title, width, height, prefer_wayland)
        if @n = 0 { return none }
        var win: *window.Window := alloc(320)
        runtime.mem.set(win, 0, 320)
        win.native := n
        win.backend := native.backend(n)
        win.width := width
        win.height := height
        win.canvas := canvas.new(width, height)
        win.is_open := 1
        win.keys := alloc(1024 * 8)
        win.edges := alloc(1024 * 8)
        win.keycode_symbol := alloc(256 * 8)
        win.typed := alloc(64 * 8)
        win.typed_count := 0
        win.event := alloc(64)
        runtime.mem.set(win.event, 0, 64)
        var i: int := 0
        while i < 1024 {
            (*win.keys)[i] := 0
            (*win.edges)[i] := 0
            i := i + 1
        }
        i := 0
        while i < 256 {
            (*win.keycode_symbol)[i] := 0
            i := i + 1
        }
        win.last_frame := clock.monotonic()
        win.fps_time := win.last_frame
        win.fps_count := 0
        win.fps := 0
        win.delta_ns := 16666667
        // wait for the window to be shown so the first frame is not lost
        var waited: int := 0
        var exposed: int := 0
        while waited < 50 && exposed = 0 {
            var kind: int := next_event(win, 50)
            if kind = wevent.kind_expose() { exposed := 1 }
            if kind = wevent.kind_resize() { handle(win, kind) }
            waited := waited + 1
        }
        // let the window manager finish placing/resizing it, so the first frame is not wiped
        var kind: int := next_event(win, 60)
        while kind != 0 {
            handle(win, kind)
            kind := next_event(win, 60)
        }
        fit_canvas(win)
        return win
    end

    // Like open, but asks the window manager not to resize the window.
    fn open_fixed(title: string, width: int, height: int): *window.Window
    begin
        var win: *window.Window := open(title, width, height)
        if @win != 0 { native.fix_size(win.native, width, height) }
        return win
    end

    fn close(win: *window.Window)
    begin
        win.is_open := 0
    end

    fn is_open(win: *window.Window): int
    begin
        return win.is_open
    end

    fn destroy(win: *window.Window)
    begin
        native.close(win.native)
        canvas.release(win.canvas)
        free(win.keys)
        free(win.edges)
        free(win.keycode_symbol)
        free(win.typed)
        free(win.event)
        free(win)
    end

    fn queue_char(win: *window.Window, code: int)
    begin
        if win.typed_count < 64 {
            (*win.typed)[win.typed_count] := code
            win.typed_count := win.typed_count + 1
        }
    end

    fn handle(win: *window.Window, kind: int)
    begin
        var ev: *wevent.Event := win.event
        if kind = wevent.kind_key_down() {
            var symbol: int := ev.a
            (*win.keycode_symbol)[ev.b] := symbol
            var index: int := key_index(symbol)
            if (*win.keys)[index] = 0 { (*win.edges)[index] := 1 }
            (*win.keys)[index] := 1
            // flags 2: the backend knows the typed character (ev.d, 0 for none), for example from the keymap
            if ev.flags = 2 && ev.d >= 32 { queue_char(win, ev.d) }
            if ev.flags = 0 || ev.flags = 2 {
                if ev.flags = 0 && symbol >= 32 && symbol <= 126 { queue_char(win, symbol) }
                if symbol = 65293 { queue_char(win, 10) }
                if symbol = 65288 { queue_char(win, 8) }
                if symbol = 65289 { queue_char(win, 9) }
            }
        }
        if kind = wevent.kind_key_up() {
            var symbol: int := (*win.keycode_symbol)[ev.b]
            if symbol = 0 { symbol := ev.a }
            (*win.keys)[key_index(symbol)] := 0
        }
        if kind = wevent.kind_mouse_down() {
            win.mouse_x := ev.b
            win.mouse_y := ev.c
            if ev.a = 4 { win.wheel := win.wheel + 1 }
            if ev.a = 5 { win.wheel := win.wheel - 1 }
            if ev.a <= 3 {
                var mask: int := 1 << (ev.a - 1)
                win.buttons := win.buttons | mask
                win.pressed := win.pressed | mask
            }
        }
        if kind = wevent.kind_mouse_up() {
            win.mouse_x := ev.b
            win.mouse_y := ev.c
            if ev.a <= 3 {
                var mask: int := 1 << (ev.a - 1)
                win.buttons := win.buttons & ~mask
                win.released := win.released | mask
            }
        }
        if kind = wevent.kind_motion() {
            win.mouse_x := ev.b
            win.mouse_y := ev.c
        }
        if kind = wevent.kind_resize() {
            if ev.b != win.width || ev.c != win.height { win.resized := 1 }
            win.width := ev.b
            win.height := ev.c
        }
        if kind = wevent.kind_char() { queue_char(win, ev.a) }
        if kind = wevent.kind_close() { win.is_open := 0 }
    end

    // Process all pending events and clear the per-frame state (pressed/released/wheel).
    fn poll(win: *window.Window)
    begin
        var i: int := 0
        while i < 1024 {
            (*win.edges)[i] := 0
            i := i + 1
        }
        win.pressed := 0
        win.released := 0
        win.wheel := 0
        win.resized := 0
        var kind: int := next_event(win, 0)
        while kind != 0 {
            handle(win, kind)
            kind := next_event(win, 0)
        }
    end

    // Like poll, but waits up to timeout_ms for something to happen (for apps that only redraw on input).
    fn wait_event(win: *window.Window, timeout_ms: int)
    begin
        var kind: int := next_event(win, timeout_ms)
        if kind != 0 { handle(win, kind) }
        poll_rest(win)
    end

    fn poll_rest(win: *window.Window)
    begin
        var kind: int := next_event(win, 0)
        while kind != 0 {
            handle(win, kind)
            kind := next_event(win, 0)
        }
    end

    // After the window was resized: make the canvas match the new window size.
    fn fit_canvas(win: *window.Window)
    begin
        if win.canvas.width != win.width || win.canvas.height != win.height {
            canvas.release(win.canvas)
            win.canvas := canvas.new(win.width, win.height)
        }
        win.resized := 0
    end

    fn present(win: *window.Window)
    begin
        native.present(win.native, win.canvas.pixels, win.canvas.width, win.canvas.width, win.canvas.height)
    end

    fn key_down(win: *window.Window, key: int): int
    begin
        return (*win.keys)[key_index(key)]
    end

    fn key_pressed(win: *window.Window, key: int): int
    begin
        return (*win.edges)[key_index(key)]
    end

    // 1 = left, 2 = middle, 3 = right
    fn mouse_down(win: *window.Window, button: int): int
    begin
        if (win.buttons & (1 << (button - 1))) != 0 { return 1 }
        return 0
    end

    fn mouse_pressed(win: *window.Window, button: int): int
    begin
        if (win.pressed & (1 << (button - 1))) != 0 { return 1 }
        return 0
    end

    fn mouse_released(win: *window.Window, button: int): int
    begin
        if (win.released & (1 << (button - 1))) != 0 { return 1 }
        return 0
    end

    // Next typed character (as a character code, 8 = backspace, 10 = enter), or 0 when none is waiting.
    fn typed_char(win: *window.Window): int
    begin
        if win.typed_count = 0 { return 0 }
        var code: int := (*win.typed)[0]
        var i: int := 1
        while i < win.typed_count {
            (*win.typed)[i - 1] := (*win.typed)[i]
            i := i + 1
        }
        win.typed_count := win.typed_count - 1
        return code
    end

    // Sleep so the loop runs at about `fps` frames per second; updates delta_time() and fps().
    fn limit_fps(win: *window.Window, fps: int)
    begin
        var now: int := clock.monotonic()
        var target: int := 1000000000 / fps
        var spent: int := now - win.last_frame
        if spent < target { clock.sleep_ns(target - spent) }
        var after: int := clock.monotonic()
        win.delta_ns := after - win.last_frame
        win.last_frame := after
        win.fps_count := win.fps_count + 1
        if after - win.fps_time >= 1000000000 {
            win.fps := win.fps_count
            win.fps_count := 0
            win.fps_time := after
        }
    end

    // Seconds the last frame took.
    fn delta_time(win: *window.Window): flt
    begin
        return win.delta_ns / 1000000000.0
    end

    fn fps(win: *window.Window): int
    begin
        return win.fps
    end

    // Milliseconds since the program started using the window clock.
    fn time_ms(): int
    begin
        return clock.monotonic() / 1000000
    end
end
