    fn call10(target: int, a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, i: int, j: int): int
    begin
        asm {
            mov rax, rdi
            mov r10, rsi
            mov r11, rdx
            and rsp, -16
            sub rsp, 80
            mov qword ptr [rsp+32], r9
            mov r9, r8
            mov r8, rcx
            mov rcx, r10
            mov rdx, r11
            mov r10, qword ptr [rbp+16]
            mov qword ptr [rsp+40], r10
            mov r10, qword ptr [rbp+24]
            mov qword ptr [rsp+48], r10
            mov r10, qword ptr [rbp+32]
            mov qword ptr [rsp+56], r10
            mov r10, qword ptr [rbp+40]
            mov qword ptr [rsp+64], r10
            mov r10, qword ptr [rbp+48]
            mov qword ptr [rsp+72], r10
            call rax
            leave
            ret
        }
        return 0
    end

    // Address of the first byte of a string (Xe strings are NUL terminated, so they are valid C strings).
    fn cstr(text: string): int
    begin
        var holder: *[1]string := alloc(16)
        (*holder)[0] := text
        var raw: *void := holder
        var address: int := runtime.hw.read32(raw) & 4294967295
        address := address | ((runtime.hw.read32(raw + 4) & 4294967295) << 32)
        free(holder)
        return address
    end

    fn convention(): string
    begin
        return "ms"
    end

    fn loadlibrary_address(): int
    begin
        asm {
            mov rax, qword ptr [rip+__imp_LoadLibraryA]
            leave
            ret
        }
        return 0
    end

    fn getprocaddress_address(): int
    begin
        asm {
            mov rax, qword ptr [rip+__imp_GetProcAddress]
            leave
            ret
        }
        return 0
    end

    // Loads a DLL ("vulkan-1.dll"); returns its handle, or 0 when it cannot be loaded.
    fn open_library(name: string): int
    begin
        return call1(loadlibrary_address(), cstr(name))
    end

    // Address of a function in a loaded DLL, or 0.
    fn symbol(library: int, name: string): int
    begin
        if library = 0 { return 0 }
        return call2(getprocaddress_address(), library, cstr(name))
    end
end
