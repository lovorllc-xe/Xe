// ccall (Windows): calls C functions with the Windows x64 calling convention and loads DLLs at run time
// (LoadLibraryA/GetProcAddress). The platform half of `ffi`, chosen for -p win.

module ccall
begin
    fn call0(target: int): int
    begin
        asm {
            mov rax, rdi
            mov r10, rsi
            mov r11, rdx
            and rsp, -16
            sub rsp, 80
            mov qword ptr [rsp+32], r9
            mov r9, r8
            mov r8, rcx
            mov rcx, r10
            mov rdx, r11
            mov r10, qword ptr [rbp+16]
            mov qword ptr [rsp+40], r10
            mov r10, qword ptr [rbp+24]
            mov qword ptr [rsp+48], r10
            mov r10, qword ptr [rbp+32]
            mov qword ptr [rsp+56], r10
            mov r10, qword ptr [rbp+40]
            mov qword ptr [rsp+64], r10
            mov r10, qword ptr [rbp+48]
            mov qword ptr [rsp+72], r10
            call rax
            leave
            ret
        }
        return 0
    end

