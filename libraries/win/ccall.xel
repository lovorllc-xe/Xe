            .balign 64
        .LxeCbThunk30:
            push rbp
            mov rbp, rsp
            push rdi
            push rsi
            mov rdi, rcx
            mov rsi, rdx
            mov rdx, r8
            mov rcx, r9
            mov r8, qword ptr [rbp+48]
            mov r9, qword ptr [rbp+56]
            mov rax, qword ptr [rip+.LxeCbTargets+240]
            call rax
            pop rsi
            pop rdi
            pop rbp
            ret
            .balign 64
        .LxeCbThunk31:
            push rbp
            mov rbp, rsp
            push rdi
            push rsi
            mov rdi, rcx
            mov rsi, rdx
            mov rdx, r8
            mov rcx, r9
            mov r8, qword ptr [rbp+48]
            mov r9, qword ptr [rbp+56]
            mov rax, qword ptr [rip+.LxeCbTargets+248]
            call rax
            pop rsi
            pop rdi
            pop rbp
            ret
        }
        return 0
    end

    fn callback(target: int): int
    begin
        var table: *void := cast.ptr(callback_table())
        var slot: int := 0
        while slot < 32 {
            var current: int := runtime.hw.read32(table + slot * 8) | (runtime.hw.read32(table + slot * 8 + 4) << 32)
            if current = target || current = 0 {
                runtime.hw.write32(table + slot * 8, target & 4294967295)
                runtime.hw.write32(table + slot * 8 + 4, (target >> 32) & 4294967295)
                return callback_thunks() + slot * 64
            }
            slot := slot + 1
        }
        return 0
    end

    fn loadlibrary_address(): int
    begin
        asm {
            mov rax, qword ptr [rip+__imp_LoadLibraryA]
            leave
            ret
        }
        return 0
    end

    fn getprocaddress_address(): int
    begin
        asm {
            mov rax, qword ptr [rip+__imp_GetProcAddress]
            leave
            ret
        }
        return 0
    end

    // Loads a DLL ("vulkan-1.dll"); returns its handle, or 0 when it cannot be loaded.
    fn open_library(name: string): int
    begin
        return call1(loadlibrary_address(), cstr(name))
    end

    // Address of a function in a loaded DLL, or 0.
    fn symbol(library: int, name: string): int
    begin
        if library = 0 { return 0 }
        return call2(getprocaddress_address(), library, cstr(name))
    end
end
