    // Address of the first byte of a string (Xe strings are NUL terminated, so they are valid C strings).
    fn cstr(text: string): int
    begin
        var holder: *[1]string := alloc(16)
        (*holder)[0] := text
        var raw: *void := holder
        var address: int := runtime.hw.read32(raw) & 4294967295
        address := address | ((runtime.hw.read32(raw + 4) & 4294967295) << 32)
        free(holder)
        return address
    end

    fn convention(): string
    begin
        return "ms"
    end

    // ---- callbacks: C code calls a thunk with the Windows convention, the thunk calls the Xe function with the
    // System V convention (rdi, rsi, rdx, rcx, r8, r9) that Xe uses. 32 thunks, 64 bytes apart.
    fn callback_table(): int
    begin
        asm {
            lea rax, [rip+.LxeCbTargets]
            leave
            ret
            .data
            .balign 8
        .LxeCbTargets:
            .skip 256
            .text
        }
        return 0
    end

    fn callback_thunks(): int
    begin
        asm {
            lea rax, [rip+.LxeCbThunk0]
            leave
            ret
            .balign 64
        .LxeCbThunk0:
            push rbp
            mov rbp, rsp
            push rdi
            push rsi
            mov rdi, rcx
            mov rsi, rdx
            mov rdx, r8
            mov rcx, r9
            mov r8, qword ptr [rbp+48]
            mov r9, qword ptr [rbp+56]
            mov rax, qword ptr [rip+.LxeCbTargets+0]
            call rax
            pop rsi
            pop rdi
            pop rbp
            ret
