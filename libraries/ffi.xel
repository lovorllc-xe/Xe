// ffi: call C functions in shared libraries and build C structs in raw memory, the same way on every platform.
//
//     var lib: int := ffi.library("libvulkan.so.1")          // vulkan-1.dll on Windows, libvulkan.1.dylib on macOS
//     var f: int := ffi.symbol(lib, "vkGetInstanceProcAddr")
//     var result: int := ffi.call2(f, 0, ffi.cstr("vkCreateInstance"))
//
// call0..call10 pass up to 10 integer/pointer arguments with the platform's C calling convention (System V on
// Linux and macOS, Microsoft x64 on Windows; the compiler picks the right `ccall` for -p) and return rax.
// A library can also link a shared object at build time with a line comment "xe-link: NAME" (Linux only).
uses ccall

module ffi
begin
    fn call0(target: int): int
    begin
        return ccall.call0(target)
    end

    fn call1(target: int, a: int): int
    begin
        return ccall.call1(target, a)
    end

    fn call2(target: int, a: int, b: int): int
    begin
        return ccall.call2(target, a, b)
    end

    fn call3(target: int, a: int, b: int, c: int): int
    begin
        return ccall.call3(target, a, b, c)
    end

    fn call4(target: int, a: int, b: int, c: int, d: int): int
    begin
        return ccall.call4(target, a, b, c, d)
    end

    fn call5(target: int, a: int, b: int, c: int, d: int, e: int): int
    begin
        return ccall.call5(target, a, b, c, d, e)
    end

    fn call6(target: int, a: int, b: int, c: int, d: int, e: int, f: int): int
    begin
        return ccall.call6(target, a, b, c, d, e, f)
    end

    fn call8(target: int, a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int): int
    begin
        return ccall.call8(target, a, b, c, d, e, f, g, h)
    end

    fn call10(target: int, a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int, i: int, j: int): int
    begin
        return ccall.call10(target, a, b, c, d, e, f, g, h, i, j)
    end

    // Loads a shared library at run time (libfoo.so.1 / foo.dll / libfoo.dylib); 0 when it cannot be loaded.
    fn library(name: string): int
    begin
        return ccall.open_library(name)
    end

    // Address of a function in a library returned by ffi.library, or 0.
    fn symbol(library_handle: int, name: string): int
    begin
        return ccall.symbol(library_handle, name)
    end

    // Makes an Xe function callable from C (for callbacks such as qsort comparators or g_signal_connect handlers):
    //     fn compare(a: *int, b: *int): int ...
    //     ffi.call4(qsort, cast.addr(values), 5, 8, ffi.callback(&compare))
    // The function must take only int, pointer or string parameters (up to 6) and return an int or pointer. On Linux
    // and macOS the address is used directly (Xe already uses the C calling convention); on Windows a small
    // converting thunk is returned (at most 32 callbacks per program).
    fn callback(function: *void): int
    begin
        return ccall.callback(cast.addr(function))
    end

    // The C calling convention of the platform being built for: "sysv" (Linux, macOS) or "ms" (Windows).
    fn convention(): string
    begin
        return ccall.convention()
    end

    // A C function returning `int` leaves garbage in the upper half of rax; this sign-extends the low 32 bits.
    fn int32(value: int): int
    begin
        var low: int := value & 4294967295
        if low >= 2147483648 { return low - 4294967296 }
        return low
    end

    fn put8(base: *void, offset: int, value: int)
    begin
        runtime.hw.write8(base + offset, value & 255)
    end

    fn put32(base: *void, offset: int, value: int)
    begin
        runtime.hw.write32(base + offset, value & 4294967295)
    end

    fn put64(base: *void, offset: int, value: int)
    begin
        runtime.hw.write32(base + offset, value & 4294967295)
        runtime.hw.write32(base + offset + 4, (value >> 32) & 4294967295)
    end

    fn get8(base: *void, offset: int): int
    begin
        return runtime.hw.read8(base + offset)
    end

    fn get32(base: *void, offset: int): int
    begin
        return runtime.hw.read32(base + offset) & 4294967295
    end

    fn get64(base: *void, offset: int): int
    begin
        return get32(base, offset) | (get32(base, offset + 4) << 32)
    end

    // The IEEE-754 single-precision bit pattern of a flt (what C `float` fields and Vulkan push constants hold).
    fn float32_bits(value: flt): int
    begin
        asm {
            cvtsd2ss xmm0, xmm0
            movd eax, xmm0
            leave
            ret
        }
        return 0
    end

    fn put_float32(base: *void, offset: int, value: flt)
    begin
        put32(base, offset, float32_bits(value))
    end

    // Zero-filled block of raw memory for a C struct.
    fn block(size: int): *void
    begin
        var p: *void := alloc(size + 16)
        runtime.mem.set(p, 0, size + 16)
        return p
    end

    // Address of the first byte of a string (Xe strings are NUL terminated, so they are valid C strings).
    fn cstr(text: string): int
    begin
        var holder: *[1]string := alloc(16)
        (*holder)[0] := text
        var raw: *void := holder
        var address: int := get64(raw, 0)
        free(holder)
        return address
    end

    // Reads a pointer stored in memory (for example one a C function wrote through a `void **`).
    fn pointer_at(base: *void, offset: int): *void
    begin
        var holder: *[1]*void := base + offset
        return (*holder)[0]
    end

    // Copies a C string at base into an Xe string.
    fn string_at(base: *void, offset: int, limit: int): string
    begin
        var result: string := str.builder("")
        var i: int := 0
        while i < limit && get8(base, offset + i) != 0 {
            result := str.append(result, str.fromchar(get8(base, offset + i)))
            i := i + 1
        }
        return result
    end
end
