// vkloader (linux): where to find the Vulkan loader library on this platform: the Khronos loader that every Linux Vulkan driver (Mesa: Intel, AMD, lavapipe; NVIDIA; ...) plugs into.
// Used by `vulkan`; set XE_VULKAN_LIBRARY to a path to use a different one.
module vkloader
begin
    // Library names to try, separated by ";".
    fn library_names(): string
    begin
        return "libvulkan.so.1;libvulkan.so"
    end
end
