#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) buffer Out { uint pixels[]; };
layout(push_constant) uniform Params { uint width; uint height; float cx; float cy; float zoom; } p;
void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    if (id.x >= p.width || id.y >= p.height) return;
    float x0 = (float(id.x) / float(p.width) - 0.5) * 3.0 / p.zoom + p.cx;
    float y0 = (float(id.y) / float(p.height) - 0.5) * 2.0 / p.zoom + p.cy;
    float x = 0.0, y = 0.0;
    uint i = 0u;
    while (i < 255u && x * x + y * y <= 4.0) {
        float t = x * x - y * y + x0;
        y = 2.0 * x * y + y0;
        x = t;
        i++;
    }
    uint c = (i == 255u) ? 0u : (i * 5u & 255u) << 16 | (i * 2u & 255u) << 8 | (255u - (i * 3u & 255u));
    pixels[id.y * p.width + id.x] = c;
}
