uses vulkan
uses vkscene
uses canvas

fn expect(name: string, ok: int): int
begin
    if ok = 0 {
        writeln("FAIL ", name)
        return 1
    }
    return 0
end

fn load_pipeline(vk: *vulkan.Vulkan, t: *vulkan.Target): *vulkan.Pipeline
begin
    var d: *vulkan.PipelineDesc := vulkan.pipeline_desc()
    var ok: int := vulkan.desc_shaders(d, "tests/shaders/tex.vert.spv", "tests/shaders/tex.frag.spv")
    if ok = 0 { ok := vulkan.desc_shaders(d, "shaders/tex.vert.spv", "shaders/tex.frag.spv") }
    var none: *vulkan.Pipeline
    if ok = 0 { return none }
    d.attributes := 2
    (*d.floats)[0] := 2
    (*d.floats)[1] := 2
    d.uniforms := 1
    d.textures := 1
    return vulkan.pipeline_create(vk, t, d)
end

// Textures and uniform buffers: a quad covering the frame shows a 2x2 texture (nearest filtering) multiplied by a
// tint taken from a uniform buffer.
fn texture_check(vk: *vulkan.Vulkan): int
begin
    var failed: int := 0
    var t: *vulkan.Target := vulkan.target_new(vk, 64, 64, 0)
    var pipe: *vulkan.Pipeline := load_pipeline(vk, t)
    if @pipe = 0 {
        writeln("texture shaders not found: texture checks skipped")
        vulkan.target_free(vk, t)
        return 0
    }
    var pixels: *[268435456]int := alloc(4 * 8)
    (*pixels)[0] := canvas.rgb(255, 0, 0)
    (*pixels)[1] := canvas.rgb(0, 255, 0)
    (*pixels)[2] := canvas.rgb(0, 0, 255)
    (*pixels)[3] := canvas.rgb(255, 255, 255)
    var tex: *vulkan.Texture := vulkan.texture_new(vk, 2, 2, 2)
    failed := failed + expect("texture upload", vulkan.texture_upload(vk, tex, pixels, 2) = 0)
    var tint: *vulkan.Buffer := vulkan.buffer_new_usage(vk, 16, 16)
    vulkan.buffer_float(tint, 0, 1.0)
    vulkan.buffer_float(tint, 4, 1.0)
    vulkan.buffer_float(tint, 8, 1.0)
    vulkan.buffer_float(tint, 12, 1.0)
    var b: *vulkan.Bindings := vulkan.bindings_new(vk, pipe)
    failed := failed + expect("bindings", @b != 0)
    vulkan.bind_uniform(vk, b, 0, tint)
    vulkan.bind_texture(vk, b, 0, tex)
    var quad: *vulkan.Buffer := vulkan.buffer_new_usage(vk, 6 * 16, 128)
    var corners: *[24]flt := alloc(24 * 8)
    (*corners)[0] := -1.0
    (*corners)[1] := -1.0
    (*corners)[2] := 0.0
    (*corners)[3] := 0.0
    (*corners)[4] := 1.0
    (*corners)[5] := -1.0
    (*corners)[6] := 1.0
    (*corners)[7] := 0.0
    (*corners)[8] := 1.0
    (*corners)[9] := 1.0
    (*corners)[10] := 1.0
    (*corners)[11] := 1.0
    (*corners)[12] := -1.0
    (*corners)[13] := -1.0
    (*corners)[14] := 0.0
    (*corners)[15] := 0.0
    (*corners)[16] := 1.0
    (*corners)[17] := 1.0
    (*corners)[18] := 1.0
    (*corners)[19] := 1.0
    (*corners)[20] := -1.0
    (*corners)[21] := 1.0
    (*corners)[22] := 0.0
    (*corners)[23] := 1.0
    var i: int := 0
    while i < 24 {
        vulkan.buffer_float(quad, i * 4, (*corners)[i])
        i := i + 1
    }
    var nothing: *void
    failed := failed + expect("textured frame", vulkan.frame_begin(vk, t, 0.0, 0.0, 0.0) = 0)
    vulkan.frame_draw_with(vk, pipe, b, quad, 6, nothing)
    failed := failed + expect("textured frame end", vulkan.frame_end(vk, t) = 0)
    // Vulkan's y axis points down: texture row 0 (red, green) is at the top of the picture
    failed := failed + expect("texel red", vulkan.pixel(t, 16, 16) = canvas.rgb(255, 0, 0) || vulkan.pixel(t, 16, 48) = canvas.rgb(255, 0, 0))
    failed := failed + expect("texel blue", vulkan.pixel(t, 16, 48) = canvas.rgb(0, 0, 255) || vulkan.pixel(t, 16, 16) = canvas.rgb(0, 0, 255))
    failed := failed + expect("texel green", vulkan.pixel(t, 48, 16) = canvas.rgb(0, 255, 0) || vulkan.pixel(t, 48, 48) = canvas.rgb(0, 255, 0))
    failed := failed + expect("texel white", vulkan.pixel(t, 48, 48) = canvas.rgb(255, 255, 255) || vulkan.pixel(t, 48, 16) = canvas.rgb(255, 255, 255))
    // change the uniform buffer: the next frame is tinted (halve green and blue)
    vulkan.buffer_float(tint, 4, 0.0)
    vulkan.buffer_float(tint, 8, 0.0)
    vulkan.frame_begin(vk, t, 0.0, 0.0, 0.0)
    vulkan.frame_draw_with(vk, pipe, b, quad, 6, nothing)
    vulkan.frame_end(vk, t)
    failed := failed + expect("tint keeps red", vulkan.pixel(t, 16, 16) = canvas.rgb(255, 0, 0) || vulkan.pixel(t, 16, 48) = canvas.rgb(255, 0, 0))
    failed := failed + expect("tint removes green", vulkan.pixel(t, 48, 16) = 0 || vulkan.pixel(t, 48, 48) = 0)
    // mipmapped, smooth texture: a larger one is built and uploaded without errors
    var big: *vulkan.Texture := vulkan.texture_new(vk, 64, 32, 5)
    var big_pixels: *[268435456]int := alloc(64 * 32 * 8)
    var k: int := 0
    while k < 64 * 32 {
        (*big_pixels)[k] := canvas.rgb(k & 255, 128, 64)
        k := k + 1
    }
    failed := failed + expect("mipmapped upload", vulkan.texture_upload(vk, big, big_pixels, 64) = 0)
    vulkan.texture_free(vk, big)
    free(big_pixels)
    vulkan.bindings_free(vk, b)
    vulkan.texture_free(vk, tex)
    vulkan.buffer_free(vk, tint)
    vulkan.buffer_free(vk, quad)
    vulkan.pipeline_free(vk, pipe)
    vulkan.target_free(vk, t)
    free(pixels)
    free(corners)
    return failed
end

// Runs a SPIR-V compute shader (tests/shaders/mandelbrot.spv) on the GPU and checks the result.
fn main(): int
begin
    var failed: int := 0
    var vk: *vulkan.Vulkan := vulkan.open("xe vulkan test")
    if @vk = 0 {
        writeln("no Vulkan device: vulkan checks skipped")
        return 0
    }
    writeln("GPU ", vulkan.device_name(vk), " Vulkan ", vulkan.api_version(vk))
    var w: int := 64
    var h: int := 48
    var out: *vulkan.Buffer := vulkan.buffer_new(vk, w * h * 4)
    failed := failed + expect("buffer", @out != 0)
    var path: string := "tests/shaders/mandelbrot.spv"
    var job: *vulkan.Compute := vulkan.compute_new(vk, path, 1, 20)
    if @job = 0 { job := vulkan.compute_new(vk, "shaders/mandelbrot.spv", 1, 20) }
    if @job = 0 {
        writeln("shader not found next to the tests: dispatch skipped")
        vulkan.close(vk)
        return failed
    }
    vulkan.compute_bind(vk, job, 0, out)
    var push: *void := ffi.block(32)
    ffi.put32(push, 0, w)
    ffi.put32(push, 4, h)
    ffi.put_float32(push, 8, -0.5)
    ffi.put_float32(push, 12, 0.0)
    ffi.put_float32(push, 16, 1.0)
    failed := failed + expect("dispatch", vulkan.compute_run(vk, job, w / 8, h / 8, 1, push) = 0)
    // the centre of the picture (c = -0.5 + 0i) is inside the set -> black, the far corner escapes quickly
    var centre: int := ffi.get32(out.data, ((h / 2) * w + w / 2) * 4)
    var corner: int := ffi.get32(out.data, 0)
    failed := failed + expect("inside the set is black", centre = 0)
    failed := failed + expect("outside the set is colored", corner != 0)
    vulkan.compute_free(vk, job)
    vulkan.buffer_free(vk, out)
    // graphics: a lit cube rendered with the z-buffer; the middle of the frame is covered, the corner is background
    var scene: *vkscene.Scene := vkscene.new(vk, 96, 64)
    failed := failed + expect("scene", @scene != 0)
    if @scene != 0 {
        var cube: *vkscene.Model := vkscene.model(vk, gfx3d.mesh_cube(1.5), 1.0, 0.5, 0.2)
        var identity: *[16]flt := gfx3d.mat4_identity()
        vkscene.start(scene, 0.0, 0.0, 0.0)
        vkscene.draw(scene, cube, identity, 0.0, 0.0, 4.0, 0.0, 0.0, 0.0, 50.0)
        failed := failed + expect("frame", vkscene.finish(scene) = 0)
        failed := failed + expect("cube drawn", vulkan.pixel(scene.target, 48, 32) != 0)
        failed := failed + expect("background kept", vulkan.pixel(scene.target, 2, 2) = 0)
        vkscene.model_free(vk, cube)
        vkscene.release(scene)
    }
    failed := failed + texture_check(vk)
    vulkan.close(vk)
    if failed = 0 { writeln("vulkan ok") }
    return failed
end
